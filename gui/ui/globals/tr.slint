// Translations global — all user-facing strings

export global Tr {
    in-out property <string> lang: "en"; // "en" or "ru"

    out property <string> home:         lang == "ru" ? "Главная" : "Home";
    out property <string> nav-device:   lang == "ru" ? "Устройство" : "Device & Drivers";
    out property <string> nav-download: lang == "ru" ? "Загрузка" : "Download";
    out property <string> nav-flash:    lang == "ru" ? "Прошить всё" : "Flash All";
    out property <string> nav-part:     lang == "ru" ? "Прошить раздел" : "Flash Partition";
    out property <string> nav-about:    lang == "ru" ? "О программе" : "About";

    out property <string> no-device:    lang == "ru" ? "Устройство не найдено" : "No device connected";
    out property <string> find-device:  lang == "ru" ? "Найти устройство" : "Find device";
    out property <string> check-deps:   lang == "ru" ? "Проверить" : "Check deps";
    out property <string> install-deps: lang == "ru" ? "Установить" : "Install deps";
    out property <string> driver-test:  lang == "ru" ? "Тест драйвера" : "Driver Test";
    out property <string> run-test:     lang == "ru" ? "Запустить" : "Run test";

    out property <string> ota-url:      lang == "ru" ? "URL прошивки" : "OTA URL";
    out property <string> paste:        lang == "ru" ? "Вставить" : "Paste";
    out property <string> dl-btn:       lang == "ru" ? "Скачать" : "Download";
    out property <string> local-lbl:    lang == "ru" ? "Распаковать прошивку:" : "Extract firmware:";
    out property <string> select-zip:   lang == "ru" ? "Выбрать ZIP" : "Select ZIP";
    out property <string> extract:      lang == "ru" ? "Распаковать" : "Extract";

    out property <string> select-folder:lang == "ru" ? "Выбрать папку" : "Select folder";
    out property <string> flash-from-folder:lang == "ru" ? "Из папки" : "From folder";
    out property <string> flash-from-src:lang == "ru" ? "Из исходников" : "From build output";
    out property <string> src-select:    lang == "ru" ? "Выбрать папку" : "Select folder";
    out property <string> src-images:    lang == "ru" ? "образов" : "images";
    out property <string> src-ops:       lang == "ru" ? "операций" : "ops";
    out property <string> find-phone:   lang == "ru" ? "Найти телефон" : "Find phone";
    out property <string> flash-all-btn:lang == "ru" ? "Прошить всё" : "Flash all";
    out property <string> flashing:     lang == "ru" ? "Прошивается…" : "Flashing…";
    out property <string> cancel:       lang == "ru" ? "Отмена" : "Cancel";

    out property <string> part-lbl:     lang == "ru" ? "Раздел: " : "Partition: ";
    out property <string> flash-part-btn:lang == "ru" ? "Прошить раздел" : "Flash partition";

    out property <string> confirm-title:lang == "ru" ? "Подтверждение" : "Confirm";
    out property <string> confirm-flash:lang == "ru" ? "Начать прошивку?\nВсе разделы будут перезаписаны." : "Start flashing?\nAll partitions will be overwritten.";
    out property <string> flash-btn:    lang == "ru" ? "Прошить" : "Flash";
    out property <string> slot-lbl:     lang == "ru" ? "Слот " : "Slot ";
    out property <string> slot-switch-title: lang == "ru" ? "Переключить слот" : "Switch Slot";
    out property <string> slot-switch-warn:  lang == "ru" ? "Переключение слота может привести к невозможности загрузки устройства. Убедитесь, что целевой слот содержит рабочую прошивку.\n\nРаботает только в режиме fastboot (bootloader)." : "Switching slots may brick your device. Ensure the target slot has a working firmware.\n\nWorks only in fastboot (bootloader) mode.";
    out property <string> slot-switch-btn:   lang == "ru" ? "Переключить на слот " : "Switch to slot ";
    out property <string> author-lbl:   lang == "ru" ? "Автор: mrFrok" : "Author: mrFrok";
    out property <string> license-lbl:  lang == "ru" ? "Лицензия: GPL-3.0" : "License: GPL-3.0";

    // Reboot menu
    out property <string> reboot-title:    lang == "ru" ? "Перезагрузка" : "Reboot";
    out property <string> reboot-recovery: lang == "ru" ? "Recovery" : "Recovery";
    out property <string> reboot-bootloader: lang == "ru" ? "Bootloader" : "Bootloader";
    out property <string> reboot-fastbootd: lang == "ru" ? "Fastbootd" : "Fastbootd";
    out property <string> reboot-system:   lang == "ru" ? "Перезагрузить" : "Reboot";

    // Flash All step 0 — mandatory flash-method choice
    out property <string> flash-method-title: lang == "ru" ? "Выберите метод прошивки" : "Select flash method";
    out property <string> flash-method-body: lang == "ru"
        ? "Автоматическое определение платформы отключено. Укажите чипсет вашего устройства — от этого зависит порядок прошивки разделов. Прошивка не начнётся без выбора."
        : "Platform auto-detection is disabled. Choose your device's chipset — it determines how partitions are flashed. Flashing will not start without a choice.";
    out property <string> flash-method-snapdragon: lang == "ru" ? "Snapdragon (Qualcomm)" : "Snapdragon (Qualcomm)";
    out property <string> flash-method-snapdragon-desc: lang == "ru"
        ? "modem прошивается в bootloader, остальное в fastbootd; проверка ARB"
        : "modem flashed in bootloader mode, the rest in fastbootd; ARB check";
    out property <string> flash-method-mtk: lang == "ru" ? "MediaTek" : "MediaTek";
    out property <string> flash-method-mtk-desc: lang == "ru"
        ? "все разделы прошиваются в fastbootd; xbl/abl пропускаются"
        : "all partitions flashed in fastbootd; xbl/abl skipped";
    out property <string> flash-method-hint: lang == "ru"
        ? "⚠ Неверный метод может привести к неудачной прошивке или кирпичу. Уточните чипсет в характеристиках устройства."
        : "⚠ A wrong method can fail the flash or brick the device. Check your device's specifications for the chipset.";
    out property <string> back-btn: lang == "ru" ? "← Назад" : "← Back";

    // Flash All step 1 — reboot source dialog
    out property <string> flash-reboot-title: lang == "ru" ? "Откуда перезагрузиться в Fastbootd?" : "How to reboot into Fastbootd?";
    out property <string> flash-reboot-from-system:     lang == "ru" ? "Из системы\n(adb reboot fastboot)" : "From system\n(adb reboot fastboot)";
    out property <string> flash-reboot-from-bootloader: lang == "ru" ? "Из Bootloader\n(fastboot reboot fastboot)" : "From bootloader\n(fastboot reboot fastboot)";
    out property <string> flash-reboot-skip:            lang == "ru" ? "Уже в Fastbootd\n(не перезагружаться)" : "Already in Fastbootd\n(don't reboot)";

    // Flash All step 2 — final confirm
    out property <string> flash-final-title: lang == "ru" ? "Последнее предупреждение" : "Final warning";
    out property <string> flash-final-body:  lang == "ru" ? "Устройство находится в Fastbootd. Все разделы будут перезаписаны. Это действие необратимо.\n\nПродолжить прошивку?" : "Device is in Fastbootd. All partitions will be overwritten. This action is irreversible.\n\nProceed with flashing?";
    out property <string> src-final-title:  lang == "ru" ? "Прошивка из исходников" : "Flash from source";
    out property <string> src-final-body:   lang == "ru" ? "Устройство находится в Fastbootd. Образы из папки исходников будут прошиты. Это действие необратимо.\n\nПродолжить прошивку?" : "Device is in Fastbootd. Images from the source build folder will be flashed. This action is irreversible.\n\nProceed with flashing?";

    // Flash Partition step 1 — reboot to bootloader
    out property <string> part-reboot-title:        lang == "ru" ? "Откуда перезагрузиться в Bootloader?" : "How to reboot into Bootloader?";
    out property <string> part-reboot-from-system:  lang == "ru" ? "Из системы\n(adb reboot bootloader)" : "From system\n(adb reboot bootloader)";
    out property <string> part-reboot-from-fastboot:lang == "ru" ? "Из Fastboot\n(fastboot reboot-bootloader)" : "From Fastboot\n(fastboot reboot-bootloader)";
    out property <string> part-reboot-skip:         lang == "ru" ? "Уже в Bootloader\n(не перезагружаться)" : "Already in Bootloader\n(don't reboot)";
    out property <string> part-final-title: lang == "ru" ? "Прошить раздел" : "Flash partition";
    out property <string> part-final-body:  lang == "ru" ? "Раздел будет перезаписан. Продолжить?" : "The partition will be overwritten. Continue?";

    // Home page
    out property <string> home-title:   lang == "ru" ? "Добро пожаловать" : "Welcome";
    out property <string> home-sub:     lang == "ru" ? "Прошивальщик Android-устройств через fastboot" : "Android firmware flasher via fastboot";

    out property <string> home-features-title: lang == "ru" ? "Возможности:" : "Features:";
    out property <string> home-feat1: lang == "ru" ? "Автоматическая установка драйверов" : "Automatic installation of drivers";
    out property <string> home-feat2: lang == "ru" ? "Прошивка разделов boot, init_boot и recovery" : "Flashing of boot, init_boot and recovery images";
    out property <string> home-feat3: lang == "ru" ? "Распаковка OTA.zip и payload.bin для прошивки" : "Unpacking OTA.zip or payload.bin for subsequent flashing";
    out property <string> home-feat4: lang == "ru" ? "Прошивка пересоздаёт разделы — чистая система без остатков" : "Flashing recreates partitions, resulting in a clean system";
    out property <string> home-feat5: lang == "ru" ? "Меню перезагрузки: ADB / BOOTLOADER / FASTBOOTD" : "Reboot menu for quick switching: ADB / BOOTLOADER / FASTBOOTD";

    out property <string> home-warning: lang == "ru"
        ? "Внимание! Я не несу ответственности за ваши действия. Всё делается на ваш страх и риск."
        : "Attention! I do not take responsibility for your actions. Everything you do at your own risk.";

    out property <string> supported-devices: lang == "ru"
        ? "Данная программа предназначена для устройств Realme, OnePlus и OPPO на базе Qualcomm. Имеется частичная поддержка Mediatek."
        : "This tool is intended for Realme, OnePlus and OPPO devices based on Qualcomm. Partial Mediatek support is available.";

    out property <string> home-quicklinks: lang == "ru" ? "Быстрые ссылки:" : "Quick links:";
    out property <string> home-goto-device:   lang == "ru" ? "Устройство и драйверы" : "Device & Drivers";
    out property <string> home-goto-download: lang == "ru" ? "Скачать прошивку" : "Download Firmware";
    out property <string> home-goto-flash:    lang == "ru" ? "Прошить всё" : "Flash All";
    out property <string> home-goto-part:     lang == "ru" ? "Прошить раздел" : "Flash Partition";

    out property <string> flash-error-title: lang == "ru"
        ? "Ошибка прошивки"
        : "Flash Error";
    out property <string> retry: lang == "ru"
        ? "Повторить"
        : "Retry";
    out property <string> skip: lang == "ru"
        ? "Пропустить"
        : "Skip";
    out property <string> dismiss: lang == "ru"
        ? "Закрыть"
        : "Dismiss";
    out property <string> reboot: lang == "ru"
        ? "Перезагрузить устройство"
        : "Reboot device";
    out property <string> flash-error-hint: lang == "ru"
        ? "Проверьте подключение и попробуйте снова."
        : "Check the connection and try again.";

    out property <string> output-dir: lang == "ru"
        ? "Папка для сохранения:"
        : "Save to folder:";
    out property <string> browse: lang == "ru"
        ? "Обзор"
        : "Browse";
    out property <string> export-log: lang == "ru"
        ? "Экспорт"
        : "Export";
    out property <string> log-exported: lang == "ru"
        ? "Лог экспортирован: "
        : "Log exported: ";
    out property <string> log-title: lang == "ru"
        ? "Лог"
        : "Log";
    out property <string> log-empty: lang == "ru"
        ? "—"
        : "—";

    // Dialog titles
    out property <string> arb-warning-title: lang == "ru"
        ? "Предупреждение ARB"
        : "ARB Warning";
    out property <string> preloader-warning-title: lang == "ru"
        ? "Предупреждение preloader"
        : "Preloader Warning";
    out property <string> cable-test-title: lang == "ru"
        ? "Тест кабеля"
        : "Cable Test";
    out property <string> flash-complete: lang == "ru"
        ? "Прошивка завершена"
        : "Flash complete";
    out property <string> next-action: lang == "ru"
        ? "Что сделать с устройством?"
        : "What would you like to do next?";
    out property <string> continue-next: lang == "ru"
        ? "Продолжить →"
        : "Continue →";
    out property <string> reboot-and-flash: lang == "ru"
        ? "Перезагрузить и прошить →"
        : "Reboot & flash →";
    out property <string> abort: lang == "ru"
        ? "Прервать"
        : "Abort";
    out property <string> skip-next: lang == "ru"
        ? "Пропустить →"
        : "Skip →";
    out property <string> wipe-data-reboot: lang == "ru"
        ? "Сброс данных + перезагрузка"
        : "Wipe data + reboot";
    out property <string> arb-skip-xbl-hint: lang == "ru"
        ? "⚠ Пропуск xbl/abl может сохранить ARB=0, но может привести к кирпичу!"
        : "⚠ Skipping xbl/abl may preserve ARB=0, but may also brick your device!";
    out property <string> preloader-skip-hint: lang == "ru"
        ? "⚠ Пропуск preloader может помочь установить новую прошивку, если стандартный метод не срабатывает, но также может сделать устройство неработоспособным"
        : "⚠ Skipping preloader may help flash new firmware when the standard method fails, but may also render the device unbootable";
}
