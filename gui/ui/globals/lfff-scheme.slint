            surfaceContainerHighest: #E2E2E9,
        },
        dark: {
            primary: #ADC6FF,
            surfaceTint: #ADC6FF,
            onPrimary: #112F60,
            primaryContainer: #2B4678,
            onPrimaryContainer: #D8E2FF,
            secondary: #BFC6DC,
            onSecondary: #293041,
            secondaryContainer: #3F4759,
            onSecondaryContainer: #DBE2F9,
            tertiary: #DEBCDF,
            onTertiary: #402843,
