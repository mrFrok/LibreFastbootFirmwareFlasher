// LFFF's own colours, expressed as a Material 3 scheme.
//
// The @material palette drives every component from `MaterialPalette.schemes`,
// an `in` property, so the library's plumbing can be adopted without adopting
// its default indigo. 36 of the 49 roles below are the values LFFF already
// used; the rest are the library defaults, and none of those are referenced by
// our markup (`shadow` and the twelve `*Fixed` roles).
//
// Applied in main.slint's `init`, since a global cannot bind another global's
// `in` property declaratively.

import { MaterialSchemes } from "@material";

export global LfffScheme {
    out property <MaterialSchemes> schemes: {
        light: {
            primary: #0066CC,
            surfaceTint: #0066CC,  // = primary
            onPrimary: #ffffff,
            primaryContainer: #D6E8FF,
            onPrimaryContainer: #002D5C,
            secondary: #5B7DB1,
            onSecondary: #ffffff,
            secondaryContainer: #DAE6FA,
            onSecondaryContainer: #152F52,
            tertiary: #E67300,
            onTertiary: #ffffff,
            tertiaryContainer: #FFE8CC,
            onTertiaryContainer: #4D2600,
            error: #BA1A1A,
            onError: #FFFFFF,
            errorContainer: #FFDAD6,
            onErrorContainer: #410002,
            background: #FDFBFF,  // = surface
            onBackground: #1C1B1F,  // = onSurface
            surface: #FDFBFF,
            onSurface: #1C1B1F,
            surfaceVariant: #E8E0EB,
            onSurfaceVariant: #49454F,
            outline: #79747E,
            outlineVariant: #CAC4D0,
            shadow: #000000,  // library default
            scrim: #00000052,
            inverseSurface: #313033,
            inverseOnSurface: #F4EFF4,
            inversePrimary: #66B2FF,
            primaryFixed: #D8E2FF,  // library default
            onPrimaryFixed: #001A42,  // library default
            primaryFixedDim: #ADC6FF,  // library default
            onPrimaryFixedVariant: #2B4678,  // library default
            secondaryFixed: #DBE2F9,  // library default
            onSecondaryFixed: #141B2C,  // library default
            secondaryFixedDim: #BFC6DC,  // library default
            onSecondaryFixedVariant: #3F4759,  // library default
            tertiaryFixed: #FCD7FB,  // library default
            onTertiaryFixed: #29132D,  // library default
            tertiaryFixedDim: #DEBCDF,  // library default
            onTertiaryFixedVariant: #583E5B,  // library default
            surfaceDim: #F5F2F8,
            surfaceBright: #FFFFFF,
            surfaceContainerLowest: #FFFFFF,
            surfaceContainerLow: #F7F2FA,
            surfaceContainer: #F3EDF7,
            surfaceContainerHigh: #ECE6F0,
            surfaceContainerHighest: #E6E0E9,
        },
        dark: {
            primary: #66B2FF,
            surfaceTint: #66B2FF,  // = primary
            onPrimary: #002D5C,
            primaryContainer: #004A8C,
            onPrimaryContainer: #D6E8FF,
            secondary: #9DBCF3,
            onSecondary: #152F52,
            secondaryContainer: #28436E,
            onSecondaryContainer: #DAE6FA,
            tertiary: #FFB366,
            onTertiary: #4D2600,
            tertiaryContainer: #6B3600,
            onTertiaryContainer: #FFE8CC,
            error: #FFB4AB,
            onError: #690005,
            errorContainer: #93000A,
            onErrorContainer: #FFDAD6,
            background: #141416,  // = surface
            onBackground: #E6E1E6,  // = onSurface
            surface: #141416,
            onSurface: #E6E1E6,
            surfaceVariant: #2A2A2C,
            onSurfaceVariant: #C6C4C8,
            outline: #8E8E93,
            outlineVariant: #444649,
            shadow: #000000,  // library default
            scrim: #00000000,
            inverseSurface: #E6E1E6,
            inverseOnSurface: #1C1B1F,
            inversePrimary: #0066CC,
            primaryFixed: #D8E2FF,  // library default
            onPrimaryFixed: #001A42,  // library default
            primaryFixedDim: #ADC6FF,  // library default
            onPrimaryFixedVariant: #2B4678,  // library default
            secondaryFixed: #DBE2F9,  // library default
            onSecondaryFixed: #141B2C,  // library default
            secondaryFixedDim: #BFC6DC,  // library default
            onSecondaryFixedVariant: #3F4759,  // library default
            tertiaryFixed: #FCD7FB,  // library default
            onTertiaryFixed: #29132D,  // library default
            tertiaryFixedDim: #DEBCDF,  // library default
            onTertiaryFixedVariant: #583E5B,  // library default
            surfaceDim: #101012,
            surfaceBright: #1C1C1E,
            surfaceContainerLowest: #0E0E10,
            surfaceContainerLow: #141416,
            surfaceContainer: #1C1C1E,
            surfaceContainerHigh: #28282A,
            surfaceContainerHighest: #323234,
        },
    };
}
