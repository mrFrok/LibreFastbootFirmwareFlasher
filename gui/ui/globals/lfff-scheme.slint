            surfaceVariant: #2A2A2C,
            onSurfaceVariant: #C6C4C8,
            outline: #8E8E93,
            outlineVariant: #444649,
            shadow: #000000,
            scrim: #00000000,
            inverseSurface: #E6E1E6,
            inverseOnSurface: #1C1B1F,
