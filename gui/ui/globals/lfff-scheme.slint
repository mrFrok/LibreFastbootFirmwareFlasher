    // LFFF's colours with the surface family alpha-blended, for compositors
    // that blur behind translucent windows.
    property <MaterialSchemes> glass-scheme: {
        light: {
            primary: #0066CC,
            surfaceTint: #0066CC,
            onPrimary: #ffffff,
            primaryContainer: #D6E8FF,
            onPrimaryContainer: #002D5C,
            secondary: #5B7DB1,
