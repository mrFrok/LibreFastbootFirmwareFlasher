// Colour schemes, switchable while the app runs.
//
// @material drives every component from `MaterialPalette.schemes`, and that is
// an `in` property, so a scheme is just a value to hand it. This is the only
// way to change the look at runtime: a Slint *style* is fixed at compile time.
//
// Generated alongside the migration; see the commit that introduced it for how
// the role values were derived.

import { MaterialSchemes } from "@material";

export enum AppScheme { blue, indigo, glass }

export global LfffScheme {
    in property <AppScheme> current: AppScheme.blue;

    // The window background carries alpha in `glass`, which is what makes the
    // window itself translucent. Blur behind it is the compositor's job — Slint
    // has no API for it.
    out property <bool> translucent: root.current == AppScheme.glass;

    out property <MaterialSchemes> schemes:
          root.current == AppScheme.indigo ? root.indigo-scheme
        : root.current == AppScheme.glass  ? root.glass-scheme
        : root.blue-scheme;

    // LFFF's own colours.
    property <MaterialSchemes> blue-scheme: {
        light: {
            primary: #0066CC,
            surfaceTint: #0066CC,
            onPrimary: #ffffff,
            primaryContainer: #D6E8FF,
            onPrimaryContainer: #002D5C,
            secondary: #5B7DB1,
            onSecondary: #ffffff,
            secondaryContainer: #DAE6FA,
            onSecondaryContainer: #152F52,
            tertiary: #E67300,
            onTertiary: #ffffff,
            tertiaryContainer: #FFE8CC,
            onTertiaryContainer: #4D2600,
            error: #BA1A1A,
            onError: #FFFFFF,
            errorContainer: #FFDAD6,
            onErrorContainer: #410002,
            background: #FDFBFF,
            onBackground: #1C1B1F,
            surface: #FDFBFF,
            onSurface: #1C1B1F,
            surfaceVariant: #E8E0EB,
            onSurfaceVariant: #49454F,
            outline: #79747E,
            outlineVariant: #CAC4D0,
            shadow: #000000,
            scrim: #00000052,
            inverseSurface: #313033,
            inverseOnSurface: #F4EFF4,
            inversePrimary: #66B2FF,
            primaryFixed: #D8E2FF,
            onPrimaryFixed: #001A42,
            primaryFixedDim: #ADC6FF,
            onPrimaryFixedVariant: #2B4678,
            secondaryFixed: #DBE2F9,
            onSecondaryFixed: #141B2C,
            secondaryFixedDim: #BFC6DC,
            onSecondaryFixedVariant: #3F4759,
            tertiaryFixed: #FCD7FB,
            onTertiaryFixed: #29132D,
            tertiaryFixedDim: #DEBCDF,
            onTertiaryFixedVariant: #583E5B,
            surfaceDim: #F5F2F8,
            surfaceBright: #FFFFFF,
            surfaceContainerLowest: #FFFFFF,
            surfaceContainerLow: #F7F2FA,
            surfaceContainer: #F3EDF7,
            surfaceContainerHigh: #ECE6F0,
            surfaceContainerHighest: #E6E0E9,
