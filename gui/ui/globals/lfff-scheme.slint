// Colour schemes, switchable while the app runs.
//
// @material drives every component from `MaterialPalette.schemes`, and that is
// an `in` property, so a scheme is just a value to hand it. This is the only
// way to change the look at runtime: a Slint *style* is fixed at compile time.
//
// `blue` is LFFF's own palette and `indigo` is @material's default. The rest are
// `blue` with every role's hue rotated in OkLCh, which keeps M3's tonal
// relationships — lightness and chroma per role are untouched, so containers
// stay containers. Near-neutral roles (chroma < 0.004) and the error family are
// left alone: M3 keeps error red whatever the seed colour is.

import { MaterialSchemes } from "@material";

export enum AppScheme { blue, indigo, teal, green, amber, rose, violet }

export global LfffScheme {
    in property <AppScheme> current: AppScheme.blue;
    // Translucency is a modifier rather than a scheme of its own, so it applies
    // to whichever colour is selected. The window background is a palette role,
    // so giving it alpha is what makes the window see-through; the blur behind
    // it is the compositor's job, Slint has no API for it.
    in property <bool> translucent: false;

    out property <MaterialSchemes> schemes:
        root.translucent ? root.glassify(root.opaque) : root.opaque;

    property <MaterialSchemes> opaque:
          root.current == AppScheme.blue ? root.blue-scheme
        : root.current == AppScheme.indigo ? root.indigo-scheme
        : root.current == AppScheme.teal ? root.teal-scheme
        : root.current == AppScheme.green ? root.green-scheme
        : root.current == AppScheme.amber ? root.amber-scheme
        : root.current == AppScheme.rose ? root.rose-scheme
        : root.current == AppScheme.violet ? root.violet-scheme
        : root.blue-scheme;

    pure function glassify(s: MaterialSchemes) -> MaterialSchemes {
        return {
            light: {
                primary: s.light.primary,
                surfaceTint: s.light.surfaceTint,
                onPrimary: s.light.onPrimary,
                primaryContainer: s.light.primaryContainer,
                onPrimaryContainer: s.light.onPrimaryContainer,
                secondary: s.light.secondary,
                onSecondary: s.light.onSecondary,
                secondaryContainer: s.light.secondaryContainer,
                onSecondaryContainer: s.light.onSecondaryContainer,
                tertiary: s.light.tertiary,
                onTertiary: s.light.onTertiary,
                tertiaryContainer: s.light.tertiaryContainer,
                onTertiaryContainer: s.light.onTertiaryContainer,
                error: s.light.error,
                onError: s.light.onError,
                errorContainer: s.light.errorContainer,
                onErrorContainer: s.light.onErrorContainer,
                background: s.light.background.with-alpha(0.65),
                onBackground: s.light.onBackground,
                surface: s.light.surface.with-alpha(0.65),
                onSurface: s.light.onSurface,
                surfaceVariant: s.light.surfaceVariant,
                onSurfaceVariant: s.light.onSurfaceVariant,
                outline: s.light.outline,
                outlineVariant: s.light.outlineVariant,
                shadow: s.light.shadow,
                scrim: s.light.scrim,
                inverseSurface: s.light.inverseSurface,
                inverseOnSurface: s.light.inverseOnSurface,
                inversePrimary: s.light.inversePrimary,
                primaryFixed: s.light.primaryFixed,
                onPrimaryFixed: s.light.onPrimaryFixed,
                primaryFixedDim: s.light.primaryFixedDim,
                onPrimaryFixedVariant: s.light.onPrimaryFixedVariant,
                secondaryFixed: s.light.secondaryFixed,
                onSecondaryFixed: s.light.onSecondaryFixed,
                secondaryFixedDim: s.light.secondaryFixedDim,
                onSecondaryFixedVariant: s.light.onSecondaryFixedVariant,
                tertiaryFixed: s.light.tertiaryFixed,
                onTertiaryFixed: s.light.onTertiaryFixed,
                tertiaryFixedDim: s.light.tertiaryFixedDim,
                onTertiaryFixedVariant: s.light.onTertiaryFixedVariant,
                surfaceDim: s.light.surfaceDim.with-alpha(0.65),
                surfaceBright: s.light.surfaceBright.with-alpha(0.72),
                surfaceContainerLowest: s.light.surfaceContainerLowest.with-alpha(0.77),
                surfaceContainerLow: s.light.surfaceContainerLow.with-alpha(0.77),
                surfaceContainer: s.light.surfaceContainer.with-alpha(0.77),
                surfaceContainerHigh: s.light.surfaceContainerHigh.with-alpha(0.77),
                surfaceContainerHighest: s.light.surfaceContainerHighest.with-alpha(0.77),
            },
            dark: {
                primary: s.dark.primary,
                surfaceTint: s.dark.surfaceTint,
                onPrimary: s.dark.onPrimary,
                primaryContainer: s.dark.primaryContainer,
                onPrimaryContainer: s.dark.onPrimaryContainer,
                secondary: s.dark.secondary,
                onSecondary: s.dark.onSecondary,
                secondaryContainer: s.dark.secondaryContainer,
                onSecondaryContainer: s.dark.onSecondaryContainer,
                tertiary: s.dark.tertiary,
                onTertiary: s.dark.onTertiary,
                tertiaryContainer: s.dark.tertiaryContainer,
                onTertiaryContainer: s.dark.onTertiaryContainer,
                error: s.dark.error,
                onError: s.dark.onError,
                errorContainer: s.dark.errorContainer,
                onErrorContainer: s.dark.onErrorContainer,
                background: s.dark.background.with-alpha(0.65),
                onBackground: s.dark.onBackground,
                surface: s.dark.surface.with-alpha(0.65),
                onSurface: s.dark.onSurface,
                surfaceVariant: s.dark.surfaceVariant,
                onSurfaceVariant: s.dark.onSurfaceVariant,
                outline: s.dark.outline,
                outlineVariant: s.dark.outlineVariant,
                shadow: s.dark.shadow,
                scrim: s.dark.scrim,
                inverseSurface: s.dark.inverseSurface,
                inverseOnSurface: s.dark.inverseOnSurface,
                inversePrimary: s.dark.inversePrimary,
                primaryFixed: s.dark.primaryFixed,
                onPrimaryFixed: s.dark.onPrimaryFixed,
                primaryFixedDim: s.dark.primaryFixedDim,
                onPrimaryFixedVariant: s.dark.onPrimaryFixedVariant,
                secondaryFixed: s.dark.secondaryFixed,
                onSecondaryFixed: s.dark.onSecondaryFixed,
                secondaryFixedDim: s.dark.secondaryFixedDim,
                onSecondaryFixedVariant: s.dark.onSecondaryFixedVariant,
                tertiaryFixed: s.dark.tertiaryFixed,
                onTertiaryFixed: s.dark.onTertiaryFixed,
                tertiaryFixedDim: s.dark.tertiaryFixedDim,
                onTertiaryFixedVariant: s.dark.onTertiaryFixedVariant,
                surfaceDim: s.dark.surfaceDim.with-alpha(0.65),
                surfaceBright: s.dark.surfaceBright.with-alpha(0.72),
                surfaceContainerLowest: s.dark.surfaceContainerLowest.with-alpha(0.77),
                surfaceContainerLow: s.dark.surfaceContainerLow.with-alpha(0.77),
                surfaceContainer: s.dark.surfaceContainer.with-alpha(0.77),
                surfaceContainerHigh: s.dark.surfaceContainerHigh.with-alpha(0.77),
                surfaceContainerHighest: s.dark.surfaceContainerHighest.with-alpha(0.77),
            },
        };
    }

