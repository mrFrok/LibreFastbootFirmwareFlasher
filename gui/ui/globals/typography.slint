// Material 3 Expressive typography scale
// 30 styles: 15 baseline + 15 emphasized roles
// All sizes in px for Slint

export global Typography {
    // ── Display (57/45/36 px) ────────────────────────────────────────────
    out property <length> display-large-size:     57px;
    out property <int>    display-large-weight:   400;
    out property <length> display-large-tracking:  -0.25px;
    out property <int>    display-large-weight-em: 700;

    out property <length> display-medium-size:    45px;
    out property <int>    display-medium-weight:  400;
    out property <length> display-medium-tracking: 0px;
    out property <int>    display-medium-weight-em: 700;

    out property <length> display-small-size:     36px;
    out property <int>    display-small-weight:   400;
    out property <length> display-small-tracking: 0px;
    out property <int>    display-small-weight-em: 700;

    // ── Headline (32/28/24 px) ───────────────────────────────────────────
    out property <length> headline-large-size:    32px;
    out property <int>    headline-large-weight:  400;
    out property <length> headline-large-tracking: 0px;
    out property <int>    headline-large-weight-em: 700;

    out property <length> headline-medium-size:   28px;
    out property <int>    headline-medium-weight: 400;
    out property <length> headline-medium-tracking: 0px;
    out property <int>    headline-medium-weight-em: 700;

    out property <length> headline-small-size:    24px;
    out property <int>    headline-small-weight:  400;
    out property <length> headline-small-tracking: 0px;
    out property <int>    headline-small-weight-em: 700;

    // ── Title (22/16/14 px) ──────────────────────────────────────────────
    out property <length> title-large-size:       22px;
    out property <int>    title-large-weight:     500;
    out property <length> title-large-tracking:   0px;
    out property <int>    title-large-weight-em:  700;

    out property <length> title-medium-size:      16px;
    out property <int>    title-medium-weight:    500;
    out property <length> title-medium-tracking:  0.15px;
    out property <int>    title-medium-weight-em: 700;

    out property <length> title-small-size:       14px;
    out property <int>    title-small-weight:     500;
    out property <length> title-small-tracking:   0.1px;
    out property <int>    title-small-weight-em:  700;

    // ── Body (16/14/12 px) ───────────────────────────────────────────────
    out property <length> body-large-size:        16px;
    out property <int>    body-large-weight:      400;
    out property <length> body-large-tracking:    0.5px;
    out property <int>    body-large-weight-em:   700;

    out property <length> body-medium-size:       14px;
    out property <int>    body-medium-weight:     400;
    out property <length> body-medium-tracking:   0.25px;
    out property <int>    body-medium-weight-em:  700;

    out property <length> body-small-size:          12px;
    out property <int>    body-small-weight:        400;
    out property <length> body-small-tracking:      0.4px;
    out property <int>    body-small-weight-em:     700;

    // ── Label (14/12/11 px) ──────────────────────────────────────────────
    out property <length> label-large-size:       14px;
    out property <int>    label-large-weight:     500;
    out property <length> label-large-tracking:   0.1px;
    out property <int>    label-large-weight-em:  700;

    out property <length> label-medium-size:      12px;
    out property <int>    label-medium-weight:    500;
    out property <length> label-medium-tracking:  0.5px;
    out property <int>    label-medium-weight-em: 700;

    out property <length> label-small-size:       11px;
    out property <int>    label-small-weight:     500;
    out property <length> label-small-tracking:   0.5px;
    out property <int>    label-small-weight-em:  700;
}
