import { ScrollView } from "std-widgets.slint";
import { FilledButton, MaterialPalette, TextButton } from "@material";
import { Tr } from "../globals/tr.slint";
import { StatusColors } from "../globals/status-colors.slint";

export component UpdateDialog {
    // A dialog is a full-window overlay: without this the root sizes itself
    // to the card, and the scrim below covers only the card's own bounds
    // instead of dimming the app behind it.
    width: 100%;
    height: 100%;
    in property <bool> show;
    in property <string> lang: "en";
    in property <string> update-version: "";
    in property <string> update-body: "";

    callback cancel();
    callback download();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity {
            duration: 200ms;
            easing: ease-in-out;
        }
        width: 100%;
        height: 100%;
        background: StatusColors.scrim;
        TouchArea { }

        // Placed by hand, as confirm-sheet: centring through nested layouts
        // stretched the card across the window and squeezed the notes.
        Rectangle {
            width: min(620px, parent.width - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: card.preferred-height;
            background: MaterialPalette.surface-container-high;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline-variant;
            clip: true;

            card := VerticalLayout {
                spacing: 12px;
                padding: 20px;
                Text {
                    text: root.lang == "ru" ? "Доступно обновление"
                        : root.lang == "zh-CN" ? "有可用更新"
                        : root.lang == "zh-TW" ? "有可用更新"
                        : "Update Available";
                    font-size: 20px;
                    font-weight: 700;
                    color: MaterialPalette.on-surface;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.lang == "ru" ? "Версия " + root.update-version + " доступна для загрузки."
                        : root.lang == "zh-CN" ? "版本 " + root.update-version + " 可供下载。"
                        : root.lang == "zh-TW" ? "版本 " + root.update-version + " 可供下載。"
                        : "Version " + root.update-version + " is available for download.";
                    font-size: 14px;
                    color: MaterialPalette.on-surface-variant;
                    horizontal-alignment: center;
                }

                Rectangle {
                    visible: root.update-body != "";
                    height: self.visible ? min(320px, notes.preferred-height + 2px) : 0px;
                    background: MaterialPalette.surface-container;
                    border-radius: 8px;
                    clip: true;
                    ScrollView {
                        content-width: self.visible-width;
                        content-height: notes.preferred-height;
                        notes := VerticalLayout {
                            width: parent.width;
                            padding: 12px;
                            Text {
                                text: root.update-body;
                                font-size: 14px;
                                color: MaterialPalette.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    TextButton {
                        text: Tr.cancel;
                        clicked => { root.cancel(); }
                    }

                    FilledButton {
                        text: root.lang == "ru" ? "Скачать"
                            : root.lang == "zh-CN" ? "下载"
                            : root.lang == "zh-TW" ? "下載"
                            : "Download";
                        clicked => { root.download(); }
                    }
                }
            }
        }
    }
}
