import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { FilledButton, TextButton, OutlinedButton } from "../components/buttons.slint";
import { RebootOption } from "../structs.slint";

export component ConfirmDialog {
    in property <bool> show;
    in property <string> title;
    in property <string> body;
    in property <string> icon-text: "✓";
    in property <color> icon-color: MaterialPalette.success;
    in property <string> cancel-text: Tr.cancel;
    in property <string> primary-text;
    in property <bool> primary-enabled: true;
    callback cancelled();
    callback confirmed();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 350ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        z: 100; background: MaterialPalette.overlay-backdrop-heavy; width: 100%; height: 100%;

        Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - 240px) / 2;
            width: 420px; height: 240px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            drop-shadow-blur: 24px; drop-shadow-color: MaterialPalette.drop-shadow; drop-shadow-offset-y: 8px;
            animate opacity { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            animate y { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }

            VerticalLayout { padding: 28px; spacing: 12px;
                HorizontalLayout { spacing: 8px; alignment: start;
                    Text { text: root.icon-text; font-size: 22px; color: root.icon-color; vertical-alignment: center; }
                    Text {
                        text: root.title;
                        font-size: 18px; font-weight: 700; color: root.icon-color;
                    }
                }
                Text {
                    text: root.body;
                    font-size: 14px; color: MaterialPalette.on-surface-variant; wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { spacing: 8px; alignment: end;
                    TextButton { text: root.cancel-text; clicked => { root.cancelled(); } }
                    FilledButton {
                        text: root.primary-text;
                        enabled: root.primary-enabled;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }
}

export component WarningDialog {
    in property <bool> show;
    in property <string> title;
    in property <string> body;
    in property <string> warning-text;
    in property <bool> has-checkbox;
    in property <string> checkbox-text;
    in property <bool> checkbox-checked;
    in property <string> lang;
    callback cancelled();
    callback confirmed();
    callback checkbox-toggled();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 350ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        z: 110; background: MaterialPalette.overlay-backdrop-heavy; width: 100%; height: 100%;

        VerticalLayout { alignment: center;
        HorizontalLayout { alignment: center;
        Rectangle {
            width: 460px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            animate opacity { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            animate y { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            drop-shadow-blur: 24px; drop-shadow-color: MaterialPalette.drop-shadow-heavy; drop-shadow-offset-y: 8px;

            VerticalLayout { padding: 28px; spacing: 12px;
                HorizontalLayout { spacing: 12px;
                    Text { text: "⚠"; font-size: 24px; color: MaterialPalette.warning; vertical-alignment: center; }
                    Text {
                        text: root.title;
                        font-size: 18px; font-weight: 700;
                        color: MaterialPalette.warning; vertical-alignment: center;
                    }
                }
                Text {
                    text: root.body;
                    font-size: 13px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                if root.has-checkbox: VerticalLayout { spacing: 6px;
                    Text {
                        text: root.warning-text;
                        font-size: 12px; color: MaterialPalette.warning; wrap: word-wrap;
                    }
                    TouchArea {
                        height: 24px;
                        clicked => { root.checkbox-toggled(); }
                        HorizontalLayout { spacing: 10px;
                            Rectangle {
                                width: 18px; height: 18px; border-radius: 4px;
                                border-width: 2px;
                                border-color: root.checkbox-checked ? MaterialPalette.primary : MaterialPalette.outline;
                                background: root.checkbox-checked ? MaterialPalette.primary : transparent;
                                animate background { duration: 100ms; }
                                animate border-color { duration: 100ms; }
                                y: (parent.height - 18px) / 2;
                                Text {
                                    visible: root.checkbox-checked;
                                    opacity: root.checkbox-checked ? 1.0 : 0.0;
                                    text: "✓"; font-size: 14px; font-weight: 700;
                                    color: MaterialPalette.on-primary;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    animate opacity { duration: 100ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
                                }
                            }
                            Text {
                                text: root.checkbox-text;
                                font-size: 14px; color: MaterialPalette.on-surface; vertical-alignment: center;
                            }
                        }
                    }
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    TextButton { text: Tr.cancel; clicked => { root.cancelled(); } }
                    FilledButton {
                        text: root.lang == "ru" ? "Я понимаю, продолжить" : "I understand, continue";
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
        }
        }
    }
}

export component RebootChoiceDialog {
    in property <bool> show;
    in property <string> title;
    in-out property <int> choice;
    in property <[RebootOption]> options;
    in property <string> lang;
    callback cancelled();
    callback confirmed();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 350ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        z: 100; background: MaterialPalette.overlay-backdrop-heavy; width: 100%; height: 100%;

        Rectangle {
            x: (parent.width - 460px) / 2;
            y: (parent.height - 275px) / 2;
            width: 460px; height: 275px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            drop-shadow-blur: 24px; drop-shadow-color: MaterialPalette.drop-shadow; drop-shadow-offset-y: 8px;
            animate opacity { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            animate y { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }

            VerticalLayout { padding: 20px; spacing: 10px;
                Text {
                    text: root.title;
                    font-size: 15px; font-weight: 600;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                }
                VerticalLayout { spacing: 6px;
                    for item in root.options: TouchArea {
                        height: 48px;
                        clicked => { root.choice = item.val; }
                        Rectangle {
                            border-radius: 12px;
                            border-width: 2px;
                            border-color: root.choice == item.val
                                ? MaterialPalette.primary
                                : MaterialPalette.outline-variant;
                            background: root.choice == item.val
                                ? MaterialPalette.secondary-container
                                : (parent.has-hover
                                    ? MaterialPalette.surface-container-highest
                                    : MaterialPalette.surface-container);
                            animate background { duration: 80ms; }
                            animate border-color { duration: 80ms; }
                            Text {
                                text: item.label;
                                font-size: 13px;
                                color: root.choice == item.val
                                    ? MaterialPalette.on-secondary-container
                                    : MaterialPalette.on-surface;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    TextButton { text: Tr.cancel; clicked => { root.cancelled(); } }
                    FilledButton {
                        text: root.lang == "ru" ? "Перезагрузить и прошить →" : "Reboot & flash →";
                        enabled: root.choice != 0;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }
}
