import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { FilledButton, OutlinedButton, TextButton } from "../components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

export component FlashFailureDialog {
    in property <bool> show;
    in property <string> lang: "en";
    in property <string> flash-fail-partition: "";
    in property <string> flash-fail-slot: "";
    in property <string> flash-fail-error: "";
    in property <bool> is-session-error: false;

    callback retry();
    callback abort();
    callback skip();
    callback close();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 200ms; easing: cubic-bezier(0.4, 0.0, 0.2, 1.0); }
        animate y { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        z: 100; background: MaterialPalette.scrim; width: 100%; height: 100%; TouchArea { }

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: (parent.height - 320px) / 2;
            width: 480px; height: root.is-session-error ? 320px : 280px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            border-width: 1px; border-color: MaterialPalette.outline-variant; clip: true;

            VerticalLayout { padding: 24px; spacing: 14px;
                HorizontalLayout { spacing: 10px;
                    Text { text: "⚠"; font-size: 22px; color: MaterialPalette.warning; vertical-alignment: center; }
                    Text {
                        text: Tr.flash-error-title;
                        font-size: 17px; font-weight: 700;
                        color: MaterialPalette.error;
                        vertical-alignment: center;
                    }
                }

                if root.is-session-error: ScrollView { vertical-stretch: 1;
                    Text {
                        text: root.flash-fail-error;
                        font-size: 13px;
                        color: MaterialPalette.on-surface;
                        wrap: word-wrap;
                    }
                }

                if !root.is-session-error: Text {
                    text: root.lang == "ru"
                        ? "Раздел " + root.flash-fail-partition + "_" + root.flash-fail-slot + " не удалось прошить"
                        : "Failed to flash " + root.flash-fail-partition + "_" + root.flash-fail-slot;
                    font-size: 14px;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                }

                if !root.is-session-error: Text {
                    text: root.flash-fail-error;
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    min-height: 50px;
                    max-height: 80px;
                }

                if root.is-session-error: Text {
                    text: Tr.flash-error-hint;
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout { spacing: 8px; alignment: end;
                    if root.is-session-error: FilledButton {
                        text: Tr.dismiss;
                        clicked => { root.close(); }
                    }

                    if !root.is-session-error: TextButton {
                        text: Tr.abort;
                        clicked => { root.abort(); }
                    }
                    if !root.is-session-error: OutlinedButton {
                        text: Tr.retry;
                        clicked => { root.retry(); }
                    }
                    if !root.is-session-error: FilledButton {
                        text: Tr.skip-next;
                        clicked => { root.skip(); }
                    }
                }
            }
        }
    }
}