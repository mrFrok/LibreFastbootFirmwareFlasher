import { FilledButton, MaterialPalette, TextButton } from "@material";
import { Tr } from "../globals/tr.slint";
import { StatusColors } from "../globals/status-colors.slint";

// Mirrors lfff_lib::arb::ArbVerdict. An unknown ARB is its own state rather
// than a zero: zero means the counter will not rise, unknown means nothing.
export enum ArbState { known, not-found, unparsed }

export component ArbWarningDialog {
    // A dialog is a full-window overlay: without this the root sizes itself
    // to the card, and the scrim below covers only the card's own bounds
    // instead of dimming the app behind it.
    width: 100%;
    height: 100%;
    in property <bool> show;
    in property <string> lang: "en";
    in property <ArbState> arb-warning-state: ArbState.known;
    // Meaningful only when arb-warning-state is `known`.
    in property <int> arb-warning-version: 0;
    in-out property <bool> skip-xbl-abl: false;

    callback cancel();
    callback confirm();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity {
            duration: 350ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        z: 110;
        background: StatusColors.scrim;
        width: 100%;
        height: 100%;
        TouchArea { }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 460px;
                    border-radius: 16px;
                    background: MaterialPalette.surface-container-high;
                    animate opacity {
                        duration: 300ms;
                        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
                    }
                    animate y {
                        duration: 300ms;
                        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
                    }
                    border-width: 1px;
                    border-color: MaterialPalette.outline-variant;
                    clip: true;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "⚠";
                                font-size: 24px;
                                color: StatusColors.warning;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Tr.arb-warning-title;
                                font-size: 18px;
                                font-weight: 700;
                                color: StatusColors.warning;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: root.arb-warning-state == ArbState.not-found
                                ? (root.lang == "ru"
                                ? "В этой прошивке не найден xbl_config.img, поэтому её версия ARB неизвестна. Это не то же самое, что ARB=0.\n\nЕсли ARB прошивки выше, чем у устройства, счётчик anti-rollback будет необратимо повышен; если ниже — устройство не загрузится.\n\nПродолжайте, только если знаете ARB этой прошивки из другого источника."
                                : root.lang == "zh-CN"
                                ? "此固件中未找到 xbl_config.img，因此其 ARB 版本未知。这与 ARB=0 不同。\n\n如果固件的 ARB 高于设备，防回滚计数器将被不可逆地提升；如果更低，设备将无法启动。\n\n仅在通过其他途径得知此固件的 ARB 时才继续。"
                                : root.lang == "zh-TW"
                                ? "此韌體中未找到 xbl_config.img，因此其 ARB 版本未知。這與 ARB=0 不同。\n\n如果韌體的 ARB 高於裝置，防回滾計數器將被不可逆地提升；如果更低，裝置將無法啟動。\n\n僅在透過其他途徑得知此韌體的 ARB 時才繼續。"
                                : "No xbl_config.img was found in this firmware, so its ARB version is unknown. This is not the same as ARB=0.\n\nIf the firmware's ARB is higher than your device's, the anti-rollback counter will be permanently raised; if it is lower, the device will not boot.\n\nOnly continue if you know this firmware's ARB from another source.")
                                : root.arb-warning-state == ArbState.unparsed
                                ? (root.lang == "ru"
                                ? "xbl_config.img найден, но прочитать его не удалось, поэтому версия ARB прошивки неизвестна. Это не то же самое, что ARB=0.\n\nЕсли ARB прошивки выше, чем у устройства, счётчик anti-rollback будет необратимо повышен; если ниже — устройство не загрузится.\n\nПродолжайте, только если знаете ARB этой прошивки из другого источника."
                                : root.lang == "zh-CN"
                                ? "已找到 xbl_config.img，但无法读取，因此固件的 ARB 版本未知。这与 ARB=0 不同。\n\n如果固件的 ARB 高于设备，防回滚计数器将被不可逆地提升；如果更低，设备将无法启动。\n\n仅在通过其他途径得知此固件的 ARB 时才继续。"
                                : root.lang == "zh-TW"
                                ? "已找到 xbl_config.img，但無法讀取，因此韌體的 ARB 版本未知。這與 ARB=0 不同。\n\n如果韌體的 ARB 高於裝置，防回滾計數器將被不可逆地提升；如果更低，裝置將無法啟動。\n\n僅在透過其他途徑得知此韌體的 ARB 時才繼續。"
                                : "xbl_config.img was found but could not be read, so the firmware's ARB version is unknown. This is not the same as ARB=0.\n\nIf the firmware's ARB is higher than your device's, the anti-rollback counter will be permanently raised; if it is lower, the device will not boot.\n\nOnly continue if you know this firmware's ARB from another source.")
                                : root.arb-warning-version > 0
                                ? (root.lang == "ru"
                                ? "Прошивка содержит ARB=" + root.arb-warning-version + ".\n\nПосле прошивки счётчик anti-rollback на устройстве будет необратимо повышен. Вы НЕ сможете откатиться на прошивку с меньшим ARB — это приведёт к кирпичу.\n\nПродолжайте только если уверены, что не захотите сделать даунгрейд!"
                                : root.lang == "zh-CN"
                                ? "固件包含 ARB=" + root.arb-warning-version + "。\n\n刷写后，设备上的防回滚计数器将被不可逆地提升。您将无法降级到 ARB 更低的固件——这会导致设备变砖。\n\n仅在确定永不降级时才继续！"
                                : root.lang == "zh-TW"
                                ? "韌體包含 ARB=" + root.arb-warning-version + "。\n\n刷寫後，裝置上的防回滾計數器將被不可逆地提升。您將無法降級到 ARB 更低的韌體——這會導致裝置變磚。\n\n僅在確定永不降級時才繼續！"
                                : "Firmware has ARB=" + root.arb-warning-version + ".\n\nAfter flashing, the anti-rollback counter on your device will be permanently raised. You will NOT be able to downgrade to firmware with a lower ARB — this will brick your device.\n\nOnly continue if you are sure you will never need to downgrade!")
                                : (root.lang == "ru"
                                ? "Прошивка содержит ARB=0, однако определить ARB вашего устройства через fastboot невозможно.\n\nЕсли устройство уже имеет ARB > 0 (установлен предыдущей прошивкой), прошивка с ARB=0 не загрузится и превратит устройство в кирпич.\n\nПродолжайте только если уверены в безопасности операции."
                                : root.lang == "zh-CN"
                                ? "固件包含 ARB=0，但无法通过 fastboot 确定您设备的 ARB。\n\n如果设备已有 ARB > 0（由之前的固件设置），刷入 ARB=0 的固件将无法启动，并可能使设备变砖。\n\n仅在确定此操作安全时才继续。"
                                : root.lang == "zh-TW"
                                ? "韌體包含 ARB=0，但無法透過 fastboot 確定您裝置的 ARB。\n\n如果裝置已有 ARB > 0（由之前的韌體設定），刷入 ARB=0 的韌體將無法啟動，並可能使裝置變磚。\n\n僅在確定此操作安全時才繼續。"
                                : "Firmware has ARB=0, but your device's current ARB level cannot be determined via fastboot.\n\nIf your device already has ARB > 0 (set by a previous firmware), flashing ARB=0 firmware will fail to boot and may brick your device.\n\nOnly continue if you are certain this is safe.");
                            font-size: 13px;
                            color: MaterialPalette.on-surface-variant;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: Tr.arb-skip-xbl-hint;
                                font-size: 12px;
                                color: StatusColors.warning;
                                wrap: word-wrap;
                            }
                        }

                        TouchArea {
                            height: 24px;
                            clicked => { root.skip-xbl-abl = !root.skip-xbl-abl; }
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 4px;
                                    border-width: 2px;
                                    border-color: root.skip-xbl-abl ? MaterialPalette.primary : MaterialPalette.outline;
                                    background: root.skip-xbl-abl ? MaterialPalette.primary : transparent;
                                    animate background { duration: 100ms; }
                                    animate border-color { duration: 100ms; }
                                    y: (parent.height - 18px) / 2;
                                    Text {
                                        visible: root.skip-xbl-abl;
                                        opacity: root.skip-xbl-abl ? 1.0 : 0.0;
                                        text: "✓";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: MaterialPalette.on-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        animate opacity {
                                            duration: 100ms;
                                            easing: cubic-bezier(0.2, 0.0, 0, 1.0);
                                        }
                                    }
                                }

                                Text {
                                    text: root.lang == "ru" ? "Пропустить xbl/abl разделы"
                                        : root.lang == "zh-CN" ? "跳过 xbl/abl 分区"
                                        : root.lang == "zh-TW" ? "略過 xbl/abl 分區"
                                        : "Skip xbl/abl partitions";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            TextButton {
                                text: Tr.cancel;
                                clicked => { root.cancel(); }
                            }

                            FilledButton {
                                text: root.lang == "ru" ? "Я понимаю, продолжить"
                                    : root.lang == "zh-CN" ? "我已了解，继续"
                                    : root.lang == "zh-TW" ? "我已了解，繼續"
                                    : "I understand, continue";
                                clicked => { root.confirm(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
