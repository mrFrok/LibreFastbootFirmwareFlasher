import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { FilledButton, OutlinedButton, TextButton } from "../components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

export component FlashErrorDialog {
    in property <bool> show;
    in property <string> flash-error-message: "";

    callback retry();
    callback skip();
    callback reboot();
    callback cancel();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 350ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        z: 110; background: MaterialPalette.overlay-backdrop-heavy; width: 100%; height: 100%;

        VerticalLayout { alignment: center;
        HorizontalLayout { alignment: center;
        Rectangle {
            max-width: 640px;
            max-height: 500px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            animate opacity { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            animate y { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            drop-shadow-blur: 24px; drop-shadow-color: MaterialPalette.drop-shadow-heavy; drop-shadow-offset-y: 8px;

            VerticalLayout { padding: 28px; spacing: 12px;
                HorizontalLayout { spacing: 12px;
                    Text { text: "✕"; font-size: 24px; color: MaterialPalette.error; vertical-alignment: center; }
                    Text {
                        text: Tr.flash-error-title;
                        font-size: 18px; font-weight: 700;
                        color: MaterialPalette.error; vertical-alignment: center;
                    }
                }
                ScrollView { vertical-stretch: 1; max-height: 300px;
                    Text {
                        text: root.flash-error-message;
                        font-size: 13px;
                        color: MaterialPalette.on-surface-variant;
                        wrap: word-wrap;
                    }
                }
                Text {
                    text: Tr.flash-error-hint;
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    FilledButton {
                        min-width: 110px;
                        text: Tr.retry;
                        clicked => { root.retry(); }
                    }
                    OutlinedButton {
                        min-width: 100px;
                        text: Tr.skip;
                        clicked => { root.skip(); }
                    }
                    OutlinedButton {
                        min-width: 220px;
                        text: Tr.reboot;
                        clicked => { root.reboot(); }
                    }
                    TextButton {
                        min-width: 100px;
                        text: Tr.cancel;
                        clicked => { root.cancel(); }
                    }
                }
            }
        }
        }
        }
    }
}
