import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { FilledButton, OutlinedButton, TextButton } from "../components/buttons.slint";

export component PostFlashSuccessDialog {
    in property <bool> show;
    in property <string> lang: "en";

    callback dismiss();
    callback reboot();
    callback wipe-and-reboot();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 200ms; easing: cubic-bezier(0.4, 0.0, 0.2, 1.0); }
        z: 100; background: MaterialPalette.scrim; width: 100%; height: 100%; TouchArea { }

        Rectangle {
            x: (parent.width - 460px) / 2;
            y: (parent.height - 310px) / 2;
            width: 460px; height: 310px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            border-width: 1px; border-color: MaterialPalette.outline-variant; clip: true;

            VerticalLayout { padding: 24px; spacing: 12px;
                HorizontalLayout { spacing: 8px; alignment: start;
                    Image {
                        source: @image-url("../icons/check.svg");
                        width: 22px; height: 22px;
                        colorize: MaterialPalette.success;
                        y: (parent.height - 22px) / 2;
                    }
                    Text {
                        text: Tr.flash-complete;
                        font-size: 18px; font-weight: 700; color: MaterialPalette.success;
                    }
                }
                Text {
                    text: Tr.next-action;
                    font-size: 14px; color: MaterialPalette.on-surface-variant; wrap: word-wrap;
                    vertical-stretch: 1;
                }
                // Vertical stack: long Russian strings can't fit side-by-side
                FilledButton {
                    text: Tr.wipe-data-reboot;
                    clicked => { root.wipe-and-reboot(); }
                }
                OutlinedButton {
                    text: Tr.reboot;
                    clicked => { root.reboot(); }
                }
                TextButton {
                    text: Tr.dismiss;
                    clicked => { root.dismiss(); }
                }
            }
        }
    }
}
