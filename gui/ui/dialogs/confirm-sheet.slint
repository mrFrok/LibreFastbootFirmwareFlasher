import {
    CheckBox,
    CheckState,
    FilledButton,
    MaterialPalette,
    TextButton,
} from "@material";
import { StatusColors } from "../globals/status-colors.slint";
import { Tr } from "../globals/tr.slint";
import { FieldRow } from "../components/wizard.slint";

// A toggle for one partition to leave alone.
component SkipChip inherits TouchArea {
    in property <string> text;
    in-out property <bool> checked;
    height: 32px;
    width: label.preferred-width + 28px;
    clicked => {
        root.checked = !root.checked;
    }
    Rectangle {
        border-radius: 8px;
        background: root.checked ? MaterialPalette.secondary-container : transparent;
        border-width: root.checked ? 0px : 1px;
        border-color: MaterialPalette.outline;
        label := Text {
            text: (root.checked ? "✓ " : "") + root.text;
            font-size: 13px;
            font-weight: 500;
            color: root.checked ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
        }
    }
}

// The one sheet between "Install" and the hands-off run. Its warning step
// always comes before the summary: the order ARB, then final confirmation, is
// fixed.
// kind: 0 ARB found (red), 1 no ARB found (reminder), 2 MediaTek preloader,
//       3 summary, 4 the phone's ARB is above the firmware's (refused)
export component ConfirmSheet inherits Rectangle {
    in property <int> kind;
    // ARB of the firmware when kind is 0; -1 when unknown.
    in property <int> arb;
    // ARB installed on the phone; -1 when it could not be read.
    in property <int> phone-arb: -1;
    // Why phone-arb is -1: 0 not asked, 1 no phone over adb, 2 no root for
    // Shell, 3 xbl_config unreadable.
    in property <int> phone-arb-why: 0;
    in property <string> phone;
    in property <string> chip-name;
    in property <string> firmware;
    // Codenames the firmware is built for when they differ from the phone's.
    in property <string> wrong-device;
    // Settings → Experimental → Rebuild super is on.
    in property <bool> rebuild-super;
    // Settings → Firmware → the legacy bootloader route is on, for a
    // Snapdragon: worth a warning before Install.
    in property <bool> modem-bootloader;
    in property <string> super-plan;
    // The rebuild was acknowledged; Install waits for it.
    property <bool> rebuild-ok: false;
    property <bool> can-install: !root.rebuild-super || (root.super-plan != "" && root.rebuild-ok);
    // xbl/abl for kinds 0 and 1, preloader for kind 2
    in-out property <bool> skip-checked;
    // Partitions to leave as they are on the phone; joined into the
    // comma-separated skip list the flash session takes.
    in-out property <bool> skip-boot;
    in-out property <bool> skip-init-boot;
    in-out property <bool> skip-recovery;
    in-out property <bool> skip-vendor-boot;
    in-out property <string> skip-other;
    callback cancel();
    callback next();
    callback back();
    callback change-chip();
    callback install();
    TouchArea { }

    width: 100%;
    height: 100%;
    background: StatusColors.scrim;
    property <bool> danger: root.kind == 0 || root.kind == 4;
    property <color> accent: root.danger ? MaterialPalette.error : StatusColors.warning;
    // Placed by hand: centring through nested layouts squeezed the card below
    // the height its wrapped text needs.
            Rectangle {
        width: 580px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        background: MaterialPalette.surface-container-high;
        border-width: root.danger ? 2px : 1px;
        border-color: root.danger ? MaterialPalette.error : MaterialPalette.outline-variant;
        clip: true;
        height: card.preferred-height;
        card := VerticalLayout {
                    // Red band on top: the one thing that must not be missed.
                    if root.danger: Rectangle {
                height: 6px;
                background: MaterialPalette.error;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                // A refusal has no second step.
                if root.kind != 4: Text {
                    text: root.kind == 3 ? Tr.t("Step 2 of 2", "Шаг 2 из 2", "第 2 步，共 2 步", "第 2 步，共 2 步") : Tr.t("Step 1 of 2", "Шаг 1 из 2", "第 1 步，共 2 步", "第 1 步，共 2 步");
                    font-size: 12px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface-variant;
                }

                // ── Warning step ─────────────────────────────────
                        if root.kind != 3: HorizontalLayout {
                    spacing: 12px;
                    Image {
                        source: @image-url("../icons/warning.svg");
                        width: 28px;
                        height: 28px;
                        colorize: root.accent;
                    }

                    Text {
                        width: 492px;
                        text: root.kind == 0 ? Tr.t("This firmware has ARB ", "В прошивке ARB ", "此固件的 ARB 为 ", "此韌體的 ARB 為 ") + root.arb
                            // 0 and "could not read" are different answers.
                            : root.kind == 1 && root.arb >= 0 ? Tr.t("This firmware has no ARB", "В прошивке нет ARB", "此固件没有 ARB", "此韌體沒有 ARB")
                            : root.kind == 1 ? Tr.t("This firmware's ARB is unknown", "ARB прошивки неизвестен", "此固件的 ARB 未知", "此韌體的 ARB 未知")
                            : root.kind == 4 ? Tr.t("The phone has ARB ", "На смартфоне ARB ", "手机的 ARB 为 ", "手機的 ARB 為 ") + root.phone-arb
                            + Tr.t(", the firmware only ", ", а в прошивке только ", "，而固件只有 ", "，而韌體只有 ") + root.arb
                            : Tr.t("This firmware contains a preloader", "В прошивке есть preloader", "此固件包含 preloader", "此韌體包含 preloader");
                        font-size: 19px;
                        font-weight: 600;
                        color: root.accent;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // The check ran but could not tell: say why, so the generic
                // warning below does not look like no check at all.
                if root.kind < 2 && root.phone-arb < 0 && root.phone-arb-why > 0: Text {
                    text: root.phone-arb-why == 1 ? Tr.t(
                                "The phone's ARB was not checked: the phone is not connected over adb (Android with USB debugging on).",
                                "ARB смартфона не проверен: смартфон не подключён по adb (Android с включённой отладкой по USB).",
                                "未检查手机的 ARB：手机未通过 adb 连接（开启 USB 调试的 Android）。",
                                "未檢查手機的 ARB：手機未透過 adb 連接（開啟 USB 偵錯的 Android）。")
                        : root.phone-arb-why == 2 ? Tr.t(
                                "The phone's ARB was not checked: no root for Shell. KernelSU / APatch: grant root to Shell in the manager (turn on showing system apps). Magisk: allow the request on the phone.",
                                "ARB смартфона не проверен: у Shell нет root. KernelSU / APatch: выдайте root приложению Shell в менеджере (включите показ системных приложений). Magisk: разрешите запрос на смартфоне.",
                                "未检查手机的 ARB：Shell 没有 root 权限。KernelSU / APatch：在管理器中为 Shell 授予 root（打开显示系统应用）。Magisk：在手机上允许请求。",
                                "未檢查手機的 ARB：Shell 沒有 root 權限。KernelSU / APatch：在管理器中為 Shell 授予 root（開啟顯示系統應用程式）。Magisk：在手機上允許請求。")
                        : Tr.t(
                                "The phone's ARB was not checked: xbl_config could not be read from the phone.",
                                "ARB смартфона не проверен: не удалось прочитать xbl_config со смартфона.",
                                "未检查手机的 ARB：无法从手机读取 xbl_config。",
                                "未檢查手機的 ARB：無法從手機讀取 xbl_config。");
                    font-size: 13px;
                    font-weight: 500;
                    color: StatusColors.warning;
                    wrap: word-wrap;
                }

                // The phone's ARB is known but the firmware's is not: show it.
                if root.kind == 1 && root.phone-arb >= 0: Text {
                    text: Tr.t("The phone has ARB ", "На смартфоне ARB ", "手机的 ARB 为 ", "手機的 ARB 為 ") + root.phone-arb + ".";
                    font-size: 14px;
                    font-weight: 600;
                    color: root.accent;
                    wrap: word-wrap;
                }

                if root.kind == 0 && root.phone-arb >= 0: Text {
                    text: Tr.t("The phone has ARB ", "Сейчас на смартфоне ARB ", "手机当前的 ARB 为 ", "手機目前的 ARB 為 ") + root.phone-arb
                        + Tr.t("; after installing it becomes ", "; после установки станет ", "；安装后将变为 ", "；安裝後將變為 ") + root.arb + ".";
                    font-size: 14px;
                    font-weight: 600;
                    color: root.accent;
                    wrap: word-wrap;
                }

                if root.kind != 3: Text {
                    text: root.kind == 4 ? Tr.t(
                                "The phone's bootloader rejects firmware with a lower ARB: after installing, the phone would not boot — a brick. Installing is not possible. Choose firmware with ARB ",
                                "Загрузчик смартфона не пропустит прошивку с меньшим ARB: после установки он не загрузится и превратится в «кирпич». Установка невозможна. Выберите прошивку с ARB ",
                                "手机的引导程序会拒绝 ARB 更低的固件：安装后手机将无法启动——变砖。无法安装。请选择 ARB 不低于 ",
                                "手機的引導程式會拒絕 ARB 更低的韌體：安裝後手機將無法開機——變磚。無法安裝。請選擇 ARB 不低於 ")
                        + root.phone-arb + Tr.t(" or higher.", " или выше.", " 的固件。", " 的韌體。")
                        : root.kind == 0 ? Tr.t(
                                "After installing, the phone can never go back to firmware with a lower ARB: it would no longer boot — a brick. Updating to newer firmware stays possible.",
                                "После установки вернуться на прошивку с меньшим ARB будет нельзя: смартфон перестанет загружаться и превратится в «кирпич». Обновляться на более новые прошивки можно.",
                                "安装后，手机将无法再回退到 ARB 更低的固件：否则将无法启动——变砖。升级到更新的固件不受影响。",
                                "安裝後，手機將無法再退回 ARB 更低的韌體：否則將無法開機——變磚。升級到更新的韌體不受影響。")
                        : root.kind == 1 && root.arb < 0 ? Tr.t(
                                "Its xbl_config is missing or could not be read — that is not the same as ARB 0. If this firmware's ARB is lower than the phone's, the phone will not boot after installing — a brick; if it is higher, there is no going back. Make sure you know both.",
                                "В ней нет xbl_config или его не удалось прочитать — это не то же самое, что ARB 0. Если ARB прошивки ниже, чем у смартфона, после установки он не загрузится и превратится в «кирпич»; если выше — откатиться будет нельзя. Убедитесь, что знаете оба значения.",
                                "其中没有 xbl_config 或无法读取——这不等于 ARB 0。如果固件的 ARB 低于手机，安装后将无法启动——变砖；如果更高，则无法回退。请确认您知道两者的值。",
                                "其中沒有 xbl_config 或無法讀取——這不等於 ARB 0。如果韌體的 ARB 低於手機，安裝後將無法開機——變磚；如果更高，則無法回退。請確認您知道兩者的值。")
                        : root.kind == 1 ? Tr.t(
                                "But the phone may already run firmware with ARB. If the phone's ARB is higher than this firmware's, it will not boot after installing — a brick. Make sure you know your phone's current ARB.",
                                "Но на смартфоне уже может стоять прошивка с ARB. Если ARB смартфона выше, чем у этой прошивки, после установки он не загрузится и превратится в «кирпич». Убедитесь, что знаете текущий ARB смартфона.",
                                "但手机上可能已经是带 ARB 的固件。如果手机的 ARB 高于此固件，安装后将无法启动——变砖。请确认您知道手机当前的 ARB。",
                                "但手機上可能已經是帶 ARB 的韌體。如果手機的 ARB 高於此韌體，安裝後將無法開機——變磚。請確認您知道手機目前的 ARB。")
                        : Tr.t(
                                "The preloader can only be written in special service modes that need authorization. Installing without it usually works.",
                                "Preloader записывается только в особых сервисных режимах с авторизацией. Обычно прошивка без него проходит нормально.",
                                "preloader 只能在需要授权的特殊维修模式下写入。不刷 preloader 通常也能正常安装。",
                                "preloader 只能在需要授權的特殊維修模式下寫入。不刷 preloader 通常也能正常安裝。");
                    font-size: 14px;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                }

                if root.kind < 3: Rectangle {
                    border-radius: 12px;
                    background: root.danger ? MaterialPalette.error-container.with-alpha(0.5) : StatusColors.warning-container.with-alpha(0.5);
                    HorizontalLayout {
                        padding: 8px;
                        padding-right: 14px;
                        spacing: 4px;
                        CheckBox {
                            check-state: root.skip-checked ? CheckState.checked : CheckState.unchecked;
                            checked-state-changed(s) => {
                                root.skip-checked = s == CheckState.checked;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                width: 446px;
                                text: root.kind == 2 ? Tr.t("Skip the preloader", "Пропустить preloader", "跳过 preloader", "跳過 preloader")
                                    : Tr.t("Don't install the bootloader files (xbl, abl)", "Не прошивать файлы загрузчика (xbl, abl)", "不刷写引导程序文件（xbl、abl）", "不刷寫引導程式檔案（xbl、abl）");
                                font-size: 14px;
                                font-weight: 500;
                                color: MaterialPalette.on-surface;
                                wrap: word-wrap;
                            }

                            Text {
                                width: 446px;
                                text: root.kind == 2
                                    ? Tr.t("This can also brick the phone. At your own risk.", "Это тоже может превратить смартфон в «кирпич». Только на свой страх и риск.", "这同样可能导致手机变砖。风险自负。", "這同樣可能導致手機變磚。風險自負。")
                                    : Tr.t("Sometimes keeps the phone's current ARB, but can also brick it. At your own risk.", "Иногда помогает сохранить текущий ARB смартфона, но тоже может превратить его в «кирпич». Только на свой страх и риск.", "有时可以保留手机当前的 ARB，但同样可能导致变砖。风险自负。", "有時可以保留手機目前的 ARB，但同樣可能導致變磚。風險自負。");
                                font-size: 12px;
                                color: root.danger ? MaterialPalette.error : StatusColors.warning;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ── Summary step ─────────────────────────────────
                        if root.kind == 3: Text {
                    text: Tr.t("Ready to install", "Всё готово к установке", "一切就绪，可以安装", "一切就緒，可以安裝");
                    font-size: 22px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }

                if root.kind == 3: VerticalLayout {
                    FieldRow {
                        label-width: 150px;
                        label: Tr.t("Phone", "Смартфон", "手机", "手機");
                        Text {
                            text: root.phone;
                            font-size: 14px;
                            font-weight: 500;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    FieldRow {
                        label-width: 150px;
                        label: Tr.t("Processor", "Процессор", "处理器", "處理器");
                        Text {
                            text: root.chip-name;
                            font-size: 14px;
                            font-weight: 500;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                        }

                        TextButton {
                            text: Tr.t("Change", "Изменить", "更改", "變更");
                            clicked => {
                                root.change-chip();
                            }
                        }
                    }

                    FieldRow {
                        label-width: 150px;
                        label: Tr.t("Firmware", "Прошивка", "固件", "韌體");
                        Text {
                            text: root.firmware;
                            font-size: 14px;
                            font-weight: 500;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    if root.wrong-device != "": FieldRow {
                        label-width: 150px;
                        label: Tr.t("Built for", "Собрана для", "适用于", "適用於");
                        Text {
                            text: root.wrong-device + Tr.t(" — not this phone?", " — не этот смартфон?", " —— 不是这台手机？", " —— 不是這台手機？");
                            font-size: 14px;
                            font-weight: 500;
                            color: StatusColors.warning;
                            vertical-alignment: center;
                        }
                    }

                    if root.modem-bootloader: FieldRow {
                        label-width: 150px;
                        label: "Modem";
                        Text {
                            text: Tr.t("through the bootloader — not recommended", "через bootloader — не рекомендуется", "经由 bootloader——不推荐", "經由 bootloader——不建議");
                            font-size: 14px;
                            font-weight: 500;
                            color: StatusColors.warning;
                            vertical-alignment: center;
                        }
                    }

                    if root.arb > 0: FieldRow {
                        label-width: 150px;
                        label: "ARB";
                        Rectangle {
                            border-radius: 8px;
                            background: MaterialPalette.error-container;
                            width: arb-text.preferred-width + 16px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            arb-text := Text {
                                text: root.arb + Tr.t(" — no going back to lower", " — откат на меньший невозможен", "——无法回退到更低版本", "——無法退回更低版本");
                                font-size: 13px;
                                font-weight: 500;
                                color: MaterialPalette.on-error-container;
                            }
                        }
                    }
                }

                if root.kind == 3: Text {
                    text: Tr.t("Don't install (the phone keeps its own), e.g. to keep root or a custom recovery:", "Не прошивать (останется то, что на смартфоне) — например, чтобы сохранить root или свой recovery:", "不刷写（保留手机上现有的），例如为了保留 root 或第三方 recovery：", "不刷寫（保留手機上現有的），例如為了保留 root 或第三方 recovery：");
                    font-size: 13px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }

                if root.kind == 3: HorizontalLayout {
                    spacing: 8px;
                    SkipChip {
                        text: "boot";
                        checked <=> root.skip-boot;
                    }

                    SkipChip {
                        text: "init_boot";
                        checked <=> root.skip-init-boot;
                    }

                    SkipChip {
                        text: "recovery";
                        checked <=> root.skip-recovery;
                    }

                    SkipChip {
                        text: "vendor_boot";
                        checked <=> root.skip-vendor-boot;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        min-width: 90px;
                        clip: true;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: other.has-focus ? MaterialPalette.primary : MaterialPalette.outline;
                        Text {
                            x: 10px;
                            visible: root.skip-other == "" && !other.has-focus;
                            text: Tr.t("other, comma-separated", "другие, через запятую", "其他，用逗号分隔", "其他，用逗號分隔");
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                        }

                        other := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            text <=> root.skip-other;
                            font-size: 13px;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }

                if root.kind == 3 && root.rebuild-super: Rectangle {
                    border-radius: 12px;
                    background: StatusColors.warning-container.with-alpha(0.6);
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text {
                            width: 508px;
                            text: root.super-plan == ""
                                ? Tr.t("Rebuild super is on, but this firmware has no partition layout (not a .zip, or unpacked by an older version). Turn it off in Settings or choose the .zip again.", "Пересоздание super включено, но в этой прошивке нет разметки разделов (не .zip или распакована старой версией). Выключите его в настройках или выберите .zip заново.", "已开启重建 super，但此固件没有分区布局（不是 .zip，或由旧版本解压）。请在设置中关闭，或重新选择 .zip。", "已開啟重建 super，但此韌體沒有分割區配置（不是 .zip，或由舊版本解壓）。請在設定中關閉，或重新選擇 .zip。")
                                : Tr.t("Experimental: super will be wiped and rebuilt with this layout (group sizes are fitted to the phone):", "Экспериментально: super будет стёрт и пересоздан с такой разметкой (размеры групп подгоняются под смартфон):", "实验性：super 将被清除并按此布局重建（分组大小会适配手机）：", "實驗性：super 將被清除並按此配置重建（群組大小會配合手機）：");
                            font-size: 13px;
                            font-weight: 500;
                            color: StatusColors.on-warning-container;
                            wrap: word-wrap;
                        }

                        if root.super-plan != "": Text {
                            width: 508px;
                            text: root.super-plan;
                            font-family: "monospace";
                            font-size: 10px;
                            overflow: elide;
                            color: StatusColors.on-warning-container;
                        }

                        if root.super-plan != "": HorizontalLayout {
                            spacing: 4px;
                            CheckBox {
                                check-state: root.rebuild-ok ? CheckState.checked : CheckState.unchecked;
                                checked-state-changed(c) => {
                                    root.rebuild-ok = c == CheckState.checked;
                                }
                            }

                            Text {
                                width: 460px;
                                text: Tr.t("I understand: rebuild super", "Понимаю: пересоздать super", "我明白：重建 super", "我明白：重建 super");
                                font-size: 13px;
                                font-weight: 500;
                                color: StatusColors.on-warning-container;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.kind == 3: Rectangle {
                    border-radius: 12px;
                    background: MaterialPalette.error-container;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Image {
                            source: @image-url("../icons/warning.svg");
                            width: 20px;
                            height: 20px;
                            colorize: MaterialPalette.on-error-container;
                        }

                        Text {
                            width: 478px;
                            text: Tr.t(
                                        "The phone's system is overwritten completely; this cannot be undone. Keep the cable plugged in for 10–20 minutes and the battery above 30%. Everything is at your own risk.",
                                        "Система смартфона будет полностью перезаписана — это необратимо. Не отключайте кабель 10–20 минут, заряд — не меньше 30 %. Всё — на ваш страх и риск.",
                                        "手机系统将被完全覆盖，此操作不可撤销。请在 10–20 分钟内保持数据线连接，电量不低于 30%。一切风险自负。",
                                        "手機系統將被完全覆寫，此操作無法復原。請在 10–20 分鐘內保持傳輸線連接，電量不低於 30%。一切風險自負。");
                            font-size: 13px;
                            color: MaterialPalette.on-error-container;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 6px;
                    TextButton {
                        text: root.kind == 3 ? Tr.t("Back", "Назад", "返回", "返回")
                            : root.kind == 4 ? Tr.t("Close", "Закрыть", "关闭", "關閉")
                            : Tr.t("Cancel", "Отмена", "取消", "取消");
                        clicked => {
                            if root.kind == 3 {
                                root.back();
                            } else {
                                root.cancel();
                            }
                        }
                    }

                    if root.kind != 4: FilledButton {
                        enabled: root.kind != 3 || root.can-install;
                        text: root.kind == 3 ? Tr.t("Install", "Установить", "安装", "安裝") : Tr.t("I understand, next", "Понятно, дальше", "我明白，下一步", "我明白，下一步");
                        clicked => {
                            if root.kind == 3 {
                                root.install();
                            } else {
                                root.next();
                            }
                        }
                    }
                }
            }
        }
    }
}
