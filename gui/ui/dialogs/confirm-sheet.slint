import {
    CheckBox,
    CheckState,
    FilledButton,
    MaterialPalette,
    TextButton,
} from "@material";
import { StatusColors } from "../globals/status-colors.slint";
import { Tr } from "../globals/tr.slint";
import { FieldRow, Segmented } from "../components/wizard.slint";

// A toggle for one partition to leave alone.
component SkipChip inherits TouchArea {
    in property <string> text;
    in-out property <bool> checked;
    height: 32px;
    // Partition names are set in mono; a check icon, not a ✓ glyph, marks
    // the chosen ones.
    width: label.preferred-width + (root.checked ? 44px : 28px);
    clicked => {
        root.checked = !root.checked;
    }

    Rectangle {
        border-radius: 8px;
        background: root.checked ? MaterialPalette.secondary-container
            : root.has-hover ? MaterialPalette.on-surface.with-alpha(0.06) : transparent;
        border-width: root.checked ? 0px : 1px;
        border-color: MaterialPalette.outline;

        HorizontalLayout {
            padding-left: root.checked ? 10px : 14px;
            padding-right: 14px;
            spacing: 4px;
            if root.checked: Image {
                source: @image-url("../icons/check.svg");
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                colorize: MaterialPalette.on-secondary-container;
            }
            label := Text {
                text: root.text;
                font-size: 13px;
                font-family: "monospace";
                color: root.checked ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
                vertical-alignment: center;
            }
        }
    }
}

// One of the two modem routes, when the firmware's Android is unknown.
component RouteChip inherits TouchArea {
    in property <string> text;
    in property <bool> checked;
    // As tall as the row, so the chip sits level with its label.
    height: 44px;
    width: label.preferred-width + 28px;

    Rectangle {
        height: 32px;
        y: (parent.height - self.height) / 2;
        border-radius: 8px;
        background: root.checked ? MaterialPalette.secondary-container
            : root.has-hover ? MaterialPalette.on-surface.with-alpha(0.06) : transparent;
        border-width: root.checked ? 0px : 1px;
        border-color: MaterialPalette.outline;

        label := Text {
            text: root.text;
            font-size: 13px;
            color: root.checked ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The one sheet between "Install" and the hands-off run. Its warning step
// always comes before the summary: the order ARB, then final confirmation, is
// fixed.
// kind: 0 ARB found (red), 1 no ARB found (reminder), 2 MediaTek preloader,
//       3 summary, 4 the phone's ARB is above the firmware's (refused)
export component ConfirmSheet inherits Rectangle {
    in property <int> kind;
    // ARB of the firmware when kind is 0; -1 when unknown.
    in property <int> arb;
    // ARB installed on the phone; -1 when it could not be read.
    in property <int> phone-arb: -1;
    // Why phone-arb is -1: 0 not asked, 1 no phone over adb, 2 no root for
    // Shell, 3 xbl_config unreadable.
    in property <int> phone-arb-why: 0;
    in property <string> phone;
    in property <string> chip-name;
    in property <string> firmware;
    // Codenames the firmware is built for when they differ from the phone's.
    in property <string> wrong-device;
    // Settings → Firmware → Rebuild super when needed is on.
    in property <bool> rebuild-super;
    // A Snapdragon flash with the modem through the bootloader: by default
    // for firmware up to Android 16, or forced in Settings → Firmware.
    in property <bool> modem-bootloader;
    in property <bool> modem-bootloader-forced;
    // A realme GT Neo 5 model: the bootloader route on any Android.
    in property <bool> bootloader-model;
    // Forced bootloader on Android 17 off the GT Neo 5: the install refuses.
    property <bool> refused: root.modem-bootloader-forced && root.fw-android >= 17 && !root.bootloader-model;
    // The firmware's Android version, -1 unknown. Forced bootloader on 17
    // and newer is refused by the install.
    in property <int> fw-android: -1;
    // Snapdragon with the Android version unknown and no forced route: the
    // user picks it here, Install waits for the choice.
    in property <bool> route-needed;
    // 0 not chosen, 1 the modem through the bootloader, 2 all in fastbootd.
    in-out property <int> route-choice;
    private property <bool> switches-slot: root.chip-name == "Snapdragon" && !root.modem-bootloader
        && (root.route-needed ? root.route-choice == 2 : root.fw-android >= 17);
    in-out property <bool> copy-skipped-partitions;
    // The firmware's super layout, one line per group; empty without one.
    in property <string> super-plan;
    // Custom ROM, at the user's own risk: super is always wiped and rebuilt
    // from the ROM's layout. Needs super-plan; Install waits without it.
    in-out property <bool> custom-rom;
    // Root: index in RootFork::ALL (KernelSU, KernelSU Next, SukiSU Ultra),
    // -1 off; the patched init_boot is flashed instead of the stock one.
    in-out property <int> root-fork: -1;
    in-out property <bool> root-manager: true;
    // xbl/abl for kinds 0 and 1, preloader for kind 2
    in-out property <bool> skip-checked;
    // Partitions to leave as they are on the phone; joined into the
    // comma-separated skip list the flash session takes.
    in-out property <bool> skip-boot;
    in-out property <bool> skip-init-boot;
    in-out property <bool> skip-recovery;
    in-out property <bool> skip-vendor-boot;
    in-out property <string> skip-other;
    callback cancel();
    callback next();
    callback back();
    callback change-chip();
    callback install();

    TouchArea { }

    width: 100%;
    height: 100%;
    background: StatusColors.scrim;
    property <bool> danger: root.kind == 0 || root.kind == 4;
    property <color> accent: root.danger ? MaterialPalette.error : StatusColors.warning;
    // Placed by hand: centring through nested layouts squeezed the card below
    // the height its wrapped text needs.
            Rectangle {
        width: 580px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        background: MaterialPalette.surface-container-high;
        border-width: root.danger ? 2px : 1px;
        border-color: root.danger ? MaterialPalette.error : MaterialPalette.outline-variant;
        clip: true;
        height: card.preferred-height;

        card := VerticalLayout {
                    // Red band on top: the one thing that must not be missed.
                    if root.danger: Rectangle {
                height: 6px;
                background: MaterialPalette.error;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                // A refusal has no second step.
                if root.kind != 4: Text {
                    text: root.kind == 3 ? Tr.t("Step 2 of 2", "Шаг 2 из 2", "第 2 步，共 2 步", "第 2 步，共 2 步") : Tr.t("Step 1 of 2", "Шаг 1 из 2", "第 1 步，共 2 步", "第 1 步，共 2 步");
                    font-size: 12px;
                    font-weight: 500;
                    color: MaterialPalette.on-surface-variant;
                }

                // ── Warning step ─────────────────────────────────
                        if root.kind != 3: HorizontalLayout {
                    spacing: 12px;

                    Image {
                        source: @image-url("../icons/warning.svg");
                        width: 28px;
                        height: 28px;
                        colorize: root.accent;
                    }

                    Text {
                        width: 492px;
                        text: root.kind == 0 ? Tr.t("This firmware has ARB ", "В прошивке ARB ", "此固件的 ARB 为 ", "此韌體的 ARB 為 ") + root.arb
                            // 0 and "could not read" are different answers.
                            : root.kind == 1 && root.arb >= 0 ? Tr.t("This firmware has no ARB", "В прошивке нет ARB", "此固件没有 ARB", "此韌體沒有 ARB")
                            : root.kind == 1 ? Tr.t("This firmware's ARB is unknown", "ARB прошивки неизвестен", "此固件的 ARB 未知", "此韌體的 ARB 未知")
                            : root.kind == 4 ? Tr.t("The phone has ARB ", "На смартфоне ARB ", "手机的 ARB 为 ", "手機的 ARB 為 ") + root.phone-arb
                            + Tr.t(", the firmware only ", ", а в прошивке только ", "，而固件只有 ", "，而韌體只有 ") + root.arb
                            : Tr.t("This firmware contains a preloader", "В прошивке есть preloader", "此固件包含 preloader", "此韌體包含 preloader");
                        font-size: 19px;
                        font-weight: 500;
                        color: root.accent;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // The check ran but could not tell: say why, so the generic
                // warning below does not look like no check at all.
                if root.kind < 2 && root.phone-arb < 0 && root.phone-arb-why > 0: Text {
                    text: root.phone-arb-why == 1 ? Tr.t(
                                "The phone's ARB was not checked: the phone is not connected over adb (Android with USB debugging on).",
                                "ARB смартфона не проверен: смартфон не подключён по adb (Android с включённой отладкой по USB).",
                                "未检查手机的 ARB：手机未通过 adb 连接（开启 USB 调试的 Android）。",
                                "未檢查手機的 ARB：手機未透過 adb 連接（開啟 USB 偵錯的 Android）。")
                        : root.phone-arb-why == 2 ? Tr.t(
                                "The phone's ARB was not checked: no root for Shell. KernelSU / APatch: grant root to Shell in the manager (turn on showing system apps). Magisk: allow the request on the phone.",
                                "ARB смартфона не проверен: у Shell нет root. KernelSU / APatch: выдайте root приложению Shell в менеджере (включите показ системных приложений). Magisk: разрешите запрос на смартфоне.",
                                "未检查手机的 ARB：Shell 没有 root 权限。KernelSU / APatch：在管理器中为 Shell 授予 root（打开显示系统应用）。Magisk：在手机上允许请求。",
                                "未檢查手機的 ARB：Shell 沒有 root 權限。KernelSU / APatch：在管理器中為 Shell 授予 root（開啟顯示系統應用程式）。Magisk：在手機上允許請求。")
                        : Tr.t(
                                "The phone's ARB was not checked: xbl_config could not be read from the phone.",
                                "ARB смартфона не проверен: не удалось прочитать xbl_config со смартфона.",
                                "未检查手机的 ARB：无法从手机读取 xbl_config。",
                                "未檢查手機的 ARB：無法從手機讀取 xbl_config。");
                    font-size: 13px;
                    font-weight: 500;
                    color: StatusColors.warning;
                    wrap: word-wrap;
                }

                // The phone's ARB is known but the firmware's is not: show it.
                if root.kind == 1 && root.phone-arb >= 0: Text {
                    text: Tr.t("The phone has ARB ", "На смартфоне ARB ", "手机的 ARB 为 ", "手機的 ARB 為 ") + root.phone-arb + ".";
                    font-size: 14px;
                    font-weight: 500;
                    color: root.accent;
                    wrap: word-wrap;
                }

                if root.kind == 0 && root.phone-arb >= 0: Text {
                    text: Tr.t("The phone has ARB ", "Сейчас на смартфоне ARB ", "手机当前的 ARB 为 ", "手機目前的 ARB 為 ") + root.phone-arb
                        + Tr.t("; after installing it becomes ", "; после установки станет ", "；安装后将变为 ", "；安裝後將變為 ") + root.arb + ".";
                    font-size: 14px;
                    font-weight: 500;
                    color: root.accent;
                    wrap: word-wrap;
                }

                if root.kind != 3: Text {
                    text: root.kind == 4 ? Tr.t(
                                "The phone's bootloader rejects firmware with a lower ARB: after installing, the phone would not boot — a brick. Installing is not possible. Choose firmware with ARB ",
                                "Загрузчик смартфона не пропустит прошивку с меньшим ARB: после установки он не загрузится и превратится в «кирпич». Установка невозможна. Выберите прошивку с ARB ",
                                "手机的引导程序会拒绝 ARB 更低的固件：安装后手机将无法启动——变砖。无法安装。请选择 ARB 不低于 ",
                                "手機的引導程式會拒絕 ARB 更低的韌體：安裝後手機將無法開機——變磚。無法安裝。請選擇 ARB 不低於 ")
                        + root.phone-arb + Tr.t(" or higher.", " или выше.", " 的固件。", " 的韌體。")
                        : root.kind == 0 ? Tr.t(
                                "After installing, the phone can never go back to firmware with a lower ARB: it would no longer boot — a brick. Updating to newer firmware stays possible.",
                                "После установки вернуться на прошивку с меньшим ARB будет нельзя: смартфон перестанет загружаться и превратится в «кирпич». Обновляться на более новые прошивки можно.",
                                "安装后，手机将无法再回退到 ARB 更低的固件：否则将无法启动——变砖。升级到更新的固件不受影响。",
                                "安裝後，手機將無法再退回 ARB 更低的韌體：否則將無法開機——變磚。升級到更新的韌體不受影響。")
                        : root.kind == 1 && root.arb < 0 ? Tr.t(
                                "Its xbl_config is missing or could not be read — that is not the same as ARB 0. If this firmware's ARB is lower than the phone's, the phone will not boot after installing — a brick; if it is higher, there is no going back. Make sure you know both.",
                                "В ней нет xbl_config или его не удалось прочитать — это не то же самое, что ARB 0. Если ARB прошивки ниже, чем у смартфона, после установки он не загрузится и превратится в «кирпич»; если выше — откатиться будет нельзя. Убедитесь, что знаете оба значения.",
                                "其中没有 xbl_config 或无法读取——这不等于 ARB 0。如果固件的 ARB 低于手机，安装后将无法启动——变砖；如果更高，则无法回退。请确认您知道两者的值。",
                                "其中沒有 xbl_config 或無法讀取——這不等於 ARB 0。如果韌體的 ARB 低於手機，安裝後將無法開機——變磚；如果更高，則無法回退。請確認您知道兩者的值。")
                        : root.kind == 1 ? Tr.t(
                                "But the phone may already run firmware with ARB. If the phone's ARB is higher than this firmware's, it will not boot after installing — a brick. Make sure you know your phone's current ARB.",
                                "Но на смартфоне уже может стоять прошивка с ARB. Если ARB смартфона выше, чем у этой прошивки, после установки он не загрузится и превратится в «кирпич». Убедитесь, что знаете текущий ARB смартфона.",
                                "但手机上可能已经是带 ARB 的固件。如果手机的 ARB 高于此固件，安装后将无法启动——变砖。请确认您知道手机当前的 ARB。",
                                "但手機上可能已經是帶 ARB 的韌體。如果手機的 ARB 高於此韌體，安裝後將無法開機——變磚。請確認您知道手機目前的 ARB。")
                        : Tr.t(
                                "The preloader can only be written in special service modes that need authorization. Installing without it usually works.",
                                "Preloader записывается только в особых сервисных режимах с авторизацией. Обычно прошивка без него проходит нормально.",
                                "preloader 只能在需要授权的特殊维修模式下写入。不刷 preloader 通常也能正常安装。",
                                "preloader 只能在需要授權的特殊維修模式下寫入。不刷 preloader 通常也能正常安裝。");
                    font-size: 14px;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                }

                if root.kind < 3: Rectangle {
                    border-radius: 12px;
                    background: root.danger ? MaterialPalette.error-container.with-alpha(0.5) : StatusColors.warning-container.with-alpha(0.5);

                    HorizontalLayout {
                        padding: 8px;
                        padding-right: 14px;
                        spacing: 4px;

                        CheckBox {
                            check-state: root.skip-checked ? CheckState.checked : CheckState.unchecked;
                            checked-state-changed(s) => {
                                root.skip-checked = s == CheckState.checked;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                width: 446px;
                                text: root.kind == 2 ? Tr.t("Skip the preloader", "Пропустить preloader", "跳过 preloader", "跳過 preloader")
                                    : Tr.t("Skip the firmware's bootloader files (xbl, abl)", "Пропустить файлы загрузчика из прошивки (xbl, abl)", "跳过固件中的引导程序文件（xbl、abl）", "跳過韌體中的引導程式檔案（xbl、abl）");
                                font-size: 14px;
                                font-weight: 500;
                                color: MaterialPalette.on-surface;
                                wrap: word-wrap;
                            }

                            Text {
                                width: 446px;
                                text: root.kind == 2
                                    ? Tr.t("This can also brick the phone. At your own risk.", "Это тоже может превратить смартфон в «кирпич». Только на свой страх и риск.", "这同样可能导致手机变砖。风险自负。", "這同樣可能導致手機變磚。風險自負。")
                                    : Tr.t("Sometimes keeps the phone's current ARB, but can also brick it. At your own risk.", "Иногда помогает сохранить текущий ARB смартфона, но тоже может превратить его в «кирпич». Только на свой страх и риск.", "有时可以保留手机当前的 ARB，但同样可能导致变砖。风险自负。", "有時可以保留手機目前的 ARB，但同樣可能導致變磚。風險自負。");
                                font-size: 12px;
                                color: root.danger ? MaterialPalette.error : StatusColors.warning;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ── Summary step ─────────────────────────────────
                        if root.kind == 3: Text {
                    text: Tr.t("Ready to install", "Всё готово к установке", "一切就绪，可以安装", "一切就緒，可以安裝");
                    font-size: 22px;
                    font-weight: 500;
                    color: MaterialPalette.on-surface;
                }

                if root.kind == 3: VerticalLayout {
                    FieldRow {
                        label-width: 150px;
                        label: Tr.t("Phone", "Смартфон", "手机", "手機");

                        Text {
                            text: root.phone;
                            font-size: 14px;
                            font-weight: 500;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    FieldRow {
                        label-width: 150px;
                        label: Tr.t("Processor", "Процессор", "处理器", "處理器");

                        Text {
                            text: root.chip-name;
                            font-size: 14px;
                            font-weight: 500;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                        }

                        TextButton {
                            text: Tr.t("Change", "Изменить", "更改", "變更");
                            clicked => {
                                root.change-chip();
                            }
                        }
                    }

                    FieldRow {
                        label-width: 150px;
                        label: Tr.t("Firmware", "Прошивка", "固件", "韌體");

                        Text {
                            text: root.firmware;
                            font-size: 14px;
                            font-weight: 500;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    if root.wrong-device != "": FieldRow {
                        label-width: 150px;
                        label: Tr.t("Built for", "Собрана для", "适用于", "適用於");

                        Text {
                            text: root.wrong-device + Tr.t(" — not this phone?", " — не этот смартфон?", " —— 不是这台手机？", " —— 不是這台手機？");
                            font-size: 14px;
                            font-weight: 500;
                            color: StatusColors.warning;
                            vertical-alignment: center;
                        }
                    }

                    if root.modem-bootloader: FieldRow {
                        label-width: 150px;
                        label: "Modem";

                        Text {
                            text: root.refused
                                ? Tr.t("through the bootloader — refused for Android 17, turn it off in Settings", "через bootloader — для Android 17 запрещено, выключите в настройках", "经由 bootloader——Android 17 禁止，请在设置中关闭", "經由 bootloader——Android 17 禁止，請在設定中關閉")
                                : root.bootloader-model
                                ? Tr.t("through the bootloader — always on realme GT Neo 5", "через bootloader — на realme GT Neo 5 всегда", "经由 bootloader——realme GT Neo 5 始终如此", "經由 bootloader——realme GT Neo 5 一律如此")
                                : root.modem-bootloader-forced
                                ? Tr.t("through the bootloader — forced in Settings", "через bootloader — включено в настройках", "经由 bootloader——已在设置中强制", "經由 bootloader——已在設定中強制")
                                : Tr.t("through the bootloader, as for Android 16 and older", "через bootloader, как для Android 16 и ниже", "经由 bootloader，适用于 Android 16 及更早版本", "經由 bootloader，適用於 Android 16 及更早版本");
                            font-size: 14px;
                            font-weight: 500;
                            color: root.refused ? MaterialPalette.error : root.modem-bootloader-forced && !root.bootloader-model ? StatusColors.warning : MaterialPalette.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }

                    if root.route-needed: FieldRow {
                        label-width: 150px;
                        label: "Modem";

                        RouteChip {
                            text: Tr.t("through the bootloader", "через bootloader", "经由 bootloader", "經由 bootloader");
                            checked: root.route-choice == 1;
                            clicked => {
                                root.route-choice = 1;
                            }
                        }

                        RouteChip {
                            text: Tr.t("everything in fastbootd", "всё в fastbootd", "全部在 fastbootd", "全部在 fastbootd");
                            checked: root.route-choice == 2;
                            clicked => {
                                root.route-choice = 2;
                            }
                        }
                    }

                    if root.route-needed: Text {
                        width: 532px;
                        text: Tr.t(
                            "The firmware does not say its Android version. Through the bootloader is the usual way for Android 16 and older; flashing ColorOS 17 this way can brick the phone, so Android 17 goes entirely in fastbootd, with a switch to the other slot.",
                            "Прошивка не указывает версию Android. Через bootloader — обычный способ для Android 16 и ниже; прошивка ColorOS 17 этим способом может вызвать «кирпич», поэтому Android 17 ставится целиком в fastbootd со сменой слота.",
                            "固件未标明 Android 版本。经由 bootloader 是 Android 16 及更早版本的常规方式；用此方式刷写 ColorOS 17 可能导致变砖，因此 Android 17 全部在 fastbootd 中刷写并切换槽位。",
                            "韌體未標明 Android 版本。經由 bootloader 是 Android 16 及更早版本的常規方式；用此方式刷寫 ColorOS 17 可能導致變磚，因此 Android 17 全部在 fastbootd 中刷寫並切換槽位。");
                        font-size: 12px;
                        color: StatusColors.warning;
                        wrap: word-wrap;
                    }

                    if root.arb > 0: FieldRow {
                        label-width: 150px;
                        label: "ARB";

                        Rectangle {
                            border-radius: 8px;
                            background: MaterialPalette.error-container;
                            width: arb-text.preferred-width + 16px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;

                            arb-text := Text {
                                text: root.arb + Tr.t(" — no going back to lower", " — откат на меньший невозможен", "——无法回退到更低版本", "——無法退回更低版本");
                                font-size: 13px;
                                font-weight: 500;
                                color: MaterialPalette.on-error-container;
                            }
                        }
                    }
                }

                if root.kind == 3: Text {
                    text: Tr.t("Partitions to skip:", "Какие разделы не прошивать:", "要跳过的分区：", "要跳過的分割區：");
                    font-size: 13px;
                    color: MaterialPalette.on-surface-variant;
                }

                if root.kind == 3: HorizontalLayout {
                    spacing: 8px;

                    SkipChip {
                        text: "boot";
                        checked <=> root.skip-boot;
                    }

                    SkipChip {
                        text: "init_boot";
                        checked <=> root.skip-init-boot;
                    }

                    SkipChip {
                        text: "recovery";
                        checked <=> root.skip-recovery;
                    }

                    SkipChip {
                        text: "vendor_boot";
                        checked <=> root.skip-vendor-boot;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        min-width: 90px;
                        clip: true;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: other.has-focus ? MaterialPalette.primary : MaterialPalette.outline;

                        Text {
                            x: 10px;
                            visible: root.skip-other == "" && !other.has-focus;
                            text: Tr.t("other, comma-separated", "другие, через запятую", "其他，用逗号分隔", "其他，用逗號分隔");
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                        }

                        other := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            text <=> root.skip-other;
                            font-size: 13px;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }

                if root.kind == 3 && root.switches-slot: HorizontalLayout {
                    spacing: 4px;

                    CheckBox {
                        check-state: root.copy-skipped-partitions ? CheckState.checked : CheckState.unchecked;
                        checked-state-changed(s) => {
                            root.copy-skipped-partitions = s == CheckState.checked;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: Tr.t("Copy skipped partitions from the current slot (requires root for Shell)", "Сохранить пропущенные разделы с текущего слота (нужен root для Shell)", "从当前槽位复制跳过的分区（需要 Shell root 权限）", "從目前槽位複製跳過的分割區（需要 Shell root 權限）");
                            font-size: 13px;
                            color: MaterialPalette.on-surface;
                            wrap: word-wrap;
                        }

                        Text {
                            text: Tr.t("Without copying, the target slot keeps its old images and might not boot.", "Без копирования в целевом слоте останутся старые образы. Смартфон может не загрузиться.", "不复制时，目标槽位保留旧镜像，手机可能无法启动。", "不複製時，目標槽位保留舊映像，手機可能無法開機。");
                            font-size: 12px;
                            color: StatusColors.warning;
                            wrap: word-wrap;
                        }
                    }
                }

                // Informational: the install's own confirmation covers it;
                // the session rebuilds only when the new slot is empty.
                if root.kind == 3 && root.rebuild-super && !root.custom-rom && root.super-plan != "": Rectangle {
                    border-radius: 12px;
                    background: StatusColors.warning-container.with-alpha(0.6);

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            width: 508px;
                            text: Tr.t("If the slot being flashed has no partitions, super is wiped and rebuilt with this layout, as from the factory — then system updates work without a repair:", "Если в прошиваемом слоте нет разделов, super будет стёрт и пересоздан с такой разметкой, как с завода, — тогда обновления системы ставятся без починки:", "如果要刷写的槽位没有分区，super 将被清除并按此布局重建（与出厂一致），之后系统更新无需修复即可安装：", "如果要刷寫的槽位沒有分割區，super 將被清除並按此配置重建（與出廠一致），之後系統更新無需修復即可安裝：");
                            font-size: 13px;
                            font-weight: 500;
                            color: StatusColors.on-warning-container;
                            wrap: word-wrap;
                        }

                        Text {
                            width: 508px;
                            text: root.super-plan;
                            font-family: "monospace";
                            font-size: 10px;
                            overflow: elide;
                            color: StatusColors.on-warning-container;
                        }
                    }
                }

                if root.kind == 3: Rectangle {
                    border-radius: 12px;
                    // Outlined, not filled: the red warning right below is the
                    // filled one, two red cards in a row compete.
                    border-width: 1px;
                    border-color: root.custom-rom ? MaterialPalette.error : MaterialPalette.outline-variant;

                    HorizontalLayout {
                        padding: 8px;
                        padding-right: 14px;
                        spacing: 4px;

                        CheckBox {
                            check-state: root.custom-rom ? CheckState.checked : CheckState.unchecked;
                            checked-state-changed(s) => {
                                root.custom-rom = s == CheckState.checked;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                width: 446px;
                                text: Tr.t("Custom ROM: wipe super and rebuild it from the ROM", "Кастомная прошивка: стереть super и пересоздать по прошивке", "第三方 ROM：清除 super 并按 ROM 重建", "第三方 ROM：清除 super 並按 ROM 重建");
                                font-size: 14px;
                                font-weight: 500;
                                color: MaterialPalette.on-surface;
                                wrap: word-wrap;
                            }

                            Text {
                                width: 446px;
                                text: !root.custom-rom
                                    ? Tr.t("For custom ROMs whose partitions differ from the phone's. Everything in super is deleted, on both slots.", "Для кастомных прошивок, у которых разделы не совпадают с телефонными. Всё в super удаляется, в обоих слотах.", "适用于分区与手机不一致的第三方 ROM。super 中的所有内容都会被删除，两个槽位都是。", "適用於分割區與手機不一致的第三方 ROM。super 中的所有內容都會被刪除，兩個槽位都是。")
                                    : root.super-plan == ""
                                    ? Tr.t("This firmware has no saved partition layout: unpack the ROM's .zip (with payload.bin) in LibreFastbootFirmwareFlasher.", "У этой прошивки нет сохранённой разметки: распакуйте .zip прошивки (с payload.bin) в LibreFastbootFirmwareFlasher.", "此固件没有保存的分区布局：请在 LibreFastbootFirmwareFlasher 中解压 ROM 的 .zip（含 payload.bin）。", "此韌體沒有儲存的分割區配置：請在 LibreFastbootFirmwareFlasher 中解壓 ROM 的 .zip（含 payload.bin）。")
                                    : Tr.t("Super is wiped: both slots lose their system, partitions the ROM lacks are deleted. If the install stops halfway, the phone won't start until it is flashed again; fastboot stays available. At your own risk.", "Super будет стёрт: оба слота теряют систему, разделы, которых нет в прошивке, удаляются. Если установка оборвётся на середине, смартфон не запустится до повторной прошивки; fastboot останется доступен. Только на свой страх и риск.", "super 将被清除：两个槽位的系统都会丢失，ROM 中没有的分区会被删除。若安装中途中断，手机在重新刷写前无法启动；fastboot 仍可使用。风险自负。", "super 將被清除：兩個槽位的系統都會遺失，ROM 中沒有的分割區會被刪除。若安裝中途中斷，手機在重新刷寫前無法啟動；fastboot 仍可使用。風險自負。");
                                font-size: 12px;
                                color: root.custom-rom ? MaterialPalette.error : MaterialPalette.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.kind == 3: Rectangle {
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.root-fork >= 0 ? MaterialPalette.primary : MaterialPalette.outline-variant;

                    VerticalLayout {
                        padding: 8px;
                        padding-right: 14px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 4px;

                            CheckBox {
                                check-state: root.root-fork >= 0 ? CheckState.checked : CheckState.unchecked;
                                checked-state-changed(s) => {
                                    root.root-fork = s == CheckState.checked ? 0 : -1;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    width: 446px;
                                    text: Tr.t("Root: patch init_boot with KernelSU, KernelSU Next or SukiSU Ultra", "Root: пропатчить init_boot через KernelSU, KernelSU Next или SukiSU Ultra", "Root：用 KernelSU、KernelSU Next 或 SukiSU Ultra 修补 init_boot", "Root：用 KernelSU、KernelSU Next 或 SukiSU Ultra 修補 init_boot");
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: MaterialPalette.on-surface;
                                    wrap: word-wrap;
                                }

                                Text {
                                    width: 446px;
                                    text: root.root-fork < 0
                                        ? Tr.t("From the latest release of the one you pick; the patched init_boot is flashed instead of the stock one.", "Из последнего релиза выбранного; вместо стокового init_boot прошивается пропатченный.", "使用所选方案的最新版本；刷入修补后的 init_boot 代替原厂版本。", "使用所選方案的最新版本；刷入修補後的 init_boot 代替原廠版本。")
                                        : Tr.t("Play Integrity fails while rooted. Never lock the bootloader with a patched init_boot: flash the stock one first.", "Пока стоит root, Play Integrity не проходит. Никогда не блокируйте загрузчик с пропатченным init_boot: сначала прошейте стоковый.", "root 期间 Play Integrity 无法通过。切勿在已修补 init_boot 的情况下锁定 bootloader：请先刷回原厂版本。", "root 期間 Play Integrity 無法通過。切勿在已修補 init_boot 的情況下鎖定 bootloader：請先刷回原廠版本。");
                                    font-size: 12px;
                                    color: MaterialPalette.on-surface-variant;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.root-fork >= 0: HorizontalLayout {
                            padding-left: 63px;
                            alignment: start;

                            Segmented {
                                segment-width: 136px;
                                items: ["KernelSU", "KernelSU Next", "SukiSU Ultra"];
                                current: root.root-fork;
                                selected(i) => {
                                    root.root-fork = i;
                                }
                            }
                        }

                        if root.root-fork >= 0: HorizontalLayout {
                            padding-left: 43px;
                            spacing: 4px;

                            CheckBox {
                                check-state: root.root-manager ? CheckState.checked : CheckState.unchecked;
                                checked-state-changed(s) => {
                                    root.root-manager = s == CheckState.checked;
                                }
                            }

                            Text {
                                width: 403px;
                                text: Tr.t("Install the manager app when the phone has started", "Установить приложение-менеджер, когда смартфон загрузится", "手机启动后安装管理器应用", "手機啟動後安裝管理器應用程式");
                                font-size: 13px;
                                color: MaterialPalette.on-surface;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.kind == 3: Rectangle {
                    border-radius: 12px;
                    background: MaterialPalette.error-container;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Image {
                            source: @image-url("../icons/warning.svg");
                            width: 20px;
                            height: 20px;
                            colorize: MaterialPalette.on-error-container;
                        }

                        Text {
                            width: 478px;
                            text: Tr.t(
                                        "The phone's system is overwritten completely; this cannot be undone. Keep the cable plugged in for 10–20 minutes and the battery above 30%. Everything is at your own risk.",
                                        "Система смартфона будет полностью перезаписана — это необратимо. Не отключайте кабель 10–20 минут, заряд — не меньше 30 %. Всё — на ваш страх и риск.",
                                        "手机系统将被完全覆盖，此操作不可撤销。请在 10–20 分钟内保持数据线连接，电量不低于 30%。一切风险自负。",
                                        "手機系統將被完全覆寫，此操作無法復原。請在 10–20 分鐘內保持傳輸線連接，電量不低於 30%。一切風險自負。");
                            font-size: 13px;
                            color: MaterialPalette.on-error-container;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 6px;

                    TextButton {
                        text: root.kind == 3 ? Tr.t("Back", "Назад", "返回", "返回")
                            : root.kind == 4 ? Tr.t("Close", "Закрыть", "关闭", "關閉")
                            : Tr.t("Cancel", "Отмена", "取消", "取消");
                        clicked => {
                            if root.kind == 3 {
                                root.back();
                            } else {
                                root.cancel();
                            }
                        }
                    }

                    if root.kind != 4: FilledButton {
                        enabled: root.kind != 3 || ((!root.route-needed || root.route-choice > 0) && (!root.custom-rom || root.super-plan != ""));
                        text: root.kind == 3 ? Tr.t("Install", "Установить", "安装", "安裝") : Tr.t("I understand, next", "Понятно, дальше", "我明白，下一步", "我明白，下一步");
                        clicked => {
                            if root.kind == 3 {
                                root.install();
                            } else {
                                root.next();
                            }
                        }
                    }
                }
            }
        }
    }
}
