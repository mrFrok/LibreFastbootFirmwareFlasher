import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { FilledButton, TextButton, BackButton } from "../components/buttons.slint";

export component FlashAllFinalDialog {
    in property <bool> show;

    callback cancel();
    callback back();
    callback flash();

    Rectangle {
        visible: show;
        opacity: show ? 1.0 : 0.0;
        animate opacity { duration: 200ms; easing: cubic-bezier(0.4, 0.0, 0.2, 1.0); }
        animate y { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        z: 100; background: MaterialPalette.overlay-backdrop-heavy; width: 100%; height: 100%;

        Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - 240px) / 2;
            width: 420px; height: 240px;
            border-radius: 16px;
            background: MaterialPalette.surface-container-high;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 8px;

            VerticalLayout { padding: 28px; spacing: 12px;
                Text {
                    text: Tr.flash-final-title;
                    font-size: 18px; font-weight: 700;
                    color: MaterialPalette.error;
                }
                Text {
                    text: Tr.flash-final-body;
                    font-size: 14px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { spacing: 8px; alignment: end;
                    TextButton {
                        text: Tr.cancel;
                        clicked => { root.cancel(); }
                    }
                    BackButton {
                        clicked => { root.back(); }
                    }
                    FilledButton {
                        text: Tr.flash-btn;
                        clicked => { root.flash(); }
                    }
                }
            }
        }
    }
}
