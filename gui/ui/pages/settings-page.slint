import { MaterialPalette, Switch, TextButton } from "@material";
import { Tr } from "../globals/tr.slint";
import { StatusColors } from "../globals/status-colors.slint";
import { Section, FieldRow, Segmented } from "../components/wizard.slint";

export component SettingsPage inherits VerticalLayout {
    in property <bool> is-dark;
    in property <int> scheme;
    in property <bool> translucent;
    in property <float> ui-scale;
    in property <string> lang;
    in property <string> output-dir;
    // e.g. "3 · 18.4 GB", empty when nothing is cached
    in property <string> cache-summary;
    // e.g. "RMX3709 — Snapdragon", empty when nothing is remembered
    in property <string> chips-summary;
    in property <bool> classic-ui;
    in property <bool> sound;
    in property <bool> rebuild-super;
    in property <bool> modem-bootloader;
    in property <bool> delete-picked-zip;
    callback set-dark(bool);
    callback set-scheme(int);
    callback set-translucent(bool);
    callback set-scale(float);
    callback set-lang(string);
    callback browse-output-dir();
    callback clear-cache();
    callback forget-chips();
    callback set-classic(bool);
    callback set-sound(bool);
    callback set-rebuild-super(bool);
    callback set-modem-bootloader(bool);
    callback set-delete-picked-zip(bool);

    // Each scheme's dark-mode primary, as in the classic top bar.
    property <[color]> swatches: [#66B2FF, #ADC6FF, #00C7BF, #7EC16D, #E39C40, #F68792, #BA98F6];
    property <[float]> scales: [0.85, 1.0, 1.25, 1.5];
    property <[string]> langs: ["en", "ru", "zh-CN", "zh-TW"];

    Flickable {
        vertical-stretch: 1;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            spacing: 14px;
            Text {
                text: Tr.t("Settings", "Настройки", "设置", "設定");
                font-size: 26px;
                font-weight: 600;
                color: MaterialPalette.on-surface;
            }

            Section {
                title: Tr.t("Appearance", "Внешний вид", "外观", "外觀");
                FieldRow {
                    label: Tr.t("Theme", "Тема", "主题", "主題");
                    Segmented {
                        segment-width: 96px;
                        y: (parent.height - self.height) / 2;
                        items: [
                            Tr.t("Dark", "Тёмная", "深色", "深色"),
                            Tr.t("Light", "Светлая", "浅色", "淺色")
                        ];
                        current: root.is-dark ? 0 : 1;
                        selected(i) => {
                            root.set-dark(i == 0);
                        }
                    }
                }

                FieldRow {
                    label: Tr.t("Colour", "Цвет", "颜色", "顏色");
                    for c[i] in root.swatches: TouchArea {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.set-scheme(i);
                        }
                        Rectangle {
                            border-radius: 14px;
                            background: c;
                            border-width: i == root.scheme ? 3px : 0px;
                            border-color: MaterialPalette.on-surface;
                        }
                    }
                }

                FieldRow {
                    label: Tr.t("Translucent window", "Прозрачное окно", "半透明窗口", "半透明視窗");
                    Switch {
                        // Its own size: the row would stretch it into a circle.
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        checked: root.translucent;
                        checked-state-changed(c) => {
                            root.set-translucent(c);
                        }
                    }
                }

                FieldRow {
                    label: Tr.t("Size", "Размер", "大小", "大小");
                    Segmented {
                        y: (parent.height - self.height) / 2;
                        items: ["S", "M", "L", "XL"];
                        current: root.ui-scale < 0.9 ? 0 : root.ui-scale < 1.1 ? 1 : root.ui-scale < 1.4 ? 2 : 3;
                        selected(i) => {
                            root.set-scale(root.scales[i]);
                        }
                    }
                }
            }

            Section {
                title: Tr.t("Language", "Язык", "语言", "語言");
                FieldRow {
                    label: Tr.t("Interface language", "Язык интерфейса", "界面语言", "介面語言");
                    Segmented {
                        segment-width: 92px;
                        y: (parent.height - self.height) / 2;
                        items: ["English", "Русский", "简体", "繁體"];
                        current: root.lang == "ru" ? 1 : root.lang == "zh-CN" ? 2 : root.lang == "zh-TW" ? 3 : 0;
                        selected(i) => {
                            root.set-lang(root.langs[i]);
                        }
                    }
                }
            }

            Section {
                title: Tr.t("Firmware", "Прошивки", "固件", "韌體");
                FieldRow {
                    label: Tr.t("Download folder", "Папка для загрузок", "下载文件夹", "下載資料夾");
                    Text {
                        text: root.output-dir;
                        font-family: "monospace";
                        font-size: 13px;
                        color: MaterialPalette.on-surface;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 330px;
                    }

                    TextButton {
                        text: Tr.t("Change", "Изменить", "更改", "變更");
                        clicked => {
                            root.browse-output-dir();
                        }
                    }
                }

                FieldRow {
                    label: Tr.t("Unpacked firmware", "Распакованные прошивки", "已解压的固件", "已解壓的韌體");
                    Text {
                        text: root.cache-summary == "" ? Tr.t("none", "нет", "无", "無") : root.cache-summary;
                        font-size: 13px;
                        color: MaterialPalette.on-surface;
                        vertical-alignment: center;
                    }

                    if root.cache-summary != "": TextButton {
                        text: Tr.t("Clear", "Очистить", "清除", "清除");
                        clicked => {
                            root.clear-cache();
                        }
                    }
                }

                FieldRow {
                    label: Tr.t("Delete picked .zip", "Удалять выбранный .zip", "删除所选 .zip", "刪除所選 .zip");
                    Switch {
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        checked: root.delete-picked-zip;
                        checked-state-changed(c) => {
                            root.set-delete-picked-zip(c);
                        }
                    }

                    Text {
                        text: Tr.t("after unpacking", "после распаковки", "解压后", "解壓後");
                        font-size: 13px;
                        color: MaterialPalette.on-surface-variant;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Tr.t(
                        "Archives the app downloaded itself are always deleted once unpacked. This switch also deletes a .zip you picked yourself.",
                        "Архивы, скачанные самой программой, удаляются после распаковки всегда. Этот переключатель удаляет и .zip, выбранный вручную.",
                        "应用自己下载的压缩包在解压后总会被删除。此开关还会删除您手动选择的 .zip。",
                        "應用程式自己下載的壓縮檔在解壓後一律會被刪除。此開關還會刪除您手動選擇的 .zip。");
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }

                FieldRow {
                    label: Tr.t("Modem via bootloader", "Modem через bootloader", "modem 经由 bootloader", "modem 經由 bootloader");
                    Switch {
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        checked: root.modem-bootloader;
                        checked-state-changed(c) => {
                            root.set-modem-bootloader(c);
                        }
                    }

                    Text {
                        text: Tr.t("not recommended", "не рекомендуется", "不推荐", "不建議");
                        font-size: 13px;
                        color: StatusColors.warning;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Tr.t(
                        "Snapdragon only. By default everything is flashed in fastbootd: the phone switches to the other slot, and the modem and the system go there. This switch brings back the old way, with a restart into the bootloader for the modem — some phones cannot reach it, and the install stops halfway, up to a brick.",
                        "Только для Snapdragon. По умолчанию всё прошивается в fastbootd: смартфон переключается на другой слот, и modem с системой ставятся туда. Этот переключатель возвращает старый способ с перезагрузкой в bootloader ради modem — на некоторых смартфонах он недоступен, и установка обрывается на полпути, вплоть до «кирпича».",
                        "仅限骁龙。默认全部在 fastbootd 中刷写：手机切换到另一个槽位，modem 和系统都安装到那里。此开关恢复旧方式，为刷写 modem 重启到 bootloader——部分手机无法进入，安装会中途停止，甚至变砖。",
                        "僅限 Snapdragon。預設全部在 fastbootd 中刷寫：手機切換到另一個槽位，modem 和系統都安裝到那裡。此開關恢復舊方式，為刷寫 modem 重新啟動到 bootloader——部分手機無法進入，安裝會中途停止，甚至變磚。");
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }

                FieldRow {
                    label: Tr.t("Remembered processors", "Запомненные процессоры", "已记住的处理器", "已記住的處理器");
                    Text {
                        text: root.chips-summary == "" ? Tr.t("none", "нет", "无", "無") : root.chips-summary;
                        font-size: 13px;
                        color: MaterialPalette.on-surface;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 330px;
                    }

                    if root.chips-summary != "": TextButton {
                        text: Tr.t("Forget", "Забыть", "清除", "清除");
                        clicked => {
                            root.forget-chips();
                        }
                    }
                }
            }

            Section {
                title: Tr.t("Experimental", "Экспериментальное", "实验性", "實驗性");
                FieldRow {
                    label: Tr.t("Rebuild super", "Пересоздавать super", "重建 super", "重建 super");
                    Switch {
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        checked: root.rebuild-super;
                        checked-state-changed(c) => {
                            root.set-rebuild-super(c);
                        }
                    }
                }

                Text {
                    text: Tr.t(
                        "Before flashing, replaces the layout of super with the one the firmware describes: partition groups and read-only partitions, as from the factory. Fixes OTAs failing after flashing with older versions. Untested on many devices — at your own risk. Works only with a .zip firmware.",
                        "Перед прошивкой заменяет разметку super на ту, что описана в прошивке: группы разделов и разделы только для чтения, как с завода. Чинит OTA, которые падают после прошивки старыми версиями. Проверено не на многих устройствах — на ваш страх и риск. Работает только с прошивкой .zip.",
                        "刷写前将 super 的分区布局替换为固件描述的布局：分区组和只读分区，与出厂一致。可修复使用旧版本刷写后 OTA 失败的问题。尚未在多数设备上测试——风险自负。仅适用于 .zip 固件。",
                        "刷寫前將 super 的分割區配置替換為韌體描述的配置：分割區群組和唯讀分割區，與出廠一致。可修復使用舊版本刷寫後 OTA 失敗的問題。尚未在多數裝置上測試——風險自負。僅適用於 .zip 韌體。");
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
            }

            Section {
                title: Tr.t("Interface", "Интерфейс", "界面", "介面");
                FieldRow {
                    label: Tr.t("Sound notifications", "Звуковые уведомления", "声音通知", "聲音通知");
                    Switch {
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        checked: root.sound;
                        checked-state-changed(c) => {
                            root.set-sound(c);
                        }
                    }

                    Text {
                        text: Tr.t("when an install ends", "когда установка закончилась", "安装结束时", "安裝結束時");
                        font-size: 13px;
                        color: MaterialPalette.on-surface-variant;
                        vertical-alignment: center;
                    }
                }

                FieldRow {
                    label: Tr.t("Classic interface", "Классический интерфейс", "经典界面", "經典介面");
                    Switch {
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        checked: root.classic-ui;
                        checked-state-changed(c) => {
                            root.set-classic(c);
                        }
                    }

                    Text {
                        text: Tr.t("the pages of version 2.9", "страницы версии 2.9", "2.9 版的页面", "2.9 版的頁面");
                        font-size: 13px;
                        color: MaterialPalette.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
