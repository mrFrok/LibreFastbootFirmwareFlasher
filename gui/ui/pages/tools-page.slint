import { MaterialPalette, FilledButton } from "@material";
import { Notice } from "../components/wizard.slint";
import { Tools } from "../globals/tools.slint";
export { Tools }
import { LogEntry } from "../structs.slint";
import { LogView } from "../components/log-view.slint";
import { Segmented } from "../components/wizard.slint";
import { Tr } from "../globals/tr.slint";

component ToolCard inherits TouchArea {
    in property <int> id;
    in property <bool> pinned;
    callback toggle-pin();
    min-height: 84px;
    Rectangle {
        border-radius: 16px;
        background: root.has-hover ? MaterialPalette.surface-container-high : MaterialPalette.surface-container;
        border-width: 1px;
        border-color: MaterialPalette.outline-variant;
        Rectangle {
            x: 14px;
            y: 14px;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: MaterialPalette.secondary-container;
            Image {
                source: Tools.icon(root.id);
                width: 22px;
                height: 22px;
                colorize: MaterialPalette.on-secondary-container;
            }
        }

        // Icon placed by hand: a wrapping Text in a HorizontalLayout reports
        // a one-line height.
        VerticalLayout {
            padding: 14px;
            padding-left: 68px;
            padding-right: 48px;
            alignment: center;
            spacing: 3px;
            Text {
                text: Tools.title(root.id);
                font-size: 15px;
                font-weight: 500;
                color: MaterialPalette.on-surface;
            }

            Text {
                text: Tools.text(root.id);
                font-size: 13px;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
            }
        }

        // Pin to the sidebar; filled when pinned. After the text so it takes
        // the click before the card does.
        pin := TouchArea {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: 36px;
            height: 36px;
            clicked => {
                root.toggle-pin();
            }
            Rectangle {
                border-radius: 18px;
                background: root.pinned ? MaterialPalette.primary-container
                    : pin.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : transparent;
                Image {
                    source: root.pinned ? @image-url("../icons/pin-filled.svg") : @image-url("../icons/pin.svg");
                    width: 18px;
                    height: 18px;
                    colorize: root.pinned ? MaterialPalette.on-primary-container : MaterialPalette.on-surface-variant;
                }
            }
        }
    }
}

export component ToolsGrid inherits VerticalLayout {
    // One flag per tool id, index id - 1.
    in property <[bool]> pinned;
    callback open(int);
    callback toggle-pin(int);
    spacing: 16px;
    VerticalLayout {
        spacing: 4px;
        Text {
            text: Tr.t("Tools", "Инструменты", "工具", "工具");
            font-size: 26px;
            font-weight: 600;
            color: MaterialPalette.on-surface;
        }

        Text {
            text: Tr.t("For experienced users. To simply install firmware, use “Install firmware”. The pin keeps a tool in the sidebar.", "Для опытных пользователей. Чтобы просто установить прошивку — «Установка прошивки». Булавка закрепляет инструмент в боковом меню.", "面向有经验的用户。只想安装固件请使用“安装固件”。图钉可将工具固定在侧边栏。", "適合有經驗的使用者。只想安裝韌體請使用「安裝韌體」。圖釘可將工具釘選在側邊欄。");
            font-size: 14px;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }
    }

    GridLayout {
        spacing: 12px;
        Row {
            ToolCard {
                id: 1;
                pinned: root.pinned[0];
                clicked => {
                    root.open(1);
                }
                toggle-pin => {
                    root.toggle-pin(1);
                }
            }

            ToolCard {
                id: 2;
                pinned: root.pinned[1];
                clicked => {
                    root.open(2);
                }
                toggle-pin => {
                    root.toggle-pin(2);
                }
            }
        }

        Row {
            ToolCard {
                id: 3;
                pinned: root.pinned[2];
                clicked => {
                    root.open(3);
                }
                toggle-pin => {
                    root.toggle-pin(3);
                }
            }

            ToolCard {
                id: 4;
                pinned: root.pinned[3];
                clicked => {
                    root.open(4);
                }
                toggle-pin => {
                    root.toggle-pin(4);
                }
            }
        }

        Row {
            ToolCard {
                id: 5;
                pinned: root.pinned[4];
                clicked => {
                    root.open(5);
                }
                toggle-pin => {
                    root.toggle-pin(5);
                }
            }

            ToolCard {
                id: 6;
                pinned: root.pinned[5];
                clicked => {
                    root.open(6);
                }
                toggle-pin => {
                    root.toggle-pin(6);
                }
            }
        }

        Row {
            ToolCard {
                id: 7;
                pinned: root.pinned[6];
                clicked => {
                    root.open(7);
                }
                toggle-pin => {
                    root.toggle-pin(7);
                }
            }

            ToolCard {
                id: 8;
                pinned: root.pinned[7];
                clicked => {
                    root.open(8);
                }
                toggle-pin => {
                    root.toggle-pin(8);
                }
            }
        }

        Row {
            ToolCard {
                id: 9;
                pinned: root.pinned[8];
                clicked => {
                    root.open(9);
                }
                toggle-pin => {
                    root.toggle-pin(9);
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}

// Every log in one place: the classic pages keep one each.
export component LogsPage inherits VerticalLayout {
    in property <[LogEntry]> device-log;
    in property <[LogEntry]> download-log;
    in property <[LogEntry]> flash-log;
    in property <[LogEntry]> partition-log;
    in property <string> export-status;
    callback export(int);
    property <int> tab: 2;
    spacing: 12px;
    Text {
        text: Tools.title(8);
        font-size: 26px;
        font-weight: 600;
        color: MaterialPalette.on-surface;
    }

    HorizontalLayout {
        alignment: start;
        Segmented {
            segment-width: 150px;
            items: [
                Tr.t("Phone", "Смартфон", "手机", "手機"),
                Tr.t("Download", "Загрузка", "下载", "下載"),
                Tr.t("Install", "Установка", "安装", "安裝"),
                Tr.t("Partition", "Раздел", "分区", "分割區"),
            ];
            current: root.tab;
            selected(i) => {
                root.tab = i;
            }
        }
    }

    LogView {
        vertical-stretch: 1;
        entries: root.tab == 0 ? root.device-log : root.tab == 1 ? root.download-log : root.tab == 2 ? root.flash-log : root.partition-log;
        export-status: root.export-status;
        export-log => {
            root.export(root.tab);
        }
    }
}

// Deletes the inactive slot's partitions so the next system update installs.
export component RepairPage inherits VerticalLayout {
    // 0 not run, 1 running, 2 done, 3 failed
    in property <int> state;
    in property <int> count;
    in property <string> error;
    callback run();
    spacing: 14px;
    Text {
        text: Tools.title(9);
        font-size: 26px;
        font-weight: 600;
        color: MaterialPalette.on-surface;
    }

    Text {
        text: Tr.t(
            "Older versions of LibreFastbootFirmwareFlasher left the inactive slot's partitions in the wrong group, so system updates stop with an error. This removes them — they are empty — and restarts the phone. Nothing on the active slot changes and no root is needed.\n\nEach update moves the phone to the other slot: run this once before each of the next two updates, and both slots are fixed for good.",
            "Старые версии LibreFastbootFirmwareFlasher оставляли разделы неактивного слота в неправильной группе, и обновления системы падают с ошибкой. Этот инструмент удаляет их (они пустые) и перезагружает смартфон. Активный слот не меняется, root не нужен.\n\nКаждое обновление переключает смартфон на другой слот: запустите починку перед каждым из двух следующих обновлений — и оба слота будут исправлены навсегда.",
            "旧版 LibreFastbootFirmwareFlasher 会把非活动槽位的分区留在错误的分组中，导致系统更新失败。此工具会删除这些分区（它们是空的）并重启手机。活动槽位不受影响，无需 root。\n\n每次更新都会切换槽位：在接下来的两次更新前各运行一次，两个槽位就会永久修复。",
            "舊版 LibreFastbootFirmwareFlasher 會把非使用中槽位的分割區留在錯誤的群組中，導致系統更新失敗。此工具會刪除這些分割區（它們是空的）並重新啟動手機。使用中槽位不受影響，無需 root。\n\n每次更新都會切換槽位：在接下來的兩次更新前各執行一次，兩個槽位就會永久修復。");
        font-size: 14px;
        color: MaterialPalette.on-surface;
        wrap: word-wrap;
    }

    if root.state == 2: Notice {
        kind: 3;
        icon: @image-url("../icons/check.svg");
        title: Tr.t("Done — install the update now", "Готово — теперь установите обновление", "完成——现在安装更新", "完成——現在安裝更新");
        text: Tr.t("Entries removed: ", "Удалено записей: ", "已删除条目：", "已刪除項目：") + root.count + Tr.t(". The phone is restarting. After the update, run the repair once more before the next one.", ". Смартфон перезагружается. После обновления запустите починку ещё раз перед следующим.", "。手机正在重启。更新后，请在下一次更新前再运行一次修复。", "。手機正在重新啟動。更新後，請在下一次更新前再執行一次修復。");
    }
    if root.state == 3: Notice {
        kind: 2;
        title: Tr.t("The repair stopped", "Починка остановлена", "修复已停止", "修復已停止");
        text: root.error;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 12px;
        FilledButton {
            enabled: root.state != 1;
            icon: @image-url("../icons/restart.svg");
            text: root.state == 1 ? Tr.t("Repairing…", "Чиню…", "正在修复…", "正在修復…") : Tr.t("Repair", "Починить", "修复", "修復");
            clicked => {
                root.run();
            }
        }

        if root.state == 1: Text {
            text: Tr.t("The phone restarts into flashing mode and back", "Смартфон перезагрузится в режим прошивки и обратно", "手机将重启进入刷机模式再返回", "手機將重新啟動進入刷機模式再返回");
            font-size: 13px;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}
