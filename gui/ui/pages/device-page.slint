import {
    ActionChip,
    FilledButton,
    HorizontalDivider,
    MaterialPalette,
    OutlineButton,
    TonalButton,
} from "@material";
import { Typography } from "../globals/typography.slint";
import { Tr } from "../globals/tr.slint";
import { DeviceInfo, LogEntry } from "../structs.slint";
import { DeviceBanner } from "../components/buttons.slint";
import { LogView } from "../components/log-view.slint";
import { StatusColors } from "../globals/status-colors.slint";

export component DevicePage {
    in property <DeviceInfo> device;
    in property <int> test-step: 0;
    in property <string> test-status: "";
    in property <[LogEntry]> device-log: [];
    in property <string> device-export-status: "";
    // 0 the whole page (classic interface); from Tools, one part of it:
    // 1 restart into a mode, 2 slot A/B, 3 connection test, 4 programs
    in property <int> section: 0;
    in property <string> title: Tr.nav-device;

    callback check-device();
    callback check-deps();
    callback install-deps();
    callback run-driver-test();
    callback reboot-to(string);
    callback set-active-slot(string);
    callback export-device-log();
    callback get-device-info();

    VerticalLayout {
        spacing: 0px;

        Text {
            text: root.title;
            font-size: 20px;
            font-weight: 700;
            color: MaterialPalette.on-surface;
        }

        Rectangle {
            height: 12px;
        }

        DeviceBanner {
            device: root.device;
        }

        Rectangle {
            height: 8px;
        }

        if (root.section == 0 || root.section == 2) && root.device.connected: Rectangle {
            background: MaterialPalette.error-container;
            border-radius: 12px;
            border-width: 1px;
            border-color: MaterialPalette.error;
            VerticalLayout {
                spacing: 8px;
                padding: 12px;
                Text {
                    text: Tr.slot-switch-warn;
                    font-size: 13px;
                    color: MaterialPalette.on-error-container;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    FilledButton {
                        text: Tr.slot-switch-btn + "A";
                        enabled: root.device.is-fastboot-mode && root.device.slot != "a";
                        clicked => { root.set-active-slot("a"); }
                    }

                    FilledButton {
                        text: Tr.slot-switch-btn + "B";
                        enabled: root.device.is-fastboot-mode && root.device.slot != "b";
                        clicked => { root.set-active-slot("b"); }
                    }
                }
            }
        }

        if root.section == 2 && !root.device.connected: Text {
            text: Tr.t("Connect the phone in bootloader mode to switch the slot.", "Подключите телефон в режиме загрузчика, чтобы переключить слот.", "请以 bootloader 模式连接手机以切换槽位。", "請以 bootloader 模式連接手機以切換槽位。");
            font-size: 14px;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }

        if root.section == 0 || root.section == 2: Rectangle {
            height: 8px;
        }

        if root.section == 0 || root.section == 4: HorizontalLayout {
            spacing: 8px;
            OutlineButton {
                text: Tr.find-device;
                horizontal-stretch: 1;
                clicked => { root.check-device(); }
            }

            OutlineButton {
                text: Tr.check-deps;
                horizontal-stretch: 1;
                clicked => { root.check-deps(); }
            }

            FilledButton {
                text: Tr.install-deps;
                horizontal-stretch: 1;
                clicked => { root.install-deps(); }
            }
        }

        if root.section == 0 || root.section == 4: Rectangle {
            height: 12px;
        }

        if root.section == 0: HorizontalDivider { }

        if root.section == 0 || root.section == 3: Rectangle {
            height: 8px;
        }

        if root.section == 0 || root.section == 3: HorizontalLayout {
            spacing: 8px;
            height: 32px;
            Text {
                text: Tr.driver-test;
                font-size: 15px;
                font-weight: 500;
                color: MaterialPalette.on-surface;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            TonalButton {
                text: Tr.run-test;
                enabled: root.test-step == 0 || root.test-step >= 5 || root.test-step < 0;
                clicked => { root.run-driver-test(); }
            }
        }

        if root.section == 0 || root.section == 3: Rectangle {
            height: 4px;
        }

        if root.section == 0 || root.section == 3: HorizontalLayout {
            spacing: 16px;
            height: 24px;
            for s in [
                { label: "ADB", n: 2 },
                { label: "Bootloader", n: 3 },
                { label: "Fastbootd", n: 4 },
                { label: "Done", n: 5 },
            ]: HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.test-step >= s.n
                        ? StatusColors.success
                        : root.test-step < 0 ? MaterialPalette.error
                        : MaterialPalette.outline-variant;
                    animate background {
                        duration: 100ms;
                        easing: cubic-bezier(0.2, 0.0, 0, 1.0);
                    }
                    y: (parent.height - 10px) / 2;
                }

                Text {
                    text: s.label;
                    font-size: 14px;
                    color: root.test-step >= s.n
                        ? StatusColors.success
                        : MaterialPalette.on-surface-variant;
                    vertical-alignment: center;
                    animate color { duration: 200ms; }
                }
            }
        }

        if root.section == 0 || root.section == 3: Rectangle {
            height: 4px;
            visible: root.test-status != "";
        }

        if root.section == 0 || root.section == 3: Text {
            visible: root.test-status != "";
            opacity: root.test-status != "" ? 1.0 : 0.0;
            text: root.test-status;
            font-size: 14px;
            color: root.test-step < 0 ? MaterialPalette.error : MaterialPalette.primary;
            animate color { duration: 200ms; }
            animate opacity {
                duration: 100ms;
                easing: cubic-bezier(0.2, 0.0, 0, 1.0);
            }
        }

        if root.section == 0 || root.section == 3: Rectangle {
            height: 12px;
        }

        if root.section == 0: HorizontalDivider { }

        if root.section == 0 || root.section == 1: Rectangle {
            height: 8px;
        }

        if root.section == 0 || root.section == 1: HorizontalLayout {
            spacing: 8px;
            height: 32px;
            Text {
                text: Tr.reboot-title;
                font-size: 15px;
                font-weight: 500;
                color: MaterialPalette.on-surface;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        if root.section == 0 || root.section == 1: Rectangle {
            height: 8px;
        }

        if root.section == 0 || root.section == 1: Text {
            text: "ADB";
            font-size: Typography.label-medium-size;
            color: MaterialPalette.on-surface-variant;
            min-height: 14px;
        }

        if root.section == 0 || root.section == 1: Rectangle {
            height: 4px;
        }

        if root.section == 0 || root.section == 1: HorizontalLayout {
            spacing: 8px;
            for item in [
                { label: Tr.reboot-recovery, target: "adb-recovery" },
                { label: Tr.reboot-bootloader, target: "adb-bootloader" },
                { label: Tr.reboot-fastbootd, target: "adb-fastboot" },
                { label: Tr.reboot-system, target: "adb-reboot" },
            ]: ActionChip {
                horizontal-stretch: 1;
                text: item.label;
                clicked => { root.reboot-to(item.target); }
            }
        }

        if root.section == 0 || root.section == 1: Rectangle {
            height: 12px;
        }

        if root.section == 0 || root.section == 1: Text {
            text: "Fastboot";
            font-size: Typography.label-medium-size;
            color: MaterialPalette.on-surface-variant;
            min-height: 14px;
        }

        if root.section == 0 || root.section == 1: Rectangle {
            height: 4px;
        }

        if root.section == 0 || root.section == 1: HorizontalLayout {
            spacing: 8px;
            for item in [
                { label: Tr.reboot-recovery, target: "fb-recovery" },
                { label: Tr.reboot-bootloader, target: "fb-bootloader" },
                { label: Tr.reboot-fastbootd, target: "fb-fastboot" },
                { label: Tr.reboot-system, target: "fb-reboot" },
            ]: ActionChip {
                horizontal-stretch: 1;
                text: item.label;
                clicked => { root.reboot-to(item.target); }
            }
        }

        LogView {
            entries: root.device-log;
            vertical-stretch: 1;
            export-status: root.device-export-status;
            export-log => { root.export-device-log(); }
        }
    }
}
