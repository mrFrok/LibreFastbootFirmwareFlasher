import { Palette, ScrollView } from "std-widgets.slint";
import { MaterialPalette } from "../globals/material-palette.slint";
import { HorizontalDivider } from "../components/buttons.slint";
import { FlashHistoryItem } from "../structs.slint";

export component HistoryPage {
    in property <string> lang;
    in property <[FlashHistoryItem]> history-items: [];

    VerticalLayout { spacing: 0px; vertical-stretch: 1;
        Text {
            text: root.lang == "ru" ? "История прошивок" : "Flash History";
            font-size: 20px; font-weight: 700;
            color: MaterialPalette.on-surface;
        }
        Rectangle { height: 12px; }

        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline-variant;
            background: MaterialPalette.surface-container-low;
            clip: true;

            VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                Rectangle {
                    height: 40px;
                    background: Palette.color-scheme == ColorScheme.dark
                        ? MaterialPalette.surface-container-highest
                        : MaterialPalette.surface-container-high;
                    HorizontalLayout { spacing: 8px; padding-left: 16px; padding-right: 16px;
                        Rectangle { width: 145px;
                            Text { text: root.lang == "ru" ? "Дата" : "Date"; font-size: 12px; font-weight: 700; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: left; overflow: elide; width: 100%; }
                        }
                        Rectangle { horizontal-stretch: 2;
                            Text { text: root.lang == "ru" ? "Прошивка" : "Firmware"; font-size: 12px; font-weight: 700; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: left; overflow: elide; width: 100%; }
                        }
                        Rectangle { width: 130px;
                            Text { text: root.lang == "ru" ? "Устройство" : "Device"; font-size: 12px; font-weight: 700; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: left; overflow: elide; width: 100%; }
                        }
                        Rectangle { width: 80px;
                            Text { text: root.lang == "ru" ? "Результат" : "Result"; font-size: 12px; font-weight: 700; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: center; overflow: elide; width: 100%; }
                        }
                        Rectangle { width: 70px;
                            Text { text: root.lang == "ru" ? "Время" : "Duration"; font-size: 12px; font-weight: 700; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; overflow: elide; width: 100%; }
                        }
                    }
                }

                HorizontalDivider { }

                if history-items.length == 0: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout { alignment: center; spacing: 8px;
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: "🕘";
                            font-size: 32px;
                            color: MaterialPalette.on-surface-variant;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.lang == "ru" ? "История пуста" : "No flash history yet";
                            color: MaterialPalette.on-surface-variant;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    VerticalLayout { spacing: 0px; horizontal-stretch: 1;
                        for item[index] in history-items: row-ta := TouchArea {
                            height: 44px;
                            horizontal-stretch: 1;
                            Rectangle {
                                width: 100%; height: 100%;
                                background: Math.mod(index, 2) == 0
                                    ? transparent
                                    : MaterialPalette.on-surface.with-alpha(0.03);
                                animate background { duration: 150ms; }

                                Rectangle {
                                    width: 100%; height: 100%;
                                    background: row-ta.has-hover
                                        ? MaterialPalette.on-surface.with-alpha(0.06)
                                        : transparent;
                                    animate background { duration: 150ms; }
                                }

                                HorizontalLayout { spacing: 8px; padding-left: 16px; padding-right: 16px;
                                    Rectangle { width: 145px;
                                        Text { text: item.timestamp; font-size: 12px; font-family: "monospace"; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: left; overflow: elide; width: 100%; }
                                    }
                                    Rectangle { horizontal-stretch: 2;
                                        Text { text: item.firmware; font-size: 12px; color: MaterialPalette.on-surface; vertical-alignment: center; horizontal-alignment: left; overflow: elide; width: 100%; }
                                    }
                                    Rectangle { width: 130px;
                                        Text { text: item.device; font-size: 12px; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: left; overflow: elide; width: 100%; }
                                    }
                                    Rectangle { width: 80px;
                                        Rectangle {
                                            x: (parent.width - 64px) / 2;
                                            y: (parent.height - 22px) / 2;
                                            width: 64px; height: 22px; border-radius: 6px;
                                            background: item.result == "OK" ? MaterialPalette.success-container
                                                      : item.result == "Aborted" ? MaterialPalette.warning-container
                                                      : MaterialPalette.error-container;
                                            border-width: 1px;
                                            border-color: item.result == "OK" ? MaterialPalette.success.with-alpha(0.3)
                                                      : item.result == "Aborted" ? MaterialPalette.warning.with-alpha(0.3)
                                                      : MaterialPalette.error.with-alpha(0.3);
                                            Text {
                                                text: item.result;
                                                font-size: 10px; font-weight: 700; font-family: "monospace";
                                                horizontal-alignment: center; vertical-alignment: center;
                                                color: item.result == "OK" ? MaterialPalette.on-success-container
                                                     : item.result == "Aborted" ? MaterialPalette.on-warning-container
                                                     : MaterialPalette.on-error-container;
                                            }
                                        }
                                    }
                                    Rectangle { width: 70px;
                                        Text { text: item.duration; font-size: 12px; font-family: "monospace"; color: MaterialPalette.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; overflow: elide; width: 100%; }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px; width: 100%;
                                    background: MaterialPalette.outline-variant.with-alpha(0.5);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
