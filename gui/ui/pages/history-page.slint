import { Palette, ScrollView } from "std-widgets.slint";
import { HorizontalDivider, MaterialPalette } from "@material";
import { FlashHistoryItem } from "../structs.slint";
import { StatusColors } from "../globals/status-colors.slint";

export component HistoryPage {
    in property <string> lang;
    in property <[FlashHistoryItem]> history-items: [];
    private property <string> status-ok: root.lang == "ru" ? "Успех"
        : root.lang == "zh-CN" ? "成功"
        : root.lang == "zh-TW" ? "成功"
        : "OK";
    private property <string> status-aborted: root.lang == "ru" ? "Прервано"
        : root.lang == "zh-CN" ? "已中止"
        : root.lang == "zh-TW" ? "已中止"
        : "Aborted";
    private property <string> status-failed: root.lang == "ru" ? "Ошибка"
        : root.lang == "zh-CN" ? "失败"
        : root.lang == "zh-TW" ? "失敗"
        : "Failed";

    VerticalLayout {
        spacing: 0px;
        vertical-stretch: 1;
        Text {
            text: root.lang == "ru" ? "История прошивок"
                : root.lang == "zh-CN" ? "刷写历史"
                : root.lang == "zh-TW" ? "刷寫歷史"
                : "Flash History";
            font-size: 20px;
            font-weight: 700;
            color: MaterialPalette.on-surface;
        }

        Rectangle {
            height: 12px;
        }

        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline-variant;
            background: MaterialPalette.surface-container-low;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                // ── Header row ──
                Rectangle {
                    height: 40px;
                    background: Palette.color-scheme == ColorScheme.dark
                        ? MaterialPalette.surface-container-highest
                        : MaterialPalette.surface-container-high;
                    HorizontalLayout {
                        spacing: 0px;
                        padding-left: 16px;
                        padding-right: 16px;
                        Rectangle {
                            width: 150px;
                            Text {
                                text: root.lang == "ru"
                                    ? "Дата" : root.lang == "zh-CN"
                                    ? "日期" : root.lang == "zh-TW"
                                    ? "日期" : "Date";
                                font-size: 12px;
                                font-weight: 700;
                                color: MaterialPalette.on-surface-variant;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            Text {
                                text: root.lang == "ru"
                                    ? "Прошивка" : root.lang == "zh-CN"
                                    ? "固件" : root.lang == "zh-TW"
                                    ? "韌體" : "Firmware";
                                font-size: 12px;
                                font-weight: 700;
                                color: MaterialPalette.on-surface-variant;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 130px;
                            Text {
                                text: root.lang == "ru"
                                    ? "Устройство" : root.lang == "zh-CN"
                                    ? "设备" : root.lang == "zh-TW"
                                    ? "裝置" : "Device";
                                font-size: 12px;
                                font-weight: 700;
                                color: MaterialPalette.on-surface-variant;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 100px;
                            Text {
                                text: root.lang == "ru"
                                    ? "Результат" : root.lang == "zh-CN"
                                    ? "结果" : root.lang == "zh-TW"
                                    ? "結果" : "Result";
                                font-size: 12px;
                                font-weight: 700;
                                color: MaterialPalette.on-surface-variant;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 75px;
                            Text {
                                text: root.lang == "ru"
                                    ? "Время" : root.lang == "zh-CN"
                                    ? "耗时" : root.lang == "zh-TW"
                                    ? "耗時" : "Duration";
                                font-size: 12px;
                                font-weight: 700;
                                color: MaterialPalette.on-surface-variant;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }
                    }
                }

                HorizontalDivider { }

                if history-items.length == 0: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Rectangle {
                            vertical-stretch: 1;
                        }

                        Text {
                            text: "🕘";
                            font-size: 32px;
                            color: MaterialPalette.on-surface-variant;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.lang == "ru" ? "История пуста"
                                : root.lang == "zh-CN" ? "暂无刷写记录"
                                : root.lang == "zh-TW" ? "暫無刷寫記錄"
                                : "No flash history yet";
                            color: MaterialPalette.on-surface-variant;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;
                        horizontal-stretch: 1;
                        for item[index] in history-items: row-ta := TouchArea {
                            height: 44px;
                            horizontal-stretch: 1;
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Math.mod(index, 2) == 0
                                    ? transparent
                                    : MaterialPalette.on-surface.with-alpha(0.03);
                                animate background { duration: 150ms; }

                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: row-ta.has-hover
                                        ? MaterialPalette.on-surface.with-alpha(0.06)
                                        : transparent;
                                    animate background { duration: 150ms; }
                                }

                                HorizontalLayout {
                                    spacing: 0px;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    Rectangle {
                                        width: 150px;
                                        Text {
                                            text: item.timestamp;
                                            font-size: 12px;
                                            font-family: "monospace";
                                            color: MaterialPalette.on-surface-variant;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Text {
                                            text: item.firmware;
                                            font-size: 12px;
                                            color: MaterialPalette.on-surface;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        width: 130px;
                                        Text {
                                            text: item.device;
                                            font-size: 12px;
                                            color: MaterialPalette.on-surface-variant;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        width: 100px;
                                        Rectangle {
                                            x: (parent.width - 80px) / 2;
                                            y: (parent.height - 22px) / 2;
                                            width: 80px;
                                            height: 22px;
                                            border-radius: 6px;
                                            background: item.result == "OK" ? StatusColors.success-container
                                                : item.result == "Aborted" ? StatusColors.warning-container
                                                : MaterialPalette.error-container;
                                            border-width: 1px;
                                            border-color: item.result == "OK" ? StatusColors.success.with-alpha(0.3)
                                                : item.result == "Aborted" ? StatusColors.warning.with-alpha(0.3)
                                                : MaterialPalette.error.with-alpha(0.3);
                                            Text {
                                                text: item.result == "OK"
                                                    ? root.status-ok
                                                    : item.result == "Aborted"
                                                    ? root.status-aborted
                                                    : root.status-failed;
                                                font-size: 10px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                color: item.result == "OK" ? StatusColors.on-success-container
                                                    : item.result == "Aborted" ? StatusColors.on-warning-container
                                                    : MaterialPalette.on-error-container;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 75px;
                                        Text {
                                            text: item.duration;
                                            font-size: 12px;
                                            font-family: "monospace";
                                            color: MaterialPalette.on-surface-variant;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: 100%;
                                    background: MaterialPalette.outline-variant.with-alpha(0.5);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
