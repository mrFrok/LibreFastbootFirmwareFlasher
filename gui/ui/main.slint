// LibreFastbootFirmwareFlasher — Material Design 3 GUI (Slint built-in material)

import { Palette } from "std-widgets.slint";
import { MaterialPalette, MaterialWindow } from "@material";
import { Tr } from "globals/tr.slint";
import { LfffScheme, AppScheme } from "globals/lfff-scheme.slint";
import { ConfirmAction } from "globals/confirm-action.slint";
import { DeviceInfo, LogEntry, FlashHistoryItem } from "structs.slint";
import { Sidebar } from "components/sidebar.slint";
import { TopBar } from "components/top-bar.slint";

import { HomePage } from "pages/home-page.slint";
import { DevicePage } from "pages/device-page.slint";
import { DownloadPage } from "pages/download-page.slint";
import { FlashPage } from "pages/flash-page.slint";
import { PartitionPage } from "pages/partition-page.slint";
import { HistoryPage } from "pages/history-page.slint";
import { AboutPage } from "pages/about-page.slint";

import { FlashMethodDialog } from "dialogs/flash-method-dialog.slint";
import { FlashAllRebootDialog } from "dialogs/flash-all-reboot-dialog.slint";
import { FlashAllFinalDialog } from "dialogs/flash-all-final-dialog.slint";
import {
    SourceFlashFinalDialog,
} from "dialogs/source-flash-final-dialog.slint";
import { PartitionRebootDialog } from "dialogs/partition-reboot-dialog.slint";
import { PartitionFinalDialog } from "dialogs/partition-final-dialog.slint";
import {
    PostFlashSuccessDialog,
} from "dialogs/post-flash-success-dialog.slint";
import { CableTestDialog } from "dialogs/cable-test-dialog.slint";
import { FlashFailureDialog } from "dialogs/flash-failure-dialog.slint";
import { ArbWarningDialog, ArbState } from "dialogs/arb-warning-dialog.slint";
// Re-exported so the Rust side gets the generated ArbState type.
export { ArbState }
import { PreloaderWarningDialog } from "dialogs/preloader-warning-dialog.slint";
import { UpdateDialog } from "dialogs/update-dialog.slint";
import { WarningDialog } from "dialogs/all.slint";
import { AppNav } from "components/wizard.slint";
import { InstallPage } from "pages/install-page.slint";
import { OtaBuild } from "components/ota-finder.slint";
export { OtaBuild }
import { ToolsGrid, Tools, LogsPage, RepairPage } from "pages/tools-page.slint";
import { SettingsPage } from "pages/settings-page.slint";
import { HomeDash } from "pages/home-dash.slint";
import { ConfirmSheet } from "dialogs/confirm-sheet.slint";
import { StartupNotice } from "dialogs/startup-notice.slint";
import { TextButton } from "@material";
export component MainWindow inherits MaterialWindow {
    // The progress in the title too, so it shows in the taskbar while the
    // user waits elsewhere.
    title: !root.classic-ui && root.install-view == 1 && root.stage2 == 1
        ? Math.round(root.flash-progress * 100) + "% — Libre Fastboot Firmware Flasher"
        : "Libre Fastboot Firmware Flasher";
    icon: @image-url("icons/logo_icon.svg");
    preferred-width: 1000px;
    preferred-height: 660px;
    min-width: 700px;
    min-height: 500px;

    // Pages: 0=Home 1=Device 2=Download 3=Flash 4=Partition 5=History 6=About
    // (the classic pages), 10=Install 11=Tools 12=Settings 13=Logs 14=Home
    // (the new ones).
    // The new interface reaches pages 1-4 through Tools, and shares 5 and 6.
    in-out property <int> page: 14;

    // ── New interface ───────────────────────────────────────────────────────
    in-out property <bool> classic-ui: false;
    changed classic-ui => {
        root.page = root.classic-ui ? 0 : 14;
    }
    in-out property <bool> show-notice: false;
    callback accept-notice();
    callback set-classic(bool);
    // Tool ids pinned to the sidebar (see Tools in pages/tools-page.slint).
    in-out property <[int]> pinned-tools: [];
    // The same as flags by tool id - 1, for the Tools page.
    in-out property <[bool]> pinned-flags: [false, false, false, false, false, false, false, false, false];
    // Tool open from Tools or a pin, 0 for none (see Tools in pages/tools-page.slint).
    in-out property <int> current-tool: 0;
    property <bool> on-tool-page: (root.page >= 1 && root.page <= 4) || root.page == 13 || root.page == 15;
    callback toggle-pin(int);
    in-out property <string> cache-summary;
    in-out property <string> chips-summary;
    callback clear-cache();
    callback forget-chips();
    // Install page
    in-out property <int> install-view: 0;
    in-out property <int> deps-state: 0;
    in-out property <string> deps-missing;
    in-out property <int> fw-state: 0;
    in-out property <string> fw-name;
    in-out property <int> fw-parts: 0;
    in-out property <string> fw-error;
    in-out property <string> fw-dir;
    in-out property <int> unpack-count: 0;
    in-out property <string> unpack-current;
    in-out property <[string]> cached-firmwares: [];
    in-out property <string> fw-wrong-device;
    in-out property <bool> device-unauthorized: false;
    callback cancel-unpack();
    callback quit-app();
    in-out property <bool> repair-running: false;
    in-out property <int> repair-state: 0;
    in-out property <int> repair-count: 0;
    in-out property <string> repair-error;
    callback repair-ota();
    in-out property <bool> sound: true;
    callback set-sound(bool);
    in-out property <bool> rebuild-super: false;
    // The layout a rebuild would write, from the chosen firmware; "" if none.
    in-out property <string> super-plan;
    callback set-rebuild-super(bool);
    callback pick-cached(int);
    // ARB of the chosen firmware: -1 unknown, 0 none, >0 the level
    in-out property <int> fw-arb: -1;
    in-out property <bool> fw-has-preloader: false;
    // Chip remembered for the connected model: 0 none, 1 Snapdragon, 2 MediaTek
    in-out property <int> chip: 0;
    in-out property <int> stage0: 0;
    in-out property <int> stage1: 0;
    in-out property <int> stage2: 0;
    in-out property <string> stage1-detail;
    in-out property <bool> cable-failed: false;
    in-out property <string> cable-detail;
    in-out property <string> result-detail;
    in-out property <bool> untouched: true;
    in-out property <int> install-minutes: 0;
    in-out property <int> install-seconds: 0;
    in-out property <bool> install-wiped: false;
    // Confirm sheet: 0 hidden, otherwise ConfirmSheet.kind + 1
    in-out property <int> sheet: 0;
    in-out property <bool> skip-boot;
    in-out property <bool> skip-init-boot;
    in-out property <bool> skip-recovery;
    in-out property <bool> skip-vendor-boot;
    in-out property <string> skip-other;
    // The partitions chosen on the summary sheet, comma-separated.
    out property <string> install-skips: (root.skip-boot ? "boot," : "") + (root.skip-init-boot ? "init_boot," : "")
        + (root.skip-recovery ? "recovery," : "") + (root.skip-vendor-boot ? "vendor_boot," : "") + root.skip-other;
    callback pick-zip();
    callback pick-folder();
    callback change-firmware();
    callback choose-chip(int);
    callback run-install();
    callback cable-retry();
    callback cable-stop();
    callback install-finish();
    callback install-retry();
    // Tools open the classic pages; the phone page shows one section each.
    function open-tool(id: int) {
        root.current-tool = id;
        root.page = id == 1 ? 4 : id == 2 ? 3 : id == 7 ? 2 : id == 8 ? 13 : id == 9 ? 15 : 1;
    }
    // First sheet for the chosen firmware and chip: the ARB or preloader
    // warning, else straight to the summary.
    pure function first-sheet() -> int {
        return root.chip == 1 ? (root.fw-arb > 0 ? 1 : 2)
            : root.fw-has-preloader ? 3 : 4;
    }
    function open-sheet() {
        root.skip-xbl-abl = false;
        root.skip-preloader = false;
        // Each install starts from flashing everything: a skip chosen last
        // time must not carry over unseen.
        root.skip-boot = false;
        root.skip-init-boot = false;
        root.skip-recovery = false;
        root.skip-vendor-boot = false;
        root.skip-other = "";
        root.sheet = root.first-sheet();
    }
    in-out property <string> lang: "en";
    in-out property <bool> is-dark: true;
    // Index into AppScheme: 0 blue, 1 indigo, 2 teal, 3 green, 4 amber,
    // 5 rose, 6 violet. Translucency is independent of the colour.
    in-out property <int> scheme: 0;
    in-out property <bool> translucent: false;
    in-out property <float> ui-scale: 1.0;
    in-out property <float> pending-scale: 0;

    callback set-scale(float);
    callback apply-pending-scale();
    callback save-lang(string);
    callback save-theme(bool);
    callback save-scheme(int);
    callback save-translucent(bool);

    // One transition for every switch that repaints the whole window: scale,
    // light/dark, language and colour scheme. A circle of the destination
    // colour grows from the control that was clicked until it covers the
    // window; the change is applied underneath, then the circle is hidden.
    //
    // The growth is started from a root-level `changed` handler rather than
    // from the child's callback. That is how the scale transition was already
    // written, and it is the difference that made the first attempts at a theme
    // animation do nothing.
    //
    // kind: 1 scale, 2 light/dark, 3 language, 4 colour scheme
    private property <int> pending-kind: 0;
    private property <bool> pending-dark: true;
    private property <string> pending-lang: "en";
    private property <int> pending-scheme: 0;
    private property <bool> pending-translucent: false;
    in-out property <int> transition-request: 0;

    // Progress rather than a diameter, with visibility as a separate flag: the
    // circle has to snap back to nothing after the swap, and hiding it is
    // instant where animating a length back to zero is not.
    private property <bool> reveal-visible: false;
    private property <float> reveal-p: 0.0;
    private property <length> reveal-cx: 0px;
    private property <length> reveal-cy: 0px;
    private property <length> reveal-max: 2 * Math.sqrt(
        (root.width / 1px) * (root.width / 1px)
        + (root.height / 1px) * (root.height / 1px)) * 1px;
    // Only the scheme switch is tinted, and it uses primaryContainer because
    // every scheme's `background` is the same near-neutral #141416 — a circle
    // painted in that said nothing about the colour being moved to. Light/dark
    // and the rest stay on the background they are heading for: there is no new
    // accent to announce, and tinting them would make the switch shout.
    //
    // Translucent so the sweep reads as tinted glass rather than a slab. At 0.6
    // the swap underneath is faintly visible, which is the trade for seeing the
    // interface through the wash.
    private property <color> reveal-color:
          root.pending-kind == 4
        ? (root.is-dark ? LfffScheme.scheme-of(root.as-scheme(root.pending-scheme)).dark.primaryContainer
        : LfffScheme.scheme-of(root.as-scheme(root.pending-scheme)).light.primaryContainer).with-alpha(0.6)
        : root.pending-kind == 2
        ? (root.pending-dark ? LfffScheme.schemes.dark.background
        : LfffScheme.schemes.light.background).with-alpha(0.6)
        : MaterialPalette.background.with-alpha(0.6);
    animate reveal-p {
        duration: 420ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }

    pure function as-scheme(i: int) -> AppScheme {
        return i == 1 ? AppScheme.indigo
            : i == 2 ? AppScheme.teal
            : i == 3 ? AppScheme.green
            : i == 4 ? AppScheme.amber
            : i == 5 ? AppScheme.rose
            : i == 6 ? AppScheme.violet
            : AppScheme.blue;
    }

    // Each switch grows from roughly its own place in the top bar.
    function start-transition(kind: int, cx: length) {
        root.pending-kind = kind;
        root.reveal-cx = cx;
        root.reveal-cy = 24px;
        root.transition-request += 1;
    }

    changed transition-request => {
        root.reveal-visible = true;
        root.reveal-p = 1.0;
        transition-timer.running = true;
    }

    transition-timer := Timer {
        // Just past the 420ms expansion, so the swap lands under a circle that
        // already covers the window.
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending-kind == 1 { root.apply-pending-scale(); }
            if root.pending-kind == 2 {
                root.is-dark = root.pending-dark;
                root.save-theme(root.is-dark);
            }
            if root.pending-kind == 3 {
                root.lang = root.pending-lang;
                root.save-lang(root.lang);
            }
            if root.pending-kind == 4 {
                root.scheme = root.pending-scheme;
                root.translucent = root.pending-translucent;
                root.save-scheme(root.scheme);
                root.save-translucent(root.translucent);
            }
            root.reveal-visible = false;
            root.reveal-p = 0.0;
        }
    }

    changed pending-scale => {
        if pending-scale > 0 { root.start-transition(1, root.width - 250px); }
    }

    // Page transition
    private property <float> page-opacity: 0.0;
    private property <length> page-x: 0px;

    changed page => {
        page-opacity = 1.0;
        page-x = 30px;
        anim-timer.running = true;
    }

    anim-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.page-opacity = 0.0;
            root.page-x = 0px;
        }
    }

    animate page-opacity {
        duration: 250ms;
        easing: cubic-bezier(0.4, 0.0, 0.2, 1.0);
    }
    animate page-x {
        duration: 350ms;
        easing: spring;
    }

    // State
    in-out property <DeviceInfo> device: {
        connected: false,
        name: "—",
        serial: "—",
        slot: "—",
        is-fastboot-mode: false,
        mode: 0,
        unlocked: -1,
        product: "",
        battery: -1
    };
    in-out property <string> firmware-path;
    in-out property <int> flash-source-mode: 0;
    in-out property <string> source-dir;
    in-out property <int> source-image-count: 0;
    in-out property <int> source-total-ops: 0;
    in-out property <string> single-image-path;
    in-out property <string> partition-name;
    in-out property <bool> is-flashing: false;
    in-out property <float> flash-progress: 0;
    in-out property <string> flash-status;
    in-out property <string> current-partition;
    in-out property <[LogEntry]> device-log: [];
    in-out property <[LogEntry]> download-log: [];
    in-out property <[LogEntry]> flash-log: [];
    in-out property <[LogEntry]> partition-log: [];
    in-out property <[FlashHistoryItem]> history-items: [];
    in-out property <string> flash-export-status: "";
    in-out property <string> partition-export-status: "";
    in-out property <string> device-export-status: "";
    in-out property <string> download-export-status: "";
    in-out property <string> output-dir;
    in-out property <string> download-url;
    // How long that link still works (see update_link_life)
    in property <string> link-life;
    in property <int> link-life-kind;
    // Official firmware search on the install page
    in-out property <string> ota-model;
    in property <int> ota-state;
    in property <int> ota-done;
    in property <int> ota-total;
    in property <[OtaBuild]> ota-builds;
    in property <string> ota-error;
    in-out property <string> dl-speed;
    in-out property <string> dl-eta;
    in-out property <string> dl-downloaded;
    in-out property <string> dl-total;
    in-out property <float> dl-percent: 0;
    in-out property <bool> is-downloading: false;
    in-out property <string> test-status;
    in-out property <int> test-step: 0;
    in-out property <string> skip-partitions;
    in-out property <bool> show-skip-partitions: false;
    in-out property <bool> show-confirm: false;
    // Which confirmation dialog is visible — see the ConfirmAction global
    // (globals/confirm-action.slint) for the value names.
    in-out property <int> confirm-action: 0;
    in-out property <int> reboot-choice: 0;
    // Mandatory flash method: 0 = not chosen, 1 = Snapdragon, 2 = MediaTek.
    // Flashing never starts while this is 0.
    in-out property <int> flash-method: 0;
    // Extracted/validated firmware directory, set by the worker via FlashPrepared.
    in-out property <string> prepared-dir: "";
    in-out property <bool> show-arb-warning: false;
    in-out property <ArbState> arb-warning-state: ArbState.known;
    in-out property <int> arb-warning-version: 0;
    in-out property <bool> skip-xbl-abl: false;
    in-out property <bool> skip-preloader: false;
    in-out property <bool> show-preloader-warning: false;
    in-out property <bool> pending-source-flash: false;
    in-out property <string> app-version: "dev";
    in-out property <bool> show-update-dialog: false;
    in-out property <string> update-version: "";
    // Set once an update is found; the dialog itself can be closed.
    in-out property <bool> update-known: false;
    in-out property <string> update-url: "";
    in-out property <string> update-body: "";
    in-out property <float> cable-test-progress: 0;
    in-out property <string> cable-test-status: "";
    in-out property <bool> cable-test-passed: false;
    in-out property <string> flash-failed-partitions: "";
    in-out property <string> flash-fail-partition: "";
    in-out property <string> flash-fail-slot: "";
    in-out property <string> flash-fail-error: "";
    in-out property <string> fastbootd-fallback-detail: "";

    // LfffScheme must be handed to the library palette here: a global cannot
    // bind another global's `in` property declaratively.
    // The scheme has to be pushed into the library palette by hand: a global
    // cannot bind another global's `in` property declaratively, so every change
    // re-runs this.
    function apply-scheme() {
        LfffScheme.current = root.scheme == 1 ? AppScheme.indigo
            : root.scheme == 2 ? AppScheme.teal
            : root.scheme == 3 ? AppScheme.green
            : root.scheme == 4 ? AppScheme.amber
            : root.scheme == 5 ? AppScheme.rose
            : root.scheme == 6 ? AppScheme.violet
            : AppScheme.blue;
        LfffScheme.translucent = root.translucent;
        MaterialPalette.schemes = LfffScheme.schemes;
    }

    init => {
        Tr.lang = lang;
        root.apply-scheme();
        Palette.color-scheme = is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed scheme => { root.apply-scheme(); }
    changed translucent => { root.apply-scheme(); }
    changed lang => { Tr.lang = lang; }
    changed is-dark => { Palette.color-scheme = is-dark ? ColorScheme.dark : ColorScheme.light; }
    changed confirm-action => {
        if confirm-action == ConfirmAction.cable-test { root.run-cable-test(); }
    }

    callback check-device();
    callback browse-firmware();
    callback browse-folder();
    callback browse-single-image();
    callback browse-source-dir();
    callback start-flash-from-source();
    callback start-flash();
    callback start-single-flash();
    callback cancel-flash();
    callback check-deps();
    callback install-deps();
    callback download-firmware(string);
    callback cancel-download();
    callback find-ota(string);
    callback cancel-ota();
    callback download-ota(int);
    callback load-ota-changes(int);
    callback extract-firmware();
    callback open-url(string);
    callback browse-output-dir();
    callback paste-clipboard();
    callback request-back();
    callback run-driver-test();
    callback get-device-info();
    callback reboot-to(string);
    callback prepare-flash();
    callback retry-flash();
    callback reboot-device();
    callback run-cable-test();
    callback reboot-for-flash();
    callback post-flash-reboot();
    callback post-flash-wipe();
    callback flash-fail-skip();
    callback flash-fail-abort();
    callback flash-fail-retry();
    callback fastbootd-fallback-continue();
    callback fastbootd-fallback-stop();
    callback export-flash-log();
    callback export-partition-log();
    callback export-device-log();
    callback export-download-log();
    callback set-active-slot(string);
    callback check-for-updates();
    callback open-update-url();

    // ── Root layout ───────────────────────────────────────────────────────────
    HorizontalLayout {
        width: 100%;
        height: 100%;

        // ── Sidebar ──────────────────────────────────────────────────────────
        if !root.classic-ui: AppNav {
            page: root.page == 14 ? 5 : root.page == 10 ? 0 : (root.page == 11 || root.on-tool-page) ? 1
                : root.page == 5 ? 2 : root.page == 12 ? 3 : root.page == 6 ? 4 : -1;
            tool: root.on-tool-page ? root.current-tool : 0;
            pinned: root.pinned-tools;
            version: root.app-version;
            navigate(i) => {
                root.page = i == 5 ? 14 : i == 0 ? 10 : i == 1 ? 11 : i == 2 ? 5 : i == 3 ? 12 : 6;
            }
            open-tool(id) => {
                root.open-tool(id);
            }
        }

        if root.classic-ui: Sidebar {
            page: root.page;
            lang: root.lang;
            navigate(p) => { root.page = p; }
            new-ui => { root.set-classic(false); }
        }

        // ── Content area ──────────────────────────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;

            // ── Top bar ───────────────────────────────────────────────────────
            if root.classic-ui: TopBar {
                lang: root.lang;
                is-dark: root.is-dark;
                scheme: root.scheme;
                set-scheme(i) => {
                    if i != root.scheme {
                        root.pending-scheme = i;
                        root.pending-translucent = root.translucent;
                        root.start-transition(4, root.width - 162px);
                    }
                }
                translucent: root.translucent;
                set-translucent(t) => {
                    root.pending-scheme = root.scheme;
                    root.pending-translucent = t;
                    root.start-transition(4, root.width - 162px);
                }
                ui-scale: root.ui-scale;
                set-scale(v) => { root.set-scale(v); root.ui-scale = v; }
                set-lang(l) => {
                    if l != root.lang {
                        root.pending-lang = l;
                        root.start-transition(3, root.width - 134px);
                    }
                }
                toggle-theme => {
                    root.pending-dark = !root.is-dark;
                    root.start-transition(2, root.width - 41px);
                }
            }

            if !root.classic-ui && root.on-tool-page: HorizontalLayout {
                padding-left: 12px;
                padding-top: 8px;
                alignment: start;
                TextButton {
                    icon: @image-url("icons/arrow_back.svg");
                    text: Tr.t("Tools", "Инструменты", "工具", "工具");
                    clicked => {
                        root.page = 11;
                    }
                }
            }

            // ── Pages ─────────────────────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    x: root.page-x;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;
                        height: 100%;

                        if root.page == 0: HomePage {
                            app-version: root.app-version;
                            lang: root.lang;
                            navigate-to(p) => { root.page = p; }
                        }

                        if root.page == 1: DevicePage {
                            section: root.classic-ui ? 0 : root.current-tool - 2;
                            title: root.classic-ui ? Tr.nav-device : Tools.title(root.current-tool);
                            device: root.device;
                            test-step: root.test-step;
                            test-status: root.test-status;
                            device-log: root.device-log;
                            device-export-status: root.device-export-status;
                            check-device => { root.check-device(); }
                            check-deps => { root.check-deps(); }
                            install-deps => { root.install-deps(); }
                            run-driver-test => { root.run-driver-test(); }
                            reboot-to(t) => { root.reboot-to(t); }
                            set-active-slot(s) => { root.set-active-slot(s); }
                            export-device-log => { root.export-device-log(); }
                        }

                        if root.page == 2: DownloadPage {
                            device: root.device;
                            output-dir: root.output-dir;
                            download-url <=> root.download-url;
                            dl-speed: root.dl-speed;
                            dl-eta: root.dl-eta;
                            dl-downloaded: root.dl-downloaded;
                            dl-total: root.dl-total;
                            dl-percent: root.dl-percent;
                            is-downloading: root.is-downloading;
                            firmware-path: root.firmware-path;
                            download-log: root.download-log;
                            download-export-status: root.download-export-status;
                            browse-output-dir => { root.browse-output-dir(); }
                            paste-clipboard => { root.paste-clipboard(); }
                            download-firmware(url) => { root.download-firmware(url); }
                            cancel-download => { root.cancel-download(); }
                            browse-firmware => { root.browse-firmware(); }
                            extract-firmware => { root.extract-firmware(); }
                            export-download-log => { root.export-download-log(); }
                        }

                        if root.page == 3: FlashPage {
                            device: root.device;
                            flash-source-mode: root.flash-source-mode;
                            firmware-path: root.firmware-path;
                            source-dir: root.source-dir;
                            source-image-count: root.source-image-count;
                            source-total-ops: root.source-total-ops;
                            show-skip-partitions <=> root.show-skip-partitions;
                            skip-partitions <=> root.skip-partitions;
                            is-flashing: root.is-flashing;
                            flash-progress: root.flash-progress;
                            flash-status: root.flash-status;
                            flash-log: root.flash-log;
                            flash-export-status: root.flash-export-status;
                            lang: root.lang;
                            browse-folder => { root.browse-folder(); }
                            check-device => { root.check-device(); }
                            browse-source-dir => { root.browse-source-dir(); }
                            start-flash-from-source => { root.start-flash-from-source(); }
                            start-flash => { root.start-flash(); }
                            cancel-flash => { root.cancel-flash(); }
                            export-flash-log => { root.export-flash-log(); }
                            show-reboot-choice => {
                                // Step 0 of the flash flow: mandatory method choice.
                                root.pending-source-flash = false;
                                root.flash-method = 0;
                                root.reboot-choice = 0;
                                root.confirm-action = ConfirmAction.flash-method;
                                root.show-confirm = true;
                            }
                        }

                        if root.page == 4: PartitionPage {
                            device: root.device;
                            single-image-path: root.single-image-path;
                            partition-name <=> root.partition-name;
                            is-flashing: root.is-flashing;
                            flash-progress: root.flash-progress;
                            flash-status: root.flash-status;
                            partition-log: root.partition-log;
                            partition-export-status: root.partition-export-status;
                            lang: root.lang;
                            browse-single-image => { root.browse-single-image(); }
                            check-device => { root.check-device(); }
                            show-partition-reboot-choice => {
                                root.reboot-choice = 0;
                                root.confirm-action = ConfirmAction.part-reboot;
                                root.show-confirm = true;
                            }
                            start-single-flash => { root.start-single-flash(); }
                            cancel-flash => { root.cancel-flash(); }
                            export-partition-log => { root.export-partition-log(); }
                        }

                        if root.page == 5: HistoryPage {
                            lang: root.lang;
                            history-items: root.history-items;
                        }

                        if root.page == 6: AboutPage {
                            app-version: root.app-version;
                            open-url(u) => { root.open-url(u); }
                        }

                        if root.page == 10: InstallPage {
                            view: root.install-view;
                            deps-state: root.deps-state;
                            deps-missing: root.deps-missing;
                            fw-state: root.fw-state;
                            fw-name: root.fw-name;
                            fw-parts: root.fw-parts;
                            fw-error: root.fw-error;
                            unpack-count: root.unpack-count;
                            unpack-current: root.unpack-current;
                            cached-firmwares: root.cached-firmwares;
                            wrong-device: root.fw-wrong-device;
                            unauthorized: root.device-unauthorized;
                            cancel-unpack => { root.cancel-unpack(); }
                            pick-cached(i) => { root.pick-cached(i); }
                            download-url <=> root.download-url;
                            link-life: root.link-life;
                            link-life-kind: root.link-life-kind;
                            dl-percent: root.dl-percent;
                            dl-downloaded: root.dl-downloaded;
                            dl-total: root.dl-total;
                            dl-speed: root.dl-speed;
                            dl-eta: root.dl-eta;
                            device: root.device;
                            ota-model <=> root.ota-model;
                            ota-state: root.ota-state;
                            ota-done: root.ota-done;
                            ota-total: root.ota-total;
                            ota-builds: root.ota-builds;
                            ota-error: root.ota-error;
                            find-ota(m) => { root.find-ota(m); }
                            cancel-ota => { root.cancel-ota(); }
                            download-ota(i) => { root.download-ota(i); }
                            load-ota-changes(i) => { root.load-ota-changes(i); }
                            chip: root.chip;
                            stage0: root.stage0;
                            stage1: root.stage1;
                            stage2: root.stage2;
                            stage1-detail: root.stage1-detail;
                            flash-progress: root.flash-progress;
                            current-partition: root.current-partition;
                            cable-failed: root.cable-failed;
                            cable-detail: root.cable-detail;
                            log: root.flash-log;
                            export-status: root.flash-export-status;
                            result-detail: root.result-detail;
                            untouched: root.untouched;
                            minutes: root.install-minutes;
                            seconds: root.install-seconds;
                            wiped: root.install-wiped;
                            install-deps => { root.install-deps(); }
                            pick-zip => { root.pick-zip(); }
                            pick-folder => { root.pick-folder(); }
                            paste-url => { root.paste-clipboard(); }
                            download(u) => { root.download-firmware(u); }
                            cancel-download => { root.cancel-download(); }
                            change-firmware => { root.change-firmware(); }
                            choose-chip(c) => { root.choose-chip(c); }
                            install => { root.open-sheet(); }
                            cable-retry => { root.cable-retry(); }
                            cable-stop => { root.cable-stop(); }
                            stop-install => { root.cancel-flash(); }
                            reboot-phone => {
                                root.post-flash-reboot();
                                root.install-wiped = false;
                                root.install-view = 4;
                            }
                            wipe-phone => {
                                root.confirm-action = ConfirmAction.wipe;
                                root.show-confirm = true;
                            }
                            finish => { root.install-finish(); }
                            retry => { root.install-retry(); }
                            export-log => { root.export-flash-log(); }
                        }

                        if root.page == 15: RepairPage {
                            state: root.repair-state;
                            count: root.repair-count;
                            error: root.repair-error;
                            run => { root.repair-ota(); }
                        }

                        if root.page == 13: LogsPage {
                            device-log: root.device-log;
                            download-log: root.download-log;
                            flash-log: root.flash-log;
                            partition-log: root.partition-log;
                            export-status: root.flash-export-status;
                            export(i) => {
                                if i == 0 {
                                    root.export-device-log();
                                } else if i == 1 {
                                    root.export-download-log();
                                } else if i == 2 {
                                    root.export-flash-log();
                                } else {
                                    root.export-partition-log();
                                }
                            }
                        }

                        if root.page == 14: HomeDash {
                            device: root.device;
                            chip: root.chip;
                            unauthorized: root.device-unauthorized;
                            app-version: root.app-version;
                            update-version: root.update-known ? root.update-version : "";
                            install => { root.page = 10; }
                            show-update => { root.show-update-dialog = true; }
                            open-url(u) => { root.open-url(u); }
                        }

                        if root.page == 11: ToolsGrid {
                            pinned: root.pinned-flags;
                            open(id) => { root.open-tool(id); }
                            toggle-pin(id) => { root.toggle-pin(id); }
                        }

                        if root.page == 12: SettingsPage {
                            is-dark: root.is-dark;
                            scheme: root.scheme;
                            translucent: root.translucent;
                            ui-scale: root.ui-scale;
                            lang: root.lang;
                            output-dir: root.output-dir;
                            cache-summary: root.cache-summary;
                            chips-summary: root.chips-summary;
                            classic-ui: root.classic-ui;
                            sound: root.sound;
                            rebuild-super: root.rebuild-super;
                            set-rebuild-super(on) => {
                                root.rebuild-super = on;
                                root.set-rebuild-super(on);
                            }
                            set-sound(on) => {
                                root.sound = on;
                                root.set-sound(on);
                            }
                            set-dark(d) => {
                                if d != root.is-dark {
                                    root.pending-dark = d;
                                    root.start-transition(2, root.width / 2);
                                }
                            }
                            set-scheme(i) => {
                                if i != root.scheme {
                                    root.pending-scheme = i;
                                    root.pending-translucent = root.translucent;
                                    root.start-transition(4, root.width / 2);
                                }
                            }
                            set-translucent(t) => {
                                root.pending-scheme = root.scheme;
                                root.pending-translucent = t;
                                root.start-transition(4, root.width / 2);
                            }
                            set-scale(v) => { root.set-scale(v); root.ui-scale = v; }
                            set-lang(l) => {
                                if l != root.lang {
                                    root.pending-lang = l;
                                    root.start-transition(3, root.width / 2);
                                }
                            }
                            browse-output-dir => { root.browse-output-dir(); }
                            clear-cache => { root.clear-cache(); }
                            forget-chips => { root.forget-chips(); }
                            set-classic(c) => { root.set-classic(c); }
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Palette.color-scheme == ColorScheme.dark
                        ? MaterialPalette.surface-container-low
                        : #fafafa;
                    opacity: root.page-opacity;
                    animate opacity {
                        duration: 300ms;
                        easing: ease-in-out;
                    }
                }
            }
        }
    }

    // ── Dialogs ───────────────────────────────────────────────────────────────
    // Flash-all flow: flash-method → reboot-choice → cable-test
    // → [worker prepares firmware] → ARB warning (Snapdragon) or preloader
    // warning (MediaTek) → final warning (flash-all-final/source-final) → flash.
    FlashMethodDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.flash-method;
        method <=> root.flash-method;
        cancel => {
            root.show-confirm = false;
            root.flash-method = 0;
            root.pending-source-flash = false;
        }
        proceed => { root.confirm-action = ConfirmAction.reboot-choice; }
    }

    FlashAllRebootDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.reboot-choice;
        lang: root.lang;
        reboot-choice <=> root.reboot-choice;
        cancel => { root.show-confirm = false; root.reboot-choice = 0; root.pending-source-flash = false; }
        back => { root.confirm-action = ConfirmAction.flash-method; }
        reboot-and-flash => { root.show-confirm = false; root.reboot-for-flash(); }
    }

    FlashAllFinalDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.flash-all-final;
        cancel => { root.show-confirm = false; }
        back => { root.confirm-action = ConfirmAction.reboot-choice; }
        flash => { root.show-confirm = false; root.start-flash(); }
    }

    SourceFlashFinalDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.source-final;
        cancel => { root.show-confirm = false; root.pending-source-flash = false; }
        back => { root.confirm-action = ConfirmAction.reboot-choice; }
        flash => { root.show-confirm = false; root.start-flash(); }
    }

    PartitionRebootDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.part-reboot;
        lang: root.lang;
        reboot-choice <=> root.reboot-choice;
        cancel => { root.show-confirm = false; }
        next => { root.confirm-action = ConfirmAction.part-final; }
    }

    PartitionFinalDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.part-final;
        partition-name: root.partition-name;
        cancel => { root.show-confirm = false; }
        back => { root.confirm-action = ConfirmAction.part-reboot; }
        flash => { root.show-confirm = false; root.start-single-flash(); }
    }

    PostFlashSuccessDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.success;
        lang: root.lang;
        dismiss => { root.show-confirm = false; }
        reboot => { root.show-confirm = false; root.post-flash-reboot(); }
        wipe-and-reboot => { root.show-confirm = false; root.post-flash-wipe(); }
    }

    CableTestDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.cable-test;
        lang: root.lang;
        cable-test-progress: root.cable-test-progress;
        cable-test-status: root.cable-test-status;
        cable-test-passed: root.cable-test-passed;
        cancel => { root.show-confirm = false; root.pending-source-flash = false; }
        continue-flash => {
            // Hand over to the worker: extract + validate the firmware, then
            // FlashPrepared drives the ARB/preloader warnings and the final
            // confirmation — in that order.
            root.show-confirm = false;
            root.prepare-flash();
        }
    }

    WarningDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.fastbootd-fallback;
        title: Tr.fastbootd-fallback-title;
        body: root.fastbootd-fallback-detail;
        warning-text: Tr.fastbootd-fallback-warning;
        has-checkbox: false;
        checkbox-text: "";
        checkbox-checked: false;
        lang: root.lang;
        cancelled => {
            root.show-confirm = false;
            root.fastbootd-fallback-stop();
        }
        confirmed => {
            root.show-confirm = false;
            root.fastbootd-fallback-continue();
        }
        checkbox-toggled => {}
    }

    FlashFailureDialog {
        show: root.show-confirm && (root.confirm-action == ConfirmAction.flash-failure || root.confirm-action == ConfirmAction.session-error);
        lang: root.lang;
        is-session-error: root.confirm-action == ConfirmAction.session-error;
        flash-fail-partition: root.flash-fail-partition;
        flash-fail-slot: root.flash-fail-slot;
        flash-fail-error: root.flash-fail-error;
        retry => { root.show-confirm = false; root.flash-fail-retry(); }
        abort => { root.show-confirm = false; root.flash-fail-abort(); }
        skip => { root.show-confirm = false; root.flash-fail-skip(); }
        close => { root.show-confirm = false; }
    }

    // Snapdragon only: ARB must be confirmed BEFORE the final warning.
    ArbWarningDialog {
        show: root.show-arb-warning;
        lang: root.lang;
        arb-warning-state: root.arb-warning-state;
        arb-warning-version: root.arb-warning-version;
        skip-xbl-abl <=> root.skip-xbl-abl;
        cancel => { root.show-arb-warning = false; root.pending-source-flash = false; }
        confirm => {
            root.show-arb-warning = false;
            root.confirm-action = ConfirmAction.flash-all-final;
            root.show-confirm = true;
        }
    }

    // MediaTek only: preloader handling must be confirmed BEFORE the final warning.
    PreloaderWarningDialog {
        show: root.show-preloader-warning;
        lang: root.lang;
        skip-preloader <=> root.skip-preloader;
        cancel => { root.show-preloader-warning = false; root.pending-source-flash = false; }
        confirm => {
            root.show-preloader-warning = false;
            root.confirm-action = root.pending-source-flash ? ConfirmAction.source-final : ConfirmAction.flash-all-final;
            root.show-confirm = true;
        }
    }

    if root.sheet > 0: ConfirmSheet {
        kind: root.sheet - 1;
        arb: root.fw-arb;
        phone: root.device.name;
        chip-name: root.chip == 1 ? "Snapdragon" : "MediaTek";
        wrong-device: root.fw-wrong-device;
        rebuild-super: root.rebuild-super;
        super-plan: root.super-plan;
        firmware: root.fw-name + " · " + root.fw-parts + Tr.t(" parts", " разделов", " 个分区", " 個分割區");
        // One checkbox per warning kind: xbl/abl for ARB, preloader for MTK.
        skip-checked: root.sheet == 3 ? root.skip-preloader : root.skip-xbl-abl;
        skip-boot <=> root.skip-boot;
        skip-init-boot <=> root.skip-init-boot;
        skip-recovery <=> root.skip-recovery;
        skip-vendor-boot <=> root.skip-vendor-boot;
        skip-other <=> root.skip-other;
        cancel => { root.sheet = 0; }
        next => {
            if root.sheet == 3 {
                root.skip-preloader = self.skip-checked;
            } else {
                root.skip-xbl-abl = self.skip-checked;
            }
            root.sheet = 4;
        }
        // Back to the warning, keeping its checkbox; with no warning, close.
        back => {
            root.sheet = root.first-sheet() == 4 ? 0 : root.first-sheet();
        }
        change-chip => {
            root.sheet = 0;
            root.choose-chip(0);
        }
        install => {
            root.sheet = 0;
            root.run-install();
        }
    }

    WarningDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.wipe;
        title: Tr.t("Erase everything on the phone?", "Стереть всё на смартфоне?", "清除手机上的全部数据？", "清除手機上的所有資料？");
        body: Tr.t("Photos, apps, accounts and settings are deleted, as after a factory reset. Then the phone restarts.", "Удалятся фото, приложения, аккаунты и настройки — как после сброса к заводским. Затем смартфон перезагрузится.", "照片、应用、账户和设置都会被删除，如同恢复出厂设置。随后手机会重启。", "照片、應用程式、帳號和設定都會被刪除，如同恢復原廠設定。隨後手機會重新啟動。");
        warning-text: Tr.t("This cannot be undone.", "Это нельзя отменить.", "此操作无法撤销。", "此操作無法復原。");
        has-checkbox: false;
        checkbox-text: "";
        checkbox-checked: false;
        lang: root.lang;
        cancelled => { root.show-confirm = false; }
        confirmed => {
            root.show-confirm = false;
            root.post-flash-wipe();
            root.install-wiped = true;
            root.install-view = 4;
        }
    }

    WarningDialog {
        show: root.show-confirm && root.confirm-action == ConfirmAction.close-flashing;
        title: Tr.t("Close while flashing?", "Закрыть во время прошивки?", "刷写过程中关闭？", "刷寫過程中關閉？");
        body: Tr.t("The firmware is being written. Closing the app stops it halfway, and the phone may not start until it is flashed again.", "Прошивка ещё записывается. Если закрыть программу, она остановится на середине, и смартфон может не запуститься, пока его не прошьют заново.", "固件正在写入。关闭程序会使其中途停止，手机可能无法启动，直到重新刷写。", "韌體正在寫入。關閉程式會使其中途停止，手機可能無法開機，直到重新刷寫。");
        warning-text: Tr.t("Better wait until it finishes.", "Лучше дождитесь окончания.", "最好等待完成。", "最好等待完成。");
        has-checkbox: false;
        checkbox-text: "";
        checkbox-checked: false;
        lang: root.lang;
        cancelled => { root.show-confirm = false; }
        confirmed => { root.quit-app(); }
    }

    if root.show-notice: StartupNotice {
        accept => {
            root.show-notice = false;
            root.accept-notice();
        }
    }

    UpdateDialog {
        show: root.show-update-dialog;
        lang: root.lang;
        update-version: root.update-version;
        update-body: root.update-body;
        cancel => { root.show-update-dialog = false; }
        download => { root.open-update-url(); }
    }

    Rectangle {
        z: 201;
        visible: root.reveal-visible;
        x: root.reveal-cx - self.width / 2;
        y: root.reveal-cy - self.height / 2;
        width: root.reveal-p * root.reveal-max;
        height: self.width;
        border-radius: self.width / 2;
        background: root.reveal-color;
    }
}
