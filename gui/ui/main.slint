// LibreFastbootFirmwareFlasher — Material Design 3 GUI (Slint built-in material)

import { Palette, ScrollView } from "std-widgets.slint";

// MD3 color roles — Blue palette, clean dark/light
global MaterialPalette {
    in-out property <color> primary:                Palette.color-scheme == ColorScheme.dark ? #9ec3ff : #0061a4;
    in-out property <color> on-primary:             Palette.color-scheme == ColorScheme.dark ? #003258 : #ffffff;
    in-out property <color> primary-container:      Palette.color-scheme == ColorScheme.dark ? #00497d : #d0e4ff;
    in-out property <color> on-primary-container:   Palette.color-scheme == ColorScheme.dark ? #d0e4ff : #001d36;
    in-out property <color> secondary-container:    Palette.color-scheme == ColorScheme.dark ? #3a5a72 : #d6e3ff;
    in-out property <color> on-secondary-container: Palette.color-scheme == ColorScheme.dark ? #d6e3ff : #001d36;
    in-out property <color> surface-container-low:  Palette.color-scheme == ColorScheme.dark ? #141416 : #fef7ff;
    in-out property <color> surface-container:      Palette.color-scheme == ColorScheme.dark ? #1c1c1e : #fef7ff;
    in-out property <color> surface-container-high: Palette.color-scheme == ColorScheme.dark ? #28282a : #ece6f0;
    in-out property <color> surface-container-highest: Palette.color-scheme == ColorScheme.dark ? #323234 : #e6e0e9;
    in-out property <color> on-surface:             Palette.color-scheme == ColorScheme.dark ? #e4e1e6 : #1c1b1f;
    in-out property <color> on-surface-variant:     Palette.color-scheme == ColorScheme.dark ? #c6c4c8 : #49454f;
    in-out property <color> outline:                Palette.color-scheme == ColorScheme.dark ? #8e8e93 : #79747e;
    in-out property <color> outline-variant:        Palette.color-scheme == ColorScheme.dark ? #444649 : #cac4d0;
    in-out property <color> error:                  Palette.color-scheme == ColorScheme.dark ? #f2b8b5 : #b0121a;
    in-out property <color> on-error:               Palette.color-scheme == ColorScheme.dark ? #601410 : #ffffff;
    in-out property <color> error-container:        Palette.color-scheme == ColorScheme.dark ? #8c1d18 : #f1d8d9;
    in-out property <color> on-error-container:     Palette.color-scheme == ColorScheme.dark ? #ffdad6 : #541217;
}

// ── Custom MD3-styled components ────────────────────────────────────────────

component FilledButton {
    in property <string> text;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: root.enabled ? MaterialPalette.primary : MaterialPalette.surface-container;
        animate background { duration: 200ms; easing: ease-out; }
        Rectangle {
            width: 100%; height: 100%; border-radius: 20px;
            background: ta.has-hover ? MaterialPalette.on-primary.with-alpha(0.12) : transparent;
            animate background { duration: 200ms; easing: ease-out; }
        }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 16px; padding-right: 16px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: root.enabled ? MaterialPalette.on-primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: ease-out; }
                }
            }
        }
    }
}

component OutlinedButton {
    in property <string> text;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        border-width: 1px;
        border-color: root.enabled ? MaterialPalette.outline : MaterialPalette.outline-variant;
        background: ta.has-hover ? MaterialPalette.primary.with-alpha(0.12) : transparent;
        animate background { duration: 200ms; easing: ease-out; }
        animate border-color { duration: 200ms; easing: ease-out; }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 16px; padding-right: 16px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: ease-out; }
                }
            }
        }
    }
}

component TextButton {
    in property <string> text;
    in property <bool> enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: ta.has-hover ? MaterialPalette.primary.with-alpha(0.12) : transparent;
        animate background { duration: 200ms; easing: ease-out; }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: ease-out; }
                }
            }
        }
    }
}

component FilledTonalButton {
    in property <string> text;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: MaterialPalette.secondary-container;
        animate background { duration: 200ms; easing: ease-out; }
        Rectangle {
            width: 100%; height: 100%; border-radius: 20px;
            background: ta.has-hover ? MaterialPalette.primary.with-alpha(0.12) : transparent;
            animate background { duration: 200ms; easing: ease-out; }
        }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 16px; padding-right: 16px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: MaterialPalette.on-secondary-container;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: ease-out; }
                }
            }
        }
    }
}

component HorizontalDivider {
    height: 1px;
    Rectangle {
        width: 100%; height: 1px;
        background: MaterialPalette.outline-variant;
    }
}

component LinearProgressIndicator {
    in property <float> progress;
    height: 4px;
    Rectangle {
        border-radius: 2px;
        background: MaterialPalette.surface-container-high;
        width: 100%; height: 100%;
        Rectangle {
            border-radius: 2px;
            width: parent.width * root.progress;
            height: 100%;
            background: MaterialPalette.primary;
            animate width { duration: 200ms; easing: ease-out; }
        }
    }
}

component BackButton {
    callback clicked;
    width: 40px; height: 40px;
    TouchArea {
        clicked => { root.clicked(); }
        Rectangle {
            border-radius: 20px; border-width: 1px;
            border-color: MaterialPalette.outline;
            background: parent.has-hover ? MaterialPalette.surface-container-highest : transparent;
            animate background { duration: 80ms; }
            Image {
                source: @image-url("icons/arrow_back.svg");
                width: 20px; height: 20px;
                x: (parent.width - 20px) / 2;
                y: (parent.height - 20px) / 2;
                colorize: MaterialPalette.on-surface-variant;
            }
        }
    }
}

// ── Structs ───────────────────────────────────────────────────────────────────

export struct DeviceInfo { connected: bool, name: string, serial: string, slot: string }
export struct LogEntry   { timestamp: string, level: string, message: string }

// ── Translations ──────────────────────────────────────────────────────────────

