import { MaterialPalette } from "@material";
import { Typography } from "../globals/typography.slint";

export component NavItem inherits TouchArea {
    in property <string> label;
    in property <bool> selected;
    in property <image> icon;
    in property <image> icon-active;

    height: 56px;

    Rectangle {
        // Selected pill expands springily and squashes slightly on press.
        x: 0;
        y: root.pressed ? 5px : 4px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: root.pressed ? 20px : 28px;
        background: selected
            ? MaterialPalette.secondary-container
            : transparent;
        animate background {
            duration: 250ms;
            easing: cubic-bezier(0.2, 0.0, 0, 1.0);
        }
        animate border-radius, y {
            duration: 350ms;
            easing: spring;
        }

        // State layer overlay
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: root.has-hover
                ? MaterialPalette.on-surface.with-alpha(0.08)
                : transparent;
            animate background { duration: 100ms; }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 24px;
            spacing: 12px;

            Image {
                source: selected ? root.icon-active : root.icon;
                width: 22px;
                height: 22px;
                y: (parent.height - 22px) / 2;
                colorize: selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                animate colorize { duration: 150ms; }
            }

            Text {
                text: label;
                font-size: Typography.label-large-size;
                font-weight: selected ? Typography.label-large-weight-em : Typography.label-large-weight;
                color: selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                animate color { duration: 150ms; }
            }
        }
    }
}

