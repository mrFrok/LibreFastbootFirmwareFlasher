import { MaterialPalette } from "../globals/material-palette.slint";

export component NavItem inherits TouchArea {
    in property <string>  label;
    in property <bool>    selected;
    in property <image>   icon;

    height: 56px;

    Rectangle {
        x: 0; y: 4px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: 28px;
        background: selected
            ? MaterialPalette.secondary-container
            : transparent;
        animate background { duration: 150ms; }

        Rectangle {
            width: 100%; height: 100%; border-radius: 28px;
            background: root.has-hover
                ? MaterialPalette.on-surface.with-alpha(0.12)
                : transparent;
            animate background { duration: 150ms; }
        }

        HorizontalLayout {
            padding-left: 16px; padding-right: 24px; spacing: 12px;

            Image {
                source: icon;
                width: 22px; height: 22px;
                y: (parent.height - 22px) / 2;
                colorize: selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                animate colorize { duration: 150ms; }
            }

            Text {
                text: label;
                font-size: 14px;
                font-weight: selected ? 700 : 500;
                color: selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                animate color { duration: 150ms; }
            }
        }
    }
}

export component AboutLink inherits TouchArea {
    in property <image>  icon;
    in property <string> label;
    in property <string> url;

    callback open(string);
    clicked => { open(url); }

    height: 52px;

    Rectangle {
        border-radius: 12px;
        background: parent.has-hover
            ? MaterialPalette.surface-container-high
            : MaterialPalette.surface-container;
        border-width: 1px;
        border-color: MaterialPalette.outline-variant;
        animate background { duration: 80ms; }

        HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 12px;
            Image {
                source: icon;
                width: 22px; height: 22px;
                y: (parent.height - 22px) / 2;
            }
            Text {
                text: label;
                font-size: 15px; font-weight: 500;
                color: MaterialPalette.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: "→";
                font-size: 15px;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
            }
        }
    }
}
