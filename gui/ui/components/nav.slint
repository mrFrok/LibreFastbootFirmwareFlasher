import { MaterialPalette } from "../globals/material-palette.slint";
import { Typography } from "../globals/typography.slint";

export component NavItem inherits TouchArea {
    in property <string>  label;
    in property <bool>    selected;
    in property <image>   icon;
    in property <image>   icon-active;

    height: 56px;

    Rectangle {
        // Selected pill expands springily and squashes slightly on press.
        x: 0;
        y: root.pressed ? 5px : 4px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: root.pressed ? 20px : 28px;
        background: selected
            ? MaterialPalette.secondary-container
            : transparent;
        animate background { duration: 250ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate border-radius, y { duration: 350ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

        // State layer overlay
        Rectangle {
            width: 100%; height: 100%; border-radius: parent.border-radius;
            background: root.has-hover
                ? MaterialPalette.on-surface.with-alpha(0.08)
                : transparent;
            animate background { duration: 100ms; }
        }

        HorizontalLayout {
            padding-left: 16px; padding-right: 24px; spacing: 12px;

            Image {
                source: selected ? root.icon-active : root.icon;
                width: 22px; height: 22px;
                y: (parent.height - 22px) / 2;
                colorize: selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                animate colorize { duration: 150ms; }
            }

            Text {
                text: label;
                font-size: Typography.label-large-size;
                font-weight: selected ? Typography.label-large-weight-em : Typography.label-large-weight;
                color: selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                animate color { duration: 150ms; }
            }
        }
    }
}

export component AboutLink inherits TouchArea {
    in property <image>  icon;
    in property <string> label;
    in property <string> url;

    callback open(string);
    clicked => { open(url); }

    height: 54px;

    Rectangle {
        y: root.pressed ? 1.5px : 0px;
        border-radius: root.pressed ? 14px : 20px;
        background: root.has-hover
            ? MaterialPalette.surface-container-high
            : MaterialPalette.surface-container;
        border-width: 1px;
        border-color: root.has-hover
            ? MaterialPalette.outline
            : MaterialPalette.outline-variant;
        animate border-radius, y { duration: 350ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate background { duration: 150ms; }
        animate border-color { duration: 150ms; }

        HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 12px;
            // Icon in tertiary circle
            Rectangle {
                width: 32px; height: 32px;
                border-radius: root.has-hover ? 12px : 16px;
                background: MaterialPalette.tertiary-container;
                y: (parent.height - 32px) / 2;
                animate border-radius { duration: 350ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                Image {
                    source: icon;
                    width: 16px; height: 16px;
                    x: (parent.width - 16px) / 2;
                    y: (parent.height - 16px) / 2;
                    colorize: MaterialPalette.on-tertiary-container;
                }
            }
            Text {
                text: label;
                font-size: Typography.body-medium-size;
                font-weight: Typography.body-medium-weight;
                color: MaterialPalette.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: "→";
                font-size: Typography.body-large-size;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
            }
        }
    }
}
