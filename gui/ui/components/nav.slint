import { MaterialPalette } from "@material";
import { Typography } from "../globals/typography.slint";

// One sidebar row: 40px tall with 2px above and below, so rows sit 4px apart.
// The selection is a surface step, not a pill; the weight never changes, so
// the label does not jump when it is selected.
export component NavItem inherits TouchArea {
    in property <string> label;
    in property <bool> selected;
    in property <image> icon;
    in property <image> icon-active;

    height: 44px;

    Rectangle {
        y: 2px;
        height: parent.height - 4px;
        border-radius: 10px;
        background: root.selected ? MaterialPalette.secondary-container
            : root.pressed ? MaterialPalette.on-surface.with-alpha(0.12)
            : root.has-hover ? MaterialPalette.on-surface.with-alpha(0.06)
            : transparent;
        animate background {
            duration: 150ms;
            easing: cubic-bezier(0.2, 0.0, 0, 1.0);
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;

            Image {
                source: root.selected ? root.icon-active : root.icon;
                width: 20px;
                height: 20px;
                y: (parent.height - 20px) / 2;
                colorize: root.selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
            }

            Text {
                text: root.label;
                font-size: Typography.label-large-size;
                font-weight: Typography.label-large-weight;
                color: root.selected
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}
