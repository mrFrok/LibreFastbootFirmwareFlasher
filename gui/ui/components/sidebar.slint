import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { NavItem } from "./nav.slint";

export component Sidebar inherits Rectangle {
    in property <int> page: 0;
    in property <string> lang: "en";
    callback navigate(int);

    width: 240px;
    background: MaterialPalette.surface-container-low;

    VerticalLayout {
        padding-top: 0px;
        padding-bottom: 16px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0px;

        Rectangle { height: 72px;
            HorizontalLayout { padding-left: 16px; spacing: 8px;
                Image {
                    source: @image-url("../icons/logo_icon.svg");
                    width: 32px; height: 32px;
                    y: (parent.height - 32px) / 2;
                }
                VerticalLayout { spacing: 1px; horizontal-stretch: 1; alignment: center;
                    Text {
                        text: "LibreFastboot";
                        font-size: 13px; font-weight: 600;
                        color: MaterialPalette.on-surface;
                        overflow: elide;
                    }
                    Text {
                        text: "FirmwareFlasher";
                        font-size: 13px; font-weight: 600;
                        color: MaterialPalette.on-surface;
                        overflow: elide;
                    }
                }
            }
        }

        NavItem {
            label: Tr.home;
            icon: @image-url("../icons/home.svg");
            icon-active: @image-url("../icons/home-filled.svg");
            selected: root.page == 0;
            clicked => { root.navigate(0); }
        }
        NavItem {
            label: Tr.nav-device;
            icon: @image-url("../icons/smartphone.svg");
            icon-active: @image-url("../icons/smartphone-filled.svg");
            selected: root.page == 1;
            clicked => { root.navigate(1); }
        }
        NavItem {
            label: Tr.nav-download;
            icon: @image-url("../icons/download.svg");
            icon-active: @image-url("../icons/download-filled.svg");
            selected: root.page == 2;
            clicked => { root.navigate(2); }
        }
        NavItem {
            label: Tr.nav-flash;
            icon: @image-url("../icons/flash.svg");
            icon-active: @image-url("../icons/flash-filled.svg");
            selected: root.page == 3;
            clicked => { root.navigate(3); }
        }
        NavItem {
            label: Tr.nav-part;
            icon: @image-url("../icons/storage.svg");
            icon-active: @image-url("../icons/storage-filled.svg");
            selected: root.page == 4;
            clicked => { root.navigate(4); }
        }

        Rectangle { vertical-stretch: 1; }

        Rectangle { height: 16px; }
        Rectangle {
            height: 1px;
            background: MaterialPalette.outline-variant;
        }
        Rectangle { height: 8px; }

        NavItem {
            label: root.lang == "ru" ? "История" : "History";
            icon: @image-url("../icons/history.svg");
            icon-active: @image-url("../icons/history-filled.svg");
            selected: root.page == 5;
            clicked => { root.navigate(5); }
        }
        NavItem {
            label: Tr.nav-about;
            icon: @image-url("../icons/info.svg");
            icon-active: @image-url("../icons/info-filled.svg");
            selected: root.page == 6;
            clicked => { root.navigate(6); }
        }
    }
}
