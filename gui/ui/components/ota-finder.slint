import {
    LinearProgressIndicator,
    MaterialPalette,
    OutlineButton,
    TextButton,
    TonalButton,
} from "@material";
import { StatusColors } from "../globals/status-colors.slint";
import { Tr } from "../globals/tr.slint";
import { Notice } from "wizard.slint";

export struct OtaBuild {
    version: string,
    // e.g. "GL · EU"
    regions: string,
    // e.g. "2026-10-14 · 9.28 GB · patch 2026-09-01 · Android 16"
    facts: string,
    newest: bool,
    // the build the connected phone runs
    installed: bool,
    // built for the region the phone's firmware is from
    recommended: bool,
    // early access only ("taste")
    beta: bool,
    // filled once "What's new" is asked for; empty before
    changes: string,
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg;
    in property <color> bg;
    border-radius: 8px;
    background: root.bg;
    height: 22px;
    width: label.preferred-width + 16px;
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 500;
        color: root.fg;
    }
}

component BuildRow inherits Rectangle {
    in property <OtaBuild> build;
    in property <bool> show-changes;
    callback download();
    callback toggle-changes();
    min-width: 0px;
    border-radius: 12px;
    background: MaterialPalette.surface-container-low;
    border-width: 1px;
    border-color: root.build.newest ? MaterialPalette.primary.with-alpha(0.5) : MaterialPalette.outline-variant;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        min-width: 0px;
                        text: root.build.version;
                        font-size: 15px;
                        font-weight: 600;
                        color: MaterialPalette.on-surface;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Badge {
                        y: (parent.height - self.height) / 2;
                        text: root.build.regions;
                        fg: MaterialPalette.on-secondary-container;
                        bg: MaterialPalette.secondary-container;
                    }

                    if root.build.newest: Badge {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("newest", "новейшая", "最新", "最新");
                        fg: MaterialPalette.on-primary-container;
                        bg: MaterialPalette.primary-container;
                    }
                    if root.build.installed: Badge {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("installed", "установлена", "已安装", "已安裝");
                        fg: StatusColors.on-success-container;
                        bg: StatusColors.success-container;
                    }
                    if root.build.beta: Badge {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("beta", "бета", "测试版", "測試版");
                        fg: StatusColors.on-warning-container;
                        bg: StatusColors.warning-container;
                    }
                    if root.build.recommended && !root.build.installed: Badge {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("your region", "ваш регион", "您的地区", "您的地區");
                        fg: MaterialPalette.on-tertiary-container;
                        bg: MaterialPalette.tertiary-container;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        min-width: 0px;
                        text: root.build.facts;
                        font-size: 13px;
                        color: MaterialPalette.on-surface-variant;
                        overflow: elide;
                    }

                    changes-link := TouchArea {
                        width: link.preferred-width;
                        clicked => {
                            root.toggle-changes();
                        }
                        link := Text {
                            text: root.show-changes ? Tr.t("Hide changes", "Скрыть изменения", "收起更新内容", "收合更新內容") : Tr.t("What's new", "Что нового", "更新内容", "更新內容");
                            font-size: 13px;
                            font-weight: 500;
                            color: MaterialPalette.primary;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }

            TonalButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("../icons/download.svg");
                text: Tr.t("Download", "Скачать", "下载", "下載");
                clicked => {
                    root.download();
                }
            }
        }

        if root.show-changes: Text {
            text: root.build.changes == "" ? Tr.t("Loading…", "Загружаю…", "正在加载…", "正在載入…") : root.build.changes;
            font-size: 13px;
            color: MaterialPalette.on-surface;
            wrap: word-wrap;
        }
    }
}

// Asks the OPPO / OnePlus / realme update servers for the phone's official
// firmware. `state`: 0 not asked, 1 searching, 2 found, 3 nothing, 4 failed.
export component OtaFinder inherits Rectangle {
    in-out property <string> model;
    in property <int> state;
    in property <int> done;
    in property <int> total;
    in property <[OtaBuild]> builds;
    in property <string> error;
    // e.g. "GL — Global" from the connected phone; empty when unknown
    in property <string> phone-region;
    callback find(string);
    callback cancel();
    callback download(int);
    // Asks for the changelog of a build when it is shown the first time.
    callback load-changes(int);
    property <int> open-changes: -1;
    property <bool> show-all;
    // A Rectangle around the layout, not a layout itself: nested straight
    // into the step's layout, wrapping notices are measured a line short.
    VerticalLayout {
        spacing: 8px;

        Text {
            text: Tr.t("or find the official firmware by model", "или найдите официальную прошивку по модели", "或按型号查找官方固件", "或依型號尋找官方韌體");
            font-size: 13px;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;
            height: 40px;

            Rectangle {
                width: 130px;
                clip: true;
                border-radius: 12px;
                background: MaterialPalette.surface-container-low;
                border-width: 1px;
                border-color: model-input.has-focus ? MaterialPalette.primary : MaterialPalette.outline-variant;
                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    visible: root.model == "" && !model-input.has-focus;
                    text: "CPH2747";
                    font-size: 14px;
                    color: MaterialPalette.on-surface-variant;
                }

                model-input := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text <=> root.model;
                    font-size: 14px;
                    font-family: "monospace";
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        root.find(root.model);
                    }
                }
            }

            OutlineButton {
                enabled: root.model != "" && root.state != 1;
                text: Tr.t("Find", "Найти", "查找", "尋找");
                clicked => {
                    root.open-changes = -1;
                    root.show-all = false;
                    root.find(root.model);
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        if root.phone-region != "": Notice {
            kind: 0;
            icon: @image-url("../icons/smartphone.svg");
            title: Tr.t("The phone runs firmware for region ", "На смартфоне прошивка региона ", "手机当前固件地区：", "手機目前韌體地區：") + root.phone-region;
            text: Tr.t(
                "Install a build of the same region: it is marked “your region” and listed first. A build of another region switches the phone to that region.",
                "Ставьте сборку того же региона — она отмечена «ваш регион» и стоит первой. Сборка другого региона переключит смартфон на тот регион.",
                "请安装同一地区的版本：它标有“您的地区”并排在最前。安装其他地区的版本会把手机切换到该地区。",
                "請安裝同一地區的版本：它標有「您的地區」並排在最前。安裝其他地區的版本會把手機切換到該地區。");
        }

        if root.state == 1: HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: Tr.t("Asking the update servers… ", "Спрашиваю серверы обновлений… ", "正在查询更新服务器… ", "正在查詢更新伺服器… ") + root.done + " / " + root.total;
                font-size: 14px;
                color: MaterialPalette.on-surface;
                vertical-alignment: center;
            }

            TextButton {
                text: Tr.t("Cancel", "Отмена", "取消", "取消");
                clicked => {
                    root.cancel();
                }
            }
        }
        if root.state == 1: LinearProgressIndicator {
            progress: root.total > 0 ? root.done / root.total : 0;
        }

        if root.state == 3: Notice {
            kind: 0;
            icon: @image-url("../icons/info.svg");
            title: Tr.t("Nothing found", "Ничего не нашлось", "未找到", "未找到");
            text: Tr.t("No builds for ", "У серверов нет сборок для ", "服务器上没有 ", "伺服器上沒有 ") + root.model + Tr.t(". Check the model in Settings → About device: it looks like CPH2747 or RMX3709.", ". Проверьте модель в «Настройки → Об устройстве»: она выглядит как CPH2747 или RMX3709.", " 的固件。请在“设置 → 关于手机”中核对型号，形如 CPH2747 或 RMX3709。", " 的韌體。請在「設定 → 關於手機」中核對型號，形如 CPH2747 或 RMX3709。");
        }
        if root.state == 4: Notice {
            kind: 2;
            title: Tr.t("The update servers did not answer", "Серверы обновлений не ответили", "更新服务器无响应", "更新伺服器無回應");
            text: root.error;
        }

        // The newest three; the rest behind "Show all".
        for b[i] in root.builds: BuildRow {
            visible: root.state == 2 && (i < 3 || root.show-all);
            height: self.visible ? self.preferred-height : 0px;
            build: b;
            show-changes: root.open-changes == i;
            download => {
                root.download(i);
            }
            toggle-changes => {
                if root.open-changes == i {
                    root.open-changes = -1;
                } else {
                    root.open-changes = i;
                    if b.changes == "" {
                        root.load-changes(i);
                    }
                }
            }
        }
        if root.state == 2 && root.builds.length > 3 && !root.show-all: HorizontalLayout {
            alignment: start;
            TextButton {
                text: Tr.t("Show all (", "Показать все (", "显示全部（", "顯示全部（") + root.builds.length + Tr.t(")", ")", "）", "）");
                clicked => {
                    root.show-all = true;
                }
            }
        }
    }
}
