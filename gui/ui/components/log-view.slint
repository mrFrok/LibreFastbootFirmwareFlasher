import { Palette, ScrollView, Button } from "std-widgets.slint";
import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { LogEntry } from "../structs.slint";

export component LogView inherits Rectangle {
    in property <[LogEntry]> entries;
    in property <string> export-status: "";
    callback export-log();
    private property <int> entry-count: entries.length;
    background: MaterialPalette.surface-container-high;
    border-radius: 12px;
    clip: true;

    VerticalLayout { spacing: 8px; padding: 8px;
        HorizontalLayout { horizontal-stretch: 1;
            Text {
                text: Tr.log-title;
                font-size: 14px; font-weight: 600;
                color: MaterialPalette.on-surface;
                horizontal-stretch: 1;
            }
            Button {
                text: Tr.export-log;
                clicked => { export-log(); }
            }
        }
        if export-status != "": Text {
            text: export-status;
            font-size: 12px;
            color: MaterialPalette.success;
        }
        if entries.length == 0: Text {
            text: Tr.log-empty;
            color: MaterialPalette.on-surface-variant;
            font-size: 14px;
        }
        sv := ScrollView {
            VerticalLayout { spacing: 0px; padding: 6px;
            for e in entries: Rectangle {
                height: 20px;
                background: transparent;
                animate opacity { duration: 200ms; }
                HorizontalLayout { spacing: 6px; padding-left: 8px; padding-right: 8px;
                    Text {
                        text: e.timestamp;
                        font-size: 12px; font-family: "monospace";
                        color: MaterialPalette.on-surface-variant;
                        vertical-alignment: center; width: 52px;
                    }
                    Rectangle {
                        width: 32px; height: 16px; border-radius: 4px;
                        background: e.level == "error"   ? MaterialPalette.error-container
                                  : e.level == "success" ? MaterialPalette.success-container
                                  : e.level == "warn"    ? MaterialPalette.warning-container
                                  : MaterialPalette.primary-container;
                        Text {
                            text: e.level == "error" ? "ERR" : e.level == "success" ? " OK" : e.level == "warn" ? "WRN" : "INF";
                            font-size: 10px; font-weight: 700; font-family: "monospace";
                            horizontal-alignment: center; vertical-alignment: center;
                            color: e.level == "error"   ? MaterialPalette.on-error-container
                                 : e.level == "success" ? MaterialPalette.on-success-container
                                 : e.level == "warn"    ? MaterialPalette.on-warning-container
                                 : MaterialPalette.on-primary-container;
                        }
                    }
                    Text {
                        text: e.message;
                        font-size: 12px; font-family: "monospace";
                        color: MaterialPalette.on-surface;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        }
    }

    scroll-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            sv.viewport-y = -(sv.viewport-height - sv.visible-height);
        }
    }

    changed entry-count => {
        if entry-count > 0 {
            scroll-timer.running = true;
        }
    }
}
