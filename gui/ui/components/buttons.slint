import { Palette } from "std-widgets.slint";
import { MaterialPalette } from "../globals/material-palette.slint";
import { Typography } from "../globals/typography.slint";
import { Tr } from "../globals/tr.slint";
import { DeviceInfo } from "../structs.slint";

// ═══════════════════════════════════════════════════════════════════════════
// Material 3 Expressive Buttons
//
// Signature Expressive traits applied to every button:
//   • Shape morph on press — full pill (22px) squashes to a squircle (12px)
//   • Spring motion        — overshoot easing cubic-bezier(0.34,1.56,0.64,1)
//   • Press nudge          — the surface dips 1.5px to feel physical
//
// Each button is a standalone component (rather than a shared base) so that the
// content layout sizes the button intrinsically — a sub-component boundary does
// not propagate content-based preferred width, which collapses auto-width
// buttons to zero.
// ═══════════════════════════════════════════════════════════════════════════

// ── Filled Button ──────────────────────────────────────────────────────────
export component FilledButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 44px;
    // The outer layout forwards the content's preferred width to the
    // component root — without it the button collapses to zero width when
    // placed in a layout with `alignment:` set (see header comment).
    HorizontalLayout {
        Rectangle {
            border-radius: ta.pressed ? 12px : 22px; clip: true;
            y: ta.pressed ? 1.5px : 0px;
            // MD3 disabled state: 12% on-surface container + 38% on-surface label.
            background: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface.with-alpha(0.12);
            animate border-radius, y { duration: 350ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            animate background { duration: 150ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

            HorizontalLayout {
                padding-left: icon.width > 0 ? 16px : 24px;
                padding-right: icon.width > 0 ? 20px : 24px;
                spacing: 8px;
                if icon.width > 0: Image {
                    source: icon; width: 18px; height: 18px;
                    colorize: root.enabled ? MaterialPalette.on-primary : MaterialPalette.on-surface-variant;
                    y: (parent.height - 18px) / 2;
                }
                Text {
                    text: root.text;
                    font-size: Typography.label-large-size;
                    font-weight: Typography.label-large-weight;
                    color: root.enabled ? MaterialPalette.on-primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide;
                    animate color { duration: 150ms; }
                }
            }

            Rectangle {
                width: 100%; height: 100%; border-radius: parent.border-radius;
                background: ta.pressed
                    ? MaterialPalette.on-primary.with-alpha(0.14)
                    : ta.has-hover ? MaterialPalette.on-primary.with-alpha(0.10) : transparent;
                animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
            }

            ta := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

// ── Outlined Button ────────────────────────────────────────────────────────
export component OutlinedButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 44px;
    HorizontalLayout {
        Rectangle {
            border-radius: ta.pressed ? 12px : 22px; clip: true;
            y: ta.pressed ? 1.5px : 0px;
            border-width: 1px;
            border-color: root.enabled ? MaterialPalette.outline : MaterialPalette.outline-variant;
            animate border-radius, y { duration: 350ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            animate border-color { duration: 150ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

            HorizontalLayout {
                padding-left: icon.width > 0 ? 16px : 24px;
                padding-right: icon.width > 0 ? 20px : 24px;
                spacing: 8px;
                if icon.width > 0: Image {
                    source: icon; width: 18px; height: 18px;
                    colorize: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    y: (parent.height - 18px) / 2;
                }
                Text {
                    text: root.text;
                    font-size: Typography.label-large-size;
                    font-weight: Typography.label-large-weight;
                    color: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide;
                    animate color { duration: 150ms; }
                }
            }

            Rectangle {
                width: 100%; height: 100%; border-radius: parent.border-radius;
                background: ta.pressed
                    ? MaterialPalette.primary.with-alpha(0.14)
                    : ta.has-hover ? MaterialPalette.primary.with-alpha(0.10) : transparent;
                animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
            }

            ta := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

