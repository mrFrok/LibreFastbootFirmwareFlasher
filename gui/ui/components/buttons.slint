// ── Elevated Button (NEW) ──────────────────────────────────────────────────
export component ElevatedButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 40px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: root.enabled ? MaterialPalette.surface-container-low : MaterialPalette.surface-container;
        drop-shadow-blur: 3px;
        drop-shadow-color: MaterialPalette.drop-shadow;
        drop-shadow-offset-y: 1px;
        animate background { duration: 150ms; }
        animate drop-shadow-blur { duration: 150ms; }
        animate drop-shadow-offset-y { duration: 150ms; }

        // State layer overlay
        Rectangle {
            width: 100%; height: 100%; border-radius: 20px;
            background: ta.pressed
                ? MaterialPalette.primary.with-alpha(0.12)
                : ta.has-hover
                    ? MaterialPalette.primary.with-alpha(0.08)
                    : transparent;
            animate background { duration: 100ms; }
        }

        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout {
                padding-left: icon.width > 0 ? 12px : 24px;
                padding-right: icon.width > 0 ? 16px : 24px;
                spacing: 8px;
                if icon.width > 0: Image {
                    source: icon;
                    width: 18px; height: 18px;
                    colorize: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    y: (parent.height - 18px) / 2;
                }
                Text {
                    text: root.text;
                    font-size: Typography.label-large-size;
                    font-weight: Typography.label-large-weight;
                    color: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 150ms; }
                }
            }
        }
    }
}

