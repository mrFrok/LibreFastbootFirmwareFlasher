import { Palette } from "std-widgets.slint";
import { MaterialPalette } from "../globals/material-palette.slint";
import { Tr } from "../globals/tr.slint";
import { DeviceInfo } from "../structs.slint";

export component FilledButton {
    in property <string> text;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: root.enabled ? MaterialPalette.primary : MaterialPalette.surface-container;
        animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        Rectangle {
            width: 100%; height: 100%; border-radius: 20px;
            background: ta.has-hover ? MaterialPalette.on-primary.with-alpha(0.12) : transparent;
            animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 16px; padding-right: 16px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: root.enabled ? MaterialPalette.on-primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
                }
            }
        }
    }
}

export component OutlinedButton {
    in property <string> text;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        border-width: 1px;
        border-color: root.enabled ? MaterialPalette.outline : MaterialPalette.outline-variant;
        background: ta.has-hover ? MaterialPalette.primary.with-alpha(0.12) : transparent;
        animate background { duration: 250ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        animate border-color { duration: 250ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 16px; padding-right: 16px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
                }
            }
        }
    }
}

export component TextButton {
    in property <string> text;
    in property <bool> enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: ta.has-hover ? MaterialPalette.primary.with-alpha(0.12) : transparent;
        animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: root.enabled ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
                }
            }
        }
    }
}

export component FilledTonalButton {
    in property <string> text;
    in property <bool> enabled <=> ta.enabled;
    callback clicked;
    height: 36px;
    Rectangle {
        border-radius: 20px; clip: true;
        background: MaterialPalette.secondary-container;
        animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        Rectangle {
            width: 100%; height: 100%; border-radius: 20px;
            background: ta.has-hover ? MaterialPalette.primary.with-alpha(0.12) : transparent;
            animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        }
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
            HorizontalLayout { padding-left: 16px; padding-right: 16px;
                Text {
                    text: root.text; font-size: 14px; font-weight: 600;
                    color: MaterialPalette.on-secondary-container;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide; horizontal-stretch: 1;
                    animate color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
                }
            }
        }
    }
}

export component HorizontalDivider {
    height: 1px;
    Rectangle {
        width: 100%; height: 1px;
        background: MaterialPalette.outline-variant;
    }
}

export component LinearProgressIndicator {
    in property <float> progress;
    height: 4px;
    Rectangle {
        border-radius: 2px;
        background: MaterialPalette.surface-container-high;
        width: 100%; height: 100%;
        Rectangle {
            border-radius: 2px;
            width: parent.width * root.progress;
            height: 100%;
            background: MaterialPalette.primary;
            animate width { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        }
    }
}

export component SectionTitle {
    in property <string> text;
    height: 36px;
    Text {
        text: root.text;
        font-size: 24px; font-weight: 500;
        color: MaterialPalette.on-surface;
        vertical-alignment: center;
    }
}

export component PathField inherits Rectangle {
    in property <string> path;
    height: 40px; border-radius: 12px;
    min-width: 0px; clip: true;
    background: MaterialPalette.surface-container;
    border-width: 1px;
    border-color: MaterialPalette.outline-variant;
    HorizontalLayout { padding-left: 14px; padding-right: 14px;
        Text {
            text: root.path != "" ? root.path : "…";
            font-size: 13px; font-family: "monospace";
            color: root.path != "" ? MaterialPalette.on-surface : MaterialPalette.on-surface-variant;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
    }
}

export component BackButton {
    callback clicked;
    width: 40px; height: 40px;
    TouchArea {
        clicked => { root.clicked(); }
        Rectangle {
            border-radius: 20px; border-width: 1px;
            border-color: MaterialPalette.outline;
            background: parent.has-hover ? MaterialPalette.surface-container-highest : transparent;
            animate background { duration: 80ms; }
            Image {
                source: @image-url("../icons/arrow_back.svg");
                width: 20px; height: 20px;
                x: (parent.width - 20px) / 2;
                y: (parent.height - 20px) / 2;
                colorize: MaterialPalette.on-surface-variant;
            }
        }
    }
}

export component DeviceBanner inherits Rectangle {
    in property <DeviceInfo> device;
    callback set-slot(string);
    height: 40px; border-radius: 12px;
    background: device.connected
        ? MaterialPalette.primary-container
        : MaterialPalette.error-container;
    animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
    border-width: 1px;
    border-color: device.connected
        ? MaterialPalette.primary
        : MaterialPalette.error;
    animate border-color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 10px;
        Rectangle {
            width: 8px; height: 8px; border-radius: 4px;
            background: device.connected ? MaterialPalette.primary : MaterialPalette.error;
            animate background { duration: 250ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
            y: (parent.height - 8px) / 2;
        }
        if device.connected: HorizontalLayout { spacing: 10px;
            Text { text: device.name;   font-size: 15px; font-weight: 600; color: MaterialPalette.on-primary-container; vertical-alignment: center; }
            Text { text: device.serial; font-size: 13px; font-family: "monospace"; color: MaterialPalette.on-primary-container; vertical-alignment: center; }
            Text { text: Tr.slot-lbl + device.slot; font-size: 13px; color: MaterialPalette.on-primary-container; vertical-alignment: center; }
        }
        if !device.connected: Text {
            text: Tr.no-device;
            font-size: 15px; color: MaterialPalette.on-error-container; vertical-alignment: center;
        }
    }
}
