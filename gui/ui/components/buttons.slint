// ═══════════════════════════════════════════════════════════════════════════
// MD3E Surface & Layout Components
// ═══════════════════════════════════════════════════════════════════════════

// ── Horizontal Divider ─────────────────────────────────────────────────────
export component HorizontalDivider {
    height: 1px;
    Rectangle {
        width: 100%; height: 1px;
        background: MaterialPalette.outline-variant;
    }
}

// ── Linear Progress Indicator ──────────────────────────────────────────────
export component LinearProgressIndicator {
    in property <float> progress;
    height: 8px;
    Rectangle {
        border-radius: 4px;
        background: MaterialPalette.surface-container-highest;
        width: 100%; height: 100%;
        Rectangle {
            border-radius: 4px;
            width: parent.width * root.progress;
            height: 100%;
            background: MaterialPalette.primary;
            animate width { duration: 300ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
        }
    }
}

// ── Section Title ──────────────────────────────────────────────────────────
export component SectionTitle {
    in property <string> text;
    height: 40px;
    Text {
        text: root.text;
        font-size: Typography.headline-large-size;
        font-weight: Typography.headline-large-weight;
        color: MaterialPalette.on-surface;
        vertical-alignment: center;
    }
}

// ── Path Field ─────────────────────────────────────────────────────────────
export component PathField inherits Rectangle {
    in property <string> path;
    in property <bool> has-focus: false;
    height: 44px; border-radius: 16px;
    min-width: 0px; clip: true;
    background: MaterialPalette.surface-container;
    border-width: has-focus ? 2px : 1px;
    border-color: has-focus ? MaterialPalette.primary : MaterialPalette.outline-variant;
    animate border-color { duration: 150ms; }
    animate border-width { duration: 100ms; }
    HorizontalLayout { padding-left: 14px; padding-right: 14px;
        Text {
            text: root.path != "" ? root.path : "…";
            font-size: Typography.body-medium-size;
            font-family: "monospace";
            color: root.path != "" ? MaterialPalette.on-surface : MaterialPalette.on-surface-variant;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
    }
}

// ── Back Button ────────────────────────────────────────────────────────────
export component BackButton {
    callback clicked;
    width: 40px; height: 40px;
    TouchArea {
        clicked => { root.clicked(); }
        Rectangle {
            border-radius: 20px; border-width: 1px;
            border-color: MaterialPalette.outline;
            background: parent.has-hover ? MaterialPalette.surface-container-highest : transparent;
            animate background { duration: 100ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
            Image {
                source: @image-url("../icons/arrow_back.svg");
                width: 20px; height: 20px;
                x: (parent.width - 20px) / 2;
                y: (parent.height - 20px) / 2;
                colorize: MaterialPalette.on-surface-variant;
            }
        }
    }
}

// ── Device Banner ──────────────────────────────────────────────────────────
export component DeviceBanner inherits Rectangle {
    in property <DeviceInfo> device;
    callback set-slot(string);
    height: 48px; border-radius: 16px;
    background: device.connected
        ? MaterialPalette.primary-container
        : MaterialPalette.error-container;
    animate background { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
    border-width: 1px;
    border-color: device.connected
        ? MaterialPalette.primary
        : MaterialPalette.error;
    animate border-color { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 10px;
        // Device icon container
        Rectangle {
            width: 28px; height: 28px; border-radius: 14px;
            background: device.connected
                ? MaterialPalette.primary
                : MaterialPalette.error;
            y: (parent.height - 28px) / 2;
            Image {
                source: @image-url("../icons/smartphone.svg");
                width: 16px; height: 16px;
                x: (parent.width - 16px) / 2;
                y: (parent.height - 16px) / 2;
                colorize: device.connected
                    ? MaterialPalette.on-primary
                    : MaterialPalette.on-error;
            }
        }
        if device.connected: HorizontalLayout { spacing: 10px;
            Text {
                text: device.name;
                font-size: Typography.body-medium-size;
                font-weight: Typography.body-medium-weight-em;
                color: MaterialPalette.on-primary-container;
                vertical-alignment: center;
            }
            Text {
                text: device.serial;
                font-size: Typography.body-small-size;
                font-family: "monospace";
                color: MaterialPalette.on-primary-container;
                vertical-alignment: center;
            }
            Text {
                text: Tr.slot-lbl + device.slot;
                font-size: Typography.body-small-size;
                color: MaterialPalette.on-primary-container;
                vertical-alignment: center;
            }
        }
        if !device.connected: Text {
            text: Tr.no-device;
            font-size: Typography.body-medium-size;
            font-weight: Typography.body-medium-weight-em;
            color: MaterialPalette.on-error-container;
            vertical-alignment: center;
        }
    }
}
