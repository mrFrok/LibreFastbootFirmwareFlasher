import { MaterialPalette, IconButton } from "@material";

// A segmented control in the library's visual language at desktop density.
//
// @material's SegmentedButton is fixed at a 40px minimum height with 24px of
// padding per segment — a touch target. In a 48px utility bar that reads as
// the loudest thing on screen, so this keeps the shape, the colours and the
// hairline dividers, and drops the size to 28px.
component CompactSegmented inherits Rectangle {
    in property <[string]> labels;
    // When set, segments show a colour dot instead of a label. Used for the
    // scheme picker, where a swatch says more than a word and needs no
    // translation.
    in property <[color]> swatches;
    in property <int> current-index;
    in property <length> segment-width: 30px;
    callback selected(int);

    height: 28px;
    width: root.segment-width * root.labels.length;
    border-width: 1px;
    border-radius: self.height / 2;
    border-color: MaterialPalette.outline-variant;
    clip: true;

    HorizontalLayout {
        for label[i] in root.labels: Rectangle {
            background: i == root.current-index
                ? MaterialPalette.secondary-container
                : (touch.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : transparent);
            animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

            if i > 0: Rectangle {
                x: 0; width: 1px; height: 100%;
                background: MaterialPalette.outline-variant;
            }

            if root.swatches.length == 0: Text {
                text: label;
                font-size: 11px; font-weight: 600;
                color: i == root.current-index
                    ? MaterialPalette.on-secondary-container
                    : MaterialPalette.on-surface-variant;
                horizontal-alignment: center; vertical-alignment: center;
            }

            if root.swatches.length > 0: Rectangle {
                width: 12px; height: 12px;
                border-radius: self.width / 2;
                background: root.swatches[i];
                border-width: 1px;
                border-color: MaterialPalette.outline-variant;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

export component TopBar inherits Rectangle {
    in property <string> lang: "en";
    in property <bool> is-dark: true;
    in property <float> ui-scale: 1.0;
    in property <int> scheme: 0;
    in property <bool> translucent: false;

    callback set-scale(float);
    callback set-lang(string);
    callback toggle-theme();
    callback set-scheme(int);
    callback set-translucent(bool);

    // The scale steps, kept in one place so the index the control reports and
    // the factor the callback needs cannot drift apart.
    private property <[float]> scales: [0.85, 1.0, 1.25, 1.5];
    // Each scheme's own dark-mode primary, so the swatch names the colour.
    private property <[color]> swatches: [#66B2FF, #ADC6FF, #00C7BF, #7EC16D, #E39C40, #F68792, #BA98F6];
    private property <[string]> scheme-names: ["Blue", "Indigo", "Teal", "Green", "Amber", "Rose", "Violet"];

    height: 48px;
    background: MaterialPalette.surface-container;

    Rectangle {
        y: parent.height - 1px; height: 1px; width: 100%;
        background: MaterialPalette.outline-variant;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 24px;
        alignment: end; spacing: 8px;
        // Children keep their preferred height and sit centred in the 48px bar;
        // a manual `y` would be overridden by the layout.
        cross-axis-alignment: center;

        CompactSegmented {
            labels: ["S", "M", "L", "XL"];
            current-index: root.ui-scale == root.scales[0] ? 0
                         : root.ui-scale == root.scales[1] ? 1
                         : root.ui-scale == root.scales[2] ? 2
                         : 3;
            selected(i) => { root.set-scale(root.scales[i]); }
        }

        // A dropdown rather than a row of dots: seven colours plus the
        // translucency toggle do not fit a 48px bar side by side. @material's
        // own DropDownMenu wraps a text field with a 56px minimum height, which
        // is taller than the bar, so this is a PopupWindow.
        Rectangle {
            height: 28px; width: 40px;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: MaterialPalette.outline-variant;
            background: scheme-touch.has-hover
                ? MaterialPalette.on-surface.with-alpha(0.08) : transparent;
            animate background { duration: 120ms; }

            Rectangle {
                width: 14px; height: 14px;
                border-radius: self.width / 2;
                background: root.swatches[root.scheme];
                border-width: root.translucent ? 2px : 1px;
                border-color: MaterialPalette.outline-variant;
                opacity: root.translucent ? 0.55 : 1.0;
            }

            scheme-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { scheme-menu.show(); }
            }

            scheme-menu := PopupWindow {
                x: -132px;
                y: parent.height + 6px;
                width: 172px;
                height: 8px + 30px * 7 + 9px + 30px;
                close-policy: close-on-click-outside;

                Rectangle {
                    background: MaterialPalette.surface-container-high;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: MaterialPalette.outline-variant;

                    VerticalLayout {
                        padding: 4px;
                        for name[i] in root.scheme-names: Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: i == root.scheme
                                ? MaterialPalette.secondary-container
                                : (row.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : transparent);

                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 14px; height: 14px;
                                    border-radius: self.width / 2;
                                    background: root.swatches[i];
                                    border-width: 1px;
                                    border-color: MaterialPalette.outline-variant;
                                }
                                Text {
                                    text: name;
                                    font-size: 12px;
                                    color: i == root.scheme
                                        ? MaterialPalette.on-secondary-container
                                        : MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            row := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-scheme(i); }
                            }
                        }

                        Rectangle { height: 1px; background: MaterialPalette.outline-variant; }

                        Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: root.translucent
                                ? MaterialPalette.secondary-container
                                : (glass-row.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : transparent);

                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                cross-axis-alignment: center;
                                Text {
                                    text: root.lang == "ru" ? "Прозрачность" : "Translucent";
                                    font-size: 12px;
                                    color: root.translucent
                                        ? MaterialPalette.on-secondary-container
                                        : MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.translucent: Image {
                                    source: @image-url("../icons/check.svg");
                                    width: 14px; height: 14px;
                                    colorize: MaterialPalette.on-secondary-container;
                                }
                            }

                            glass-row := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-translucent(!root.translucent); }
                            }
                        }
                    }
                }
            }
        }

        CompactSegmented {
            labels: ["EN", "RU"];
            segment-width: 34px;
            current-index: root.lang == "en" ? 0 : 1;
            selected(i) => { root.set-lang(i == 0 ? "en" : "ru"); }
        }

        // `inline` drops IconButton from a 40px touch target to an 18px icon,
        // which is the only way the library's own button fits this bar. No
        // tooltip: centred on a button this close to the edge it gets clipped.
        IconButton {
            inline: true;
            icon: root.is-dark
                ? @image-url("../icons/sun.svg")
                : @image-url("../icons/moon.svg");
            clicked => { root.toggle-theme(); }
        }
    }
}
