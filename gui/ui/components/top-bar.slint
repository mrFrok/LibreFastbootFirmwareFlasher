import { MaterialPalette, SegmentedButton, IconButton } from "@material";

export component TopBar inherits Rectangle {
    in property <string> lang: "en";
    in property <bool> is-dark: true;
    in property <float> ui-scale: 1.0;

    callback set-scale(float);
    callback set-lang(string);
    callback toggle-theme();

    // The scale steps, kept in one place so the index the segmented button
    // reports and the factor the callback needs cannot drift apart.
    private property <[float]> scales: [0.85, 1.0, 1.25, 1.5];

    height: 48px;
    background: MaterialPalette.surface-container;

    Rectangle {
        y: parent.height - 1px; height: 1px; width: 100%;
        background: MaterialPalette.outline-variant;
    }

    HorizontalLayout {
        padding-left: 16px; padding-right: 12px;
        alignment: end; spacing: 8px;
        // Children keep their preferred height and sit centred in the 48px bar;
        // a manual `y` would be overridden by the layout.
        cross-axis-alignment: center;

        // A SegmentedButton in all but name. The library pads each segment by
        // 24px, which makes four of them ~270px — together with the language
        // switch and the theme button that overflows the bar at the 700px
        // minimum window width. Same shape, same colours, 8px padding, 160px.
        Rectangle {
            height: 40px;
            width: 160px;
            border-width: 1px;
            border-radius: self.height / 2;
            border-color: MaterialPalette.outline;
            clip: true;

            HorizontalLayout {
                for item[i] in [{ label: "S" }, { label: "M" }, { label: "L" }, { label: "XL" }]:
                Rectangle {
                    background: root.ui-scale == root.scales[i]
                        ? MaterialPalette.secondary-container
                        : (touch.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : transparent);
                    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

                    if i > 0: Rectangle {
                        x: 0; width: 1px; height: 100%;
                        background: MaterialPalette.outline;
                    }

                    Text {
                        text: item.label;
                        font-size: 12px; font-weight: 600;
                        color: root.ui-scale == root.scales[i]
                            ? MaterialPalette.on-secondary-container
                            : MaterialPalette.on-surface-variant;
                        horizontal-alignment: center; vertical-alignment: center;
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.set-scale(root.scales[i]); }
                    }
                }
            }
        }

        SegmentedButton {
            items: [{ text: "EN" }, { text: "RU" }];
            current-index: root.lang == "en" ? 0 : 1;
            index-changed(index) => { root.set-lang(index == 0 ? "en" : "ru"); }
        }

        IconButton {
            icon: root.is-dark
                ? @image-url("../icons/sun.svg")
                : @image-url("../icons/moon.svg");
            tooltip: root.lang == "ru" ? "Сменить тему" : "Toggle theme";
            clicked => { root.toggle-theme(); }
        }
    }
}
